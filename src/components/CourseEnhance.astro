        set('iso', ISO[iso]); set('shut', SH[sh][0]); set('nd', ND[nd][0]);
        var ev = 4 + Math.log2(ISO[iso] / 100) + SH[sh][1] + ND[nd][1];
        if (ev > 1.2) { ov.style.background = 'rgba(255,255,255,' + Math.min(.55, (ev - 1.2) * 0.16) + ')'; vd.textContent = 'te licht'; vd.className = 'lb-sim__verdict warm'; }
