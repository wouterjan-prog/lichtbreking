---
import { srcset, src } from '../data/work.js';
// Achtergrondbeeld van de hero. Zet een eigen video op /public/video/hero.mp4
// (+ poster) voor een bewegende hero; anders toont het posterbeeld.
const heroId = '1500964757637-c85e8a162699';
---
<section class="hero">
  <div class="hero-media" aria-hidden="true">
    <video class="hero-video" autoplay muted loop playsinline preload="none"
      poster={src(heroId, 2000)}>
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <img class="hero-fallback" src={src(heroId, 2000)} srcset={srcset(heroId)}
      sizes="100vw" alt="" fetchpriority="high" />
    <div class="hero-veil"></div>
  </div>

  <div class="wrap hero-inner">
    <p class="eyebrow reveal">Drone &middot; foto &middot; film</p>
    <h1 class="hero-title reveal">
      Waar licht<br><span class="refract">breekt</span>
    </h1>
    <p class="hero-sub reveal">
      Cinematische beelden uit de lucht en op ooghoogte.
    </p>
  </div>

  <a href="#werk" class="scroll-cue reveal" aria-label="Scroll naar het werk">
    <span>Scroll</span><i></i>
  </a>
</section>

<style>
  .hero {
    position: relative; height: 100svh; min-height: 600px;
    display: flex; align-items: flex-end; overflow: hidden; background: #000;
  }
  .hero-media { position: absolute; inset: 0; z-index: 0; }
  .hero-video, .hero-fallback {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.04);
  }
  /* video ligt bovenop het fallback-beeld; speelt video niet, dan zie je het beeld */
  .hero-video { z-index: 1; }
  .hero-fallback { z-index: 0; }
  .hero-veil {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, transparent 22%, transparent 55%, rgba(5,6,8,.85) 90%, var(--bg) 100%);
  }
  :root[data-theme="light"] .hero-veil {
    background: linear-gradient(180deg, rgba(0,0,0,.3) 0%, transparent 25%, transparent 55%, rgba(244,245,247,.5) 88%, var(--bg) 100%);
  }

  .hero-inner { position: relative; z-index: 3; width: 100%; padding-bottom: clamp(4rem, 12vh, 9rem); }
  .hero .eyebrow { color: rgba(255,255,255,.7); margin-bottom: 1.4rem; }
  .hero-title {
    font-weight: 600; letter-spacing: -.035em; line-height: .92;
    font-size: clamp(3.4rem, 13vw, 10rem); color: #fff;
    text-shadow: 0 4px 40px rgba(0,0,0,.4);
  }
  .hero-sub {
    margin-top: 1.6rem; font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    color: rgba(255,255,255,.82); font-weight: 400; max-width: 40ch;
    text-shadow: 0 2px 20px rgba(0,0,0,.5);
  }
  .hero .eyebrow.reveal { transition-delay: .1s; }
  .hero-title.reveal { transition-delay: .22s; }
  .hero-sub.reveal { transition-delay: .38s; }
  .scroll-cue.reveal { transition-delay: .6s; }

  .scroll-cue {
    position: absolute; bottom: 1.8rem; left: 50%; transform: translateX(-50%); z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: .6rem;
    color: rgba(255,255,255,.6); text-decoration: none;
    font-family: var(--mono); font-size: .68rem; letter-spacing: .24em; text-transform: uppercase;
  }
  .scroll-cue i {
    width: 1px; height: 38px; background: linear-gradient(rgba(255,255,255,.7), transparent);
    animation: cue 2.2s var(--ease) infinite; transform-origin: top;
  }
  @keyframes cue { 0% { transform: scaleY(0); opacity: 0; } 40% { opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue i { animation: none; } .hero-video, .hero-fallback { transform: none; } }
  @media (max-width: 600px) { .hero-sub { font-size: 1.05rem; } }
</style>
