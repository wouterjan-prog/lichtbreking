---
import fs from 'node:fs';
import path from 'node:path';
import Nav from './Nav.astro';
import { hero as heroInstelling } from '../data/site.js';

const { badge, titel, meta = null } = Astro.props;

/* De hero-video staat in drie uitvoeringen in public/video/. Welke een bezoeker
   krijgt bepaalt het script hieronder, op basis van het aantal beeldpunten dat
   zijn scherm echt heeft. Op een scherm met dubbele pixeldichtheid wordt 1080p
   bijna twee keer opgeblazen en dat is goed zichtbaar in water, vandaar 2160p
   voor grote schermen. */
const pub = (p) => path.join(process.cwd(), 'public', p);
const bestaat = (naam) => (fs.existsSync(pub(`video/${naam}`)) ? `/video/${naam}` : null);
const bronnen = {
  hevcGroot: bestaat('hero-2160.hevc.mp4'),
  hevcKlein: bestaat('hero-1440.hevc.mp4'),
  h264Groot: bestaat('hero-2160.mp4'),
  h264Klein: bestaat('hero-1440.mp4'),
};
const heeftPoster = fs.existsSync(pub('video/poster.webp'));
const heeftVideo = Object.values(bronnen).some(Boolean);
const toonGeluid = heeftVideo && heroInstelling.videoHeeftGeluid === true;
---
<header class="lb-hero">
  {heeftVideo ? (
    <video
      id="lb-hero-video"
      class="lb-hero__media"
      muted
      loop
      playsinline
      preload="auto"
      poster={heeftPoster ? '/video/poster.webp' : undefined}
      aria-label="Sfeerbeeld: helder water met een steiger en een rode boot, van bovenaf"
    ></video>
  ) : heeftPoster ? (
    <img class="lb-hero__media" src="/video/poster.webp" alt="" />
  ) : (
    <div class="lb-hero__leeg"><span>hero-video · /video/hero-2160.hevc.mp4</span></div>
  )}

  <div class="lb-hero__waas"></div>

  <Nav variant="over-hero" />

  <div class="lb-hero__onder">
    <div>
      <span class="lb-badge">{badge}</span>
      <h1 class="lb-hero__titel">{titel}</h1>
      {meta && (
        <div class="lb-hero__regel">
          <span class="lb-rule lb-rule--kort"></span>
          <span class="lb-meta">{meta}</span>
        </div>
      )}
    </div>

    {toonGeluid && (
      <button type="button" class="lb-geluid" id="lb-geluid" aria-pressed="false">
        <span class="lb-geluid__icoon" data-icoon>&#128263;</span>
        <span class="lb-geluid__tekst" data-tekst>Geluid aan</span>
      </button>
    )}
  </div>

  <div class="lb-cue" aria-hidden="true">&#8595;</div>
</header>

{heeftVideo && (
  <script is:inline define:vars={{ bronnen }}>
    (() => {
      const video = document.getElementById('lb-hero-video');
      if (!video) return;

      /* Geen video ophalen voor wie geen beweging wil of op databesparing zit.
         Die houden het posterbeeld, een fractie van het gewicht. */
      const rustig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const zuinig = navigator.connection && navigator.connection.saveData;
      if (rustig || zuinig) return;

      /* Twee vragen bepalen welk bestand je krijgt: kan de browser HEVC, en
         hoeveel beeldpunten heeft het scherm echt. Op een scherm met dubbele
         pixeldichtheid wordt 1440p nog opgeblazen, en dat zie je meteen in
         water. Vandaar 2160p zodra het scherm groot genoeg is. */
      const kanHevc = video.canPlayType('video/mp4; codecs="hvc1"') !== '';
      const groot = window.innerWidth * (window.devicePixelRatio || 1) >= 2000;

      const volgorde = kanHevc
        ? (groot
            ? ['hevcGroot', 'hevcKlein', 'h264Groot', 'h264Klein']
            : ['hevcKlein', 'hevcGroot', 'h264Klein', 'h264Groot'])
        : (groot
            ? ['h264Groot', 'h264Klein']
            : ['h264Klein', 'h264Groot']);

      const kandidaten = volgorde.map((k) => bronnen[k]).filter(Boolean);
      if (!kandidaten.length) return;

      /* Lukt het decoderen niet, dan schuift hij door naar de volgende.
         Raakt de lijst op, dan blijft het posterbeeld gewoon staan. */
      let i = 0;
      video.addEventListener('error', () => {
        i += 1;
        if (i >= kandidaten.length) return;
        start(kandidaten[i]);
      });

      /* Pas afspelen als de browser zegt dat hij het in één keer uitspeelt.
         Meteen starten geeft haperingen terwijl het bestand nog binnenkomt.
         Blijft dat signaal uit, dan na vier seconden alsnog beginnen. */
      let gestart = false;
      const speel = () => {
        if (gestart) return;
        gestart = true;
        video.play().catch(() => {});
      };

      const start = (bron) => {
        gestart = false;
        video.addEventListener('canplaythrough', speel, { once: true });
        video.src = bron;
        video.load();
        setTimeout(speel, 4000);
      };

      start(kandidaten[0]);

      /* 2160p decoderen is zwaar. Laat een toestel toch frames vallen, dan ziet
         dat er schokkerig uit terwijl er niets mis is met het bestand. Na drie
         seconden kijken we of dat gebeurt en stappen we zo nodig één stap terug
         naar een lichtere versie, op dezelfde plek in de lus. */
      setTimeout(() => {
        if (!video.getVideoPlaybackQuality || i + 1 >= kandidaten.length) return;
        const k = video.getVideoPlaybackQuality();
        if (!k.totalVideoFrames) return;
        if (k.droppedVideoFrames / k.totalVideoFrames < 0.05) return;
        const plek = video.currentTime;
        i += 1;
        start(kandidaten[i]);
        video.addEventListener('loadedmetadata', () => { video.currentTime = plek; }, { once: true });
      }, 3000);
    })();
  </script>
)}
