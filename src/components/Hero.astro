---
import fs from 'node:fs';
import path from 'node:path';
import Nav from './Nav.astro';

const {
  badge = 'Nieuwste serie',
  titel,
  meta = null,
} = Astro.props;

/* De hero draait op /video/hero.mp4 zodra dat bestand er is.
   Zolang het ontbreekt tonen we een rustig verloopvlak in plaats van een gat. */
const pub = (p) => path.join(process.cwd(), 'public', p);
const heeftVideo = fs.existsSync(pub('video/hero.mp4'));
const heeftPoster = fs.existsSync(pub('video/poster.jpg'));
---
<header class="lb-hero">
  {heeftVideo ? (
    <video
      id="lb-hero-video"
      class="lb-hero__media"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      src="/video/hero.mp4"
      poster={heeftPoster ? '/video/poster.jpg' : undefined}
    ></video>
  ) : heeftPoster ? (
    <img class="lb-hero__media" src="/video/poster.jpg" alt="" />
  ) : (
    <div class="lb-hero__leeg"><span>hero-video · /video/hero.mp4</span></div>
  )}

  <div class="lb-hero__waas"></div>

  <Nav variant="over-hero" />

  <div class="lb-hero__onder">
    <div>
      <span class="lb-badge">{badge}</span>
      <h1 class="lb-hero__titel">{titel}</h1>
      {meta && (
        <div class="lb-hero__regel">
          <span class="lb-rule lb-rule--kort"></span>
          <span class="lb-meta">{meta}</span>
        </div>
      )}
    </div>

    {heeftVideo && (
      <button type="button" class="lb-geluid" id="lb-geluid" aria-pressed="false">
        <span class="lb-geluid__icoon" data-icoon>&#128263;</span>
        <span class="lb-geluid__tekst" data-tekst>Geluid aan</span>
      </button>
    )}
  </div>

  <div class="lb-cue" aria-hidden="true">&#8595;</div>
</header>

{heeftVideo && (
  <script is:inline>
    (() => {
      const knop = document.getElementById('lb-geluid');
      const video = document.getElementById('lb-hero-video');
      if (!knop || !video) return;
      knop.addEventListener('click', () => {
        const aan = video.muted;
        video.muted = !aan;
        if (aan) video.play().catch(() => {});
        knop.setAttribute('aria-pressed', String(aan));
        knop.querySelector('[data-icoon]').textContent = aan ? '\u{1F50A}' : '\u{1F507}';
        knop.querySelector('[data-tekst]').textContent = aan ? 'Geluid uit' : 'Geluid aan';
      });
    })();
  </script>
)}
