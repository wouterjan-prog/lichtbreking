---
import { work, srcset, src } from '../data/work.js';
---
<section id="werk" class="reel">
  <div class="reel-intro wrap">
    <p class="eyebrow reveal">Selectie</p>
    <h2 class="reel-h reveal">Het werk</h2>
  </div>

  {work.map((w, i) => (
    <article class={`scene ${w.type === 'video' ? 'is-video' : ''}`} data-scene>
      <div class="scene-media">
        {w.type === 'video' && w.video ? (
          <video class="scene-img" autoplay muted loop playsinline preload="none" poster={src(w.photo, 1600)}>
            <source src={w.video} type="video/mp4" />
          </video>
        ) : (
          <img class="scene-img" src={src(w.photo, 1600)} srcset={srcset(w.photo)}
            sizes="100vw" alt={w.alt} loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'} width="1600" height="1000" />
        )}
        <div class="scene-veil"></div>
      </div>

      <div class="scene-text wrap">
        <span class="scene-index">{String(i + 1).padStart(2, '0')} / {String(work.length).padStart(2, '0')}</span>
        <h3 class="scene-title">{w.title}</h3>
        <p class="scene-meta">
          <span>{w.place}</span>
          <i></i>
          <span>{w.year}</span>
          {w.type === 'video' && <span class="scene-tag">Film</span>}
        </p>
        {w.type === 'video' && (w.embed || w.video) && (
          <button class="scene-play" data-embed={w.embed} aria-label={`Speel ${w.title}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <span>Bekijk de film</span>
          </button>
        )}
      </div>
    </article>
  ))}

  <!-- Lightbox voor video-embeds -->
  <div class="lb" id="lightbox" hidden>
    <button class="lb-close" id="lbClose" aria-label="Sluiten">&times;</button>
    <div class="lb-stage" id="lbStage"></div>
  </div>
</section>

<style>
  .reel { position: relative; }
  .reel-intro { padding-block: clamp(4rem, 10vw, 7rem) clamp(2rem, 5vw, 3rem); }
  .reel-h { font-size: clamp(2rem, 6vw, 3.6rem); font-weight: 600; letter-spacing: -.03em; margin-top: .5rem; }

  /* elke scène vult (bijna) het scherm */
  .scene {
    position: relative;
    height: 92svh;
    min-height: 540px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .scene-media { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .scene-img {
    width: 100%; height: 116%; object-fit: cover;
    will-change: transform;
    /* parallax wordt via JS gezet; deze startwaarde voorkomt sprong */
    transform: translateY(-8%);
  }
  .scene-veil {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.35) 0%, transparent 30%, transparent 50%, rgba(0,0,0,.7) 100%);
  }

  .scene-text {
    position: relative; z-index: 2;
    width: 100%;
    padding-bottom: clamp(3rem, 8vh, 6rem);
    color: #fff;
  }
  .scene-index {
    font-family: var(--mono); font-size: .72rem; letter-spacing: .22em;
    color: rgba(255,255,255,.65); text-transform: uppercase;
  }
  .scene-title {
    font-size: clamp(2.6rem, 9vw, 7rem);
    font-weight: 600; letter-spacing: -.035em; line-height: .95;
    margin: .4rem 0 .8rem;
    text-shadow: 0 4px 40px rgba(0,0,0,.45);
  }
  .scene-meta {
    display: flex; align-items: center; gap: .9rem;
    font-size: 1rem; color: rgba(255,255,255,.85);
  }
  .scene-meta i { width: 4px; height: 4px; border-radius: 50%; background: rgba(255,255,255,.5); }
  .scene-tag {
    font-family: var(--mono); font-size: .64rem; letter-spacing: .16em; text-transform: uppercase;
    padding: .25rem .6rem; border-radius: 999px;
    background: rgba(255,255,255,.16); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  }
  .scene-play {
    margin-top: 1.6rem;
    display: inline-flex; align-items: center; gap: .6rem;
    padding: .8rem 1.4rem; border-radius: 999px; border: none;
    background: rgba(255,255,255,.92); color: #0a0a0c; font-weight: 600; font-size: .96rem;
    transition: transform .3s var(--ease);
  }
  .scene-play:hover { transform: translateY(-2px); }

  /* Lightbox */
  .lb {
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-items: center; padding: var(--gutter);
    background: rgba(0,0,0,.82);
    -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px);
  }
  .lb[hidden] { display: none; }
  .lb-stage { width: min(1100px, 94vw); }
  .lb-stage iframe { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: var(--r); box-shadow: var(--glass-shadow); }
  .lb-close {
    position: fixed; top: 1.2rem; right: 1.2rem; z-index: 210;
    width: 46px; height: 46px; border-radius: 50%; border: none;
    background: rgba(255,255,255,.14); color: #fff; font-size: 1.4rem;
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  }

  @media (max-width: 600px) {
    .scene { height: 86svh; }
    .scene-meta { font-size: .9rem; gap: .6rem; }
  }
</style>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Parallax: beeld beweegt trager dan de scroll, binnen elke scène
    if (!reduce) {
      var scenes = Array.prototype.slice.call(document.querySelectorAll('[data-scene]'));
      var ticking = false;
      function update() {
        var vh = window.innerHeight;
        scenes.forEach(function (sc) {
          var img = sc.querySelector('.scene-img');
          if (!img) return;
          var r = sc.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) return; // buiten beeld: skip
          // progress -1 .. 1 terwijl scène door beeld scrollt
          var prog = (r.top + r.height / 2 - vh / 2) / vh;
          var shift = Math.max(-8, Math.min(8, -prog * 8)); // -8% .. +8%
          img.style.transform = 'translateY(' + (shift - 8) + '%)';
        });
        ticking = false;
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    // Video-lightbox (embeds)
    var lb = document.getElementById('lightbox');
    var stage = document.getElementById('lbStage');
    var closeBtn = document.getElementById('lbClose');
    document.querySelectorAll('.scene-play').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var embed = btn.dataset.embed;
        if (!embed) return;
        stage.innerHTML = '';
        var f = document.createElement('iframe');
        f.src = embed; f.allow = 'autoplay; fullscreen; picture-in-picture'; f.allowFullscreen = true;
        stage.appendChild(f);
        lb.hidden = false; document.body.style.overflow = 'hidden';
      });
    });
    function close() { lb.hidden = true; stage.innerHTML = ''; document.body.style.overflow = ''; }
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (lb) lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && lb && !lb.hidden) close(); });
  })();
</script>
