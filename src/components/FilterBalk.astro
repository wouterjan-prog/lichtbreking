---
import { elementen } from '../data/site.js';

/* modus 'link'  → chips linken door naar /werk/?f=…
   modus 'filter' → chips filteren het raster op dezelfde pagina  */
const { modus = 'link', telling = null, strak = false, id = null } = Astro.props;
const basis = '/werk/';
---
<div id={id} class:list={['lb-filters', 'lb-marge', strak && 'lb-filters--strak']} data-filterbalk={modus === 'filter' ? '' : undefined}>
  {modus === 'filter' ? (
    <>
      <button type="button" class="lb-chip is-actief" data-filter="alles" aria-pressed="true">Alles</button>
      {elementen.map((el) => (
        <button type="button" class="lb-chip" data-filter={el.id} aria-pressed="false">
          <span class="lb-chip__dot" style={`background:${el.kleur}`}></span>{el.naam}
        </button>
      ))}
    </>
  ) : (
    <>
      <a class="lb-chip is-actief" href={basis}>Alles</a>
      {elementen.map((el) => (
        <a class="lb-chip" href={`${basis}?f=${el.id}`}>
          <span class="lb-chip__dot" style={`background:${el.kleur}`}></span>{el.naam}
        </a>
      ))}
    </>
  )}
  {telling !== null && <span class="lb-label lb-filters__telling" data-telling>{telling}</span>}
</div>
