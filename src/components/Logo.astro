---
/* Logo.astro — iris-beeldmerk (spectrum-zeshoek) + woordmerk.
   Buitenrand = spectrumverloop; binnen-zeshoek + vage driehoek volgen `currentColor`
   zodat het logo ook op een lichte achtergrond leesbaar blijft. */
export interface Props { size?: number; text?: boolean; class?: string; }
const { size = 28, text = true, class: className = "" } = Astro.props;
const uid = "lb-" + Math.random().toString(36).slice(2, 8);
---
<span class:list={["lb-logo", className]} style={`--s:${size}px`}>
  <svg viewBox="0 0 100 100" role="img" aria-label="lichtbreking">
    <defs>
      <linearGradient id={uid} x1="20" y1="14" x2="80" y2="86" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FF5147" />
        <stop offset="0.22" stop-color="#FF9A2E" />
        <stop offset="0.42" stop-color="#FFD23E" />
        <stop offset="0.6" stop-color="#46C95F" />
        <stop offset="0.8" stop-color="#2F7CF0" />
        <stop offset="1" stop-color="#9B4DDB" />
      </linearGradient>
    </defs>
    <polygon points="50,15.5 79.9,67.3 20.1,67.3" fill="none" stroke="currentColor" stroke-opacity=".18" stroke-width="1" stroke-linejoin="round" />
    <polygon points="50,12 82.9,31 82.9,69 50,88 17.1,69 17.1,31" fill="none" stroke={`url(#${uid})`} stroke-width="6" stroke-linejoin="round" />
    <polygon points="60,32.7 70,50 60,67.3 40,67.3 30,50 40,32.7" fill="none" stroke="currentColor" stroke-opacity=".92" stroke-width="2.4" stroke-linejoin="round" />
  </svg>
  {text && <span class="lb-word">lichtbreking</span>}
</span>
<style>
  .lb-logo { display: inline-flex; align-items: center; gap: .5em; color: currentColor; }
  .lb-logo svg { height: var(--s); width: auto; display: block; }
  .lb-word {
    font-family: var(--lb-font-display, -apple-system, system-ui, sans-serif);
    font-weight: 500; font-size: calc(var(--s) * 0.8);
    letter-spacing: -.03em; line-height: 1; color: currentColor;
  }
</style>
