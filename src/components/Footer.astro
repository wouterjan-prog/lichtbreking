---
import Logo from "./Logo.astro";
import SpectrumRule from "./SpectrumRule.astro";
import { t, locUrl } from "../i18n/ui.js";
const { lang = "nl" } = Astro.props;
const F = (t[lang] || t.nl).foot;
const year = new Date().getFullYear();
const cols = [
  { h: F.site, links: [[F.start, locUrl("/start/", lang)], [F.werk, locUrl("/werk/", lang)], [F.cursussen, locUrl("/cursussen/", lang)], [F.spots, locUrl("/dronespots/", lang)], [F.search, locUrl("/zoeken/", lang)]] },
  { h: F.more, links: [[F.over, locUrl("/over/", lang)], [F.contact, locUrl("/contact/", lang)], [F.begrippen, locUrl("/begrippen/", lang)], [F.curacaoGuide, locUrl("/curacao/", lang)], [F.heerdeGuide, locUrl("/heerde/", lang)], [F.pocketGuide, locUrl("/gids/pocket-4/", lang)], [F.actionGuide, locUrl("/gids/action-6/", lang)], [F.miniGuide, locUrl("/gids/mini-5/", lang)], [F.articles, locUrl("/artikelen/", lang)], [F.faq, locUrl("/faq/", lang)], [F.news, locUrl("/wat-is-nieuw/", lang)], [F.privacy, locUrl("/privacy/", lang)]] },
];
---
<footer class="lb-foot">
  <div class="lb-container">
    <SpectrumRule />
    <div class="lb-foot__top">
      <div class="lb-foot__brand">
        <a href={locUrl("/", lang)} aria-label="Lichtbreking — home"><Logo size={30} /></a>
        <p class="lb-muted">{F.tagline}</p>
        <a href="mailto:hallo@lichtbreking.nl" class="lb-foot__mail">hallo@lichtbreking.nl</a>
        <a href="https://www.instagram.com/lichtbreking/" class="lb-foot__ig" target="_blank" rel="noopener" aria-label="Volg Lichtbreking op Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
          <span>@lichtbreking</span>
        </a>
      </div>
      <nav class="lb-foot__cols" aria-label="Footer">
        {cols.map((c) => (
          <div class="lb-foot__col">
            <span class="lb-label">{c.h}</span>
            <ul>{c.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="lb-foot__bottom">
      <span class="lb-label">© {year} Lichtbreking</span>
      <span class="lb-label">{F.rights}</span>
    </div>
  </div>
</footer>
<style>
  .lb-foot { background: var(--lb-ink); border-top: 1px solid var(--lb-line); padding: clamp(48px,6vw,80px) 0 40px; }
  .lb-foot .lb-container > :global(.lb-spectrum-rule) { margin-bottom: 40px; }
  .lb-foot__top { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: start; }
  .lb-foot__brand p { margin: 16px 0 12px; max-width: 36ch; }
  .lb-foot__mail { color: var(--lb-bone); border-bottom: 1.5px solid var(--lb-mist); padding-bottom: 2px; font-size: var(--lb-small); }
  .lb-foot__ig { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; color: var(--lb-mist); font-size: var(--lb-small); transition: color .3s var(--lb-ease); }
  .lb-foot__ig:hover { color: var(--lb-bone); }
  .lb-foot__cols { display: flex; gap: 56px; justify-content: flex-end; }
  .lb-foot__col ul { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
  .lb-foot__col a { color: var(--lb-mist); font-size: var(--lb-small); transition: color .3s var(--lb-ease); }
  .lb-foot__col a:hover { color: var(--lb-bone); }
  .lb-foot__bottom { display: flex; justify-content: space-between; gap: 16px; margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--lb-line); }
  @media (max-width: 720px) {
    .lb-foot__top { grid-template-columns: 1fr; gap: 28px; }
    .lb-foot__cols { justify-content: flex-start; gap: 40px; }
    .lb-foot__bottom { flex-direction: column; gap: 8px; }
  }
</style>
