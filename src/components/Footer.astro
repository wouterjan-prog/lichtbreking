---
import Logo from './Logo.astro';
import { site, toestellen } from '../data/site.js';
---
<footer class="lb-footer">
  <div class="lb-rule lb-rule--breed"></div>
  <div class="lb-footer__binnen">
    <a class="lb-footer__merk" href="/">
      <Logo id="lbfoothex" driehoek={false} />
      <span>lichtbreking</span>
    </a>
    <div class="lb-footer__rechts">
      {toestellen.map((t) => <span>{t.kort}</span>)}
      <a href={site.instagram} rel="me noopener" target="_blank">Instagram</a>
      <a href={`mailto:${site.email}`}>Contact</a>
      <a href="/privacy/">Privacy</a>
      <span>&copy; {site.jaar}</span>
    </div>
  </div>
</footer>
