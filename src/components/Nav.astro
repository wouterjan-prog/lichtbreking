---
import Logo from './Logo.astro';
import { menu } from '../data/site.js';
import { aantalFilms } from '../data/films.js';

/* variant: 'over-hero' (transparant over de hero) of 'vast' (donkere balk bovenaan) */
const { variant = 'vast' } = Astro.props;
/* Geen menu-item naar een lege Films-pagina. */
const items = menu.filter((m) => m.href !== '/films/' || aantalFilms > 0);
const pad = Astro.url.pathname.replace(/\/+$/, '') || '/';
const actief = (href) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? pad === '/' : pad === h || pad.startsWith(h + '/');
};
---
<nav class:list={['lb-nav', variant === 'vast' && 'lb-nav--vast']} aria-label="Hoofdmenu">
  <a class="lb-merk" href="/">
    <Logo id="lbnavhex" />
    {variant !== 'over-hero' && <span>lichtbreking</span>}
  </a>
  <div class="lb-pillen">
    {items.map((item) => (
      <a class="lb-pil" href={item.href} aria-current={actief(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </div>
</nav>

{/* Boven de hero staat het menu absoluut en scrollt het gewoon mee omhoog.
    Er hoort dus niets te veranderen tijdens het scrollen: een achtergrond die
    verschijnt op iets wat toch verdwijnt oogt als een storing. */}
