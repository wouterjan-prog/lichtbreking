---
import Logo from './Logo.astro';
const { active = '' } = Astro.props;
const links = [
  { href: '/',         label: 'Werk',   id: 'werk' },
  { href: '/cursus/',  label: 'Cursus', id: 'cursus' },
  { href: '/over/',    label: 'Over',   id: 'over' },
  { href: '/contact/', label: 'Contact', id: 'contact' },
];
---
<header class="nav-shell" data-nav>
  <nav class="nav" aria-label="Hoofdnavigatie">
    <a href="/" class="brand" aria-label="Lichtbreking — home">
      <Logo size={30} />
    </a>
    <ul class="nav-links">
      {links.map((l) => (
        <li><a href={l.href} class={active === l.id ? 'on' : ''}>{l.label}</a></li>
      ))}
    </ul>
    <button class="theme-toggle" id="themeToggle" aria-label="Wissel licht/donker" title="Licht / donker">
      <svg class="ic-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"/></svg>
      <svg class="ic-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z"/></svg>
    </button>
  </nav>
</header>

<style>
  .nav-shell {
    position: fixed;
    top: clamp(.7rem, 2vw, 1.2rem);
    left: 0; right: 0;
    z-index: 100;
    display: flex; justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    display: flex; align-items: center; gap: 1.4rem;
    padding: .5rem .55rem .5rem 1.1rem;
    border-radius: var(--r-pill);
    width: min(720px, 100%);
    background: transparent;
    transition: background .5s var(--ease), box-shadow .5s var(--ease), backdrop-filter .5s var(--ease);
  }
  /* bij scroll wordt de nav glas (Liquid Glass) */
  .nav-shell.scrolled .nav {
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    box-shadow: 0 0 0 1px var(--glass-rim), inset 0 1px 0 0 var(--glass-edge), var(--glass-shadow);
  }
  /* bovenaan de hero: wit woordmerk, leesbaar op donker beeld */
  .nav-shell:not(.scrolled) .brand :global(.lb-logo),
  .nav-shell:not(.scrolled) .nav-links a { color: rgba(255,255,255,.92); }
  .nav-shell:not(.scrolled) .theme-toggle { background: rgba(255,255,255,.14); color: #fff; box-shadow: none; }
  .brand { display: flex; align-items: center; margin-right: auto; }
  /* bij scroll/glas: woordmerk-kleur volgt het thema (donkere inkt op licht, licht op donker) */
  .brand :global(.lb-logo) { color: var(--on-glass); }
  .nav-links { display: flex; gap: .3rem; list-style: none; }
  .nav-links a {
    display: block; padding: .45rem .85rem; border-radius: var(--r-pill);
    font-size: .94rem; color: var(--on-glass-dim); font-weight: 500;
    transition: color .25s, background .25s;
  }
  .nav-links a:hover { color: var(--on-glass); }
  .nav-links a.on { color: var(--on-glass); background: var(--glass-bg-strong); }
  .theme-toggle {
    flex: 0 0 auto;
    display: grid; place-items: center;
    width: 38px; height: 38px; min-width: 38px; min-height: 38px;
    border-radius: 50%; padding: 0;
    background: var(--glass-bg-strong); border: none; color: var(--on-glass);
    box-shadow: 0 0 0 1px var(--glass-rim), inset 0 1px 0 var(--glass-edge);
    transition: transform .3s var(--ease);
  }
  .theme-toggle:hover { transform: rotate(18deg); }
  .ic-moon { display: none; }
  :root[data-theme="dark"] .ic-sun { display: none; }
  :root[data-theme="dark"] .ic-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .ic-sun { display: none; }
    :root:not([data-theme]) .ic-moon { display: block; }
  }
  @media (max-width: 560px) {
    .nav-links { gap: 0; }
    .nav-links a { padding: .4rem .6rem; font-size: .86rem; }
    .brand :global(.lb-word) { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var current = root.getAttribute('data-theme');
      if (!current) {
        current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      var next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('lb-theme', next); } catch (e) {}
    });
  })();
</script>
