---
import { Picture, getImage } from 'astro:assets';
import PlaceholderTile from './PlaceholderTile.astro';
import { toestelNaam } from '../data/site.js';

/* Alle originelen uit src/beelden/werk/ worden hier ingelezen. Astro maakt er
   tijdens de build AVIF en WebP van in meerdere breedtes. Een pad dat met een
   / begint komt uit public/ en gaat ongemoeid door. */
const originelen = import.meta.glob(
  '../beelden/werk/*.{jpg,jpeg,png,webp,avif,tif,tiff,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const { shot, caption = null, lazy = true, lightbox = true, vorm = null } = Astro.props;

const breed = vorm ? vorm === 'lb-tegel--breed' || vorm === 'lb-tegel--band' : shot.verhouding === '16/9';
const staand = shot.verhouding === '9/16';
const toonCaption = caption === null ? breed : caption;
const alt = shot.alt || `${shot.titel}, ${toestelNaam(shot.toestel)}`;

const uitPublic = typeof shot.bestand === 'string' && shot.bestand.startsWith('/');
const origineel = shot.bestand && !uitPublic
  ? originelen[`../beelden/werk/${shot.bestand}`]?.default ?? null
  : null;

const sizes = staand
  ? '250px'
  : breed
    ? '(min-width: 1240px) 1184px, 100vw'
    : '(min-width: 1240px) 584px, 50vw';

const breedtes = staand
  ? [180, 250, 500]
  : breed
    ? [640, 960, 1280, 1600, 2000]
    : [320, 480, 640, 960, 1200];

/* Grote versie voor de lightbox */
const groot = origineel
  ? await getImage({ src: origineel, format: 'webp', width: Math.min(origineel.width, 2200) })
  : null;

const heeftBeeld = Boolean(origineel || uitPublic);

/* Een tegel met een video hoort naar zijn eigen pagina te gaan, want daar staat
   de speler. De lightbox toont alleen stilstaand beeld, en een afspeelknopje dat
   een foto opent is misleidend. Foto's blijven wel de lightbox openen. */
const heeftVideo = Boolean(shot.video);
const naarPagina = heeftVideo && heeftBeeld;
const klikbaar = lightbox && heeftBeeld && !naarPagina;
const Tag = naarPagina ? 'a' : klikbaar ? 'button' : 'div';
const grootPad = groot?.src ?? (uitPublic ? shot.bestand : null);

/* Een tegel snijdt vanuit het midden, tenzij er een uitsnede opgegeven is.
   Die gaat als variabele mee naar de opmaak, want dan hoeft de <Picture> er
   niets van te weten. */
const stijl = [
  vorm ? null : `aspect-ratio:${shot.verhouding}`,
  shot.uitsnede ? `--lb-uitsnede:${shot.uitsnede}` : null,
].filter(Boolean).join(';') || undefined;
---
<Tag
  class:list={[
    'lb-tegel',
    vorm || (breed && 'lb-tegel--breed'),
    klikbaar && 'lb-tegel--klikbaar',
    naarPagina && 'lb-tegel--pagina',
  ]}
  style={stijl}
  data-element={shot.element}
  data-toestel={shot.toestel}
  data-type={shot.type}
  type={klikbaar ? 'button' : undefined}
  href={naarPagina ? `/werk/${shot.slug}/` : undefined}
  data-groot={klikbaar ? grootPad : undefined}
  data-bijschrift={klikbaar ? `${shot.titel} · ${toestelNaam(shot.toestel)}` : undefined}
  aria-label={
    naarPagina
      ? `${shot.titel} afspelen`
      : klikbaar
        ? `${shot.titel} groter bekijken`
        : undefined
  }
>
  {origineel ? (
    <Picture
      src={origineel}
      formats={['avif', 'webp']}
      widths={breedtes}
      sizes={sizes}
      alt={alt}
      loading={lazy ? 'lazy' : 'eager'}
      decoding="async"
    />
  ) : uitPublic ? (
    <img src={shot.bestand} alt={alt} loading={lazy ? 'lazy' : 'eager'} decoding="async" />
  ) : (
    <PlaceholderTile label={`beeld ${shot.verhouding.replace('/', ':')}`} />
  )}

  {shot.type === 'video' && <span class="lb-tegel__speel" aria-hidden="true">&#9654;</span>}
  {toonCaption && <span class="lb-tegel__caption">{shot.titel} · {toestelNaam(shot.toestel).replace('DJI ', '')}</span>}
</Tag>
