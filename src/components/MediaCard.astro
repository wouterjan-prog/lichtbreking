---
/* MediaCard.astro — beeldtegel met onderschrift-overlay. */
import { srcset, src } from "../data/work.js";
const { item, counter = "", href = null, big = false } = Astro.props;
const link = href ?? `/werk/${item.id}/`;
const catLabel = (item.cat || "").toUpperCase();
---
<a href={link} class:list={["lb-media", "lb-card", { big }]} aria-label={item.title}>
  <img
    src={src(item.photo, big ? 1600 : 1024)}
    srcset={srcset(item.photo)}
    sizes={big ? "(max-width:720px) 100vw, 66vw" : "(max-width:720px) 100vw, 33vw"}
    alt={item.alt} loading="lazy" decoding="async" width="1600" height="1066" />
  {item.type === "video" && <span class="lb-card__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>}
  <div class="lb-card__meta">
    <span class="lb-label lb-label--sky">{counter ? counter + " · " : ""}{catLabel}</span>
    <h3 class="lb-card__title">{item.title}</h3>
    <span class="lb-card__sub lb-label">{item.place} · {item.year}</span>
  </div>
</a>
<style>
  .lb-card { display: block; aspect-ratio: 4 / 3; }
  .lb-card.big { aspect-ratio: 16 / 10; }
  .lb-card:hover img { transform: scale(1.03); }
  .lb-card__meta { position: absolute; left: 22px; right: 22px; bottom: 20px; z-index: 2; display: flex; flex-direction: column; gap: 6px; }
  .lb-card__title { color: #fff; font-size: clamp(20px, 2.4vw, 30px); }
  .lb-card__sub { color: rgba(255,255,255,.8); opacity: .9; }
  .lb-card__play {
    position: absolute; inset: 0; margin: auto; z-index: 2; width: 64px; height: 64px;
    display: grid; place-items: center; border-radius: 50%; color: #fff;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.4);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: transform .4s var(--lb-ease);
  }
  .lb-card:hover .lb-card__play { transform: scale(1.08); }
  @media (max-width: 720px) { .lb-card, .lb-card.big { aspect-ratio: 3 / 2; } }
</style>
