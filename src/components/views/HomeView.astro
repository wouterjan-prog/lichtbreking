---
import Base from '../../layouts/Base.astro';
import GlassNav from '../GlassNav.astro';
import Footer from '../Footer.astro';
import SpectrumRule from '../SpectrumRule.astro';
import { work, src, srcset } from '../../data/work.js';
import { t, locUrl } from '../../i18n/ui.js';
const { lang = 'nl' } = Astro.props;
const L = t[lang]; const heroId = '1576682953661-a056a5073019';
const teaser = work.slice(0, 3);
const jsonld = { '@context': 'https://schema.org', '@type': 'WebSite', url: 'https://www.lichtbreking.nl/', name: 'Lichtbreking', inLanguage: lang === 'en' ? 'en' : 'nl-NL' };
---
<Base title={L.home.title} description={L.home.desc} path="/" lang={lang} jsonld={jsonld}>
  <GlassNav active="" lang={lang} hero />
  <main id="hoofdinhoud" tabindex="-1">
    <section class="hero">
      <img class="hero__bg" src={src(heroId, 2000)} srcset={srcset(heroId)} sizes="100vw" alt={L.work['golden-coast'].alt} fetchpriority="high" width="2000" height="1125" />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__inner lb-container">
        <span class="lb-label lb-label--sky lb-reveal">{L.home.kicker}</span>
        <h1 class="lb-display-xl hero__title lb-reveal">{L.home.h1a}<br>{L.home.h1b}</h1>
        <p class="hero__lead lb-reveal">{L.home.lead}</p>
        <div class="hero__cta lb-reveal">
          <a href={locUrl('/werk/', lang)} class="lb-btn">{L.home.ctaWork}</a>
          <a href={locUrl('/showreel/', lang)} class="lb-btn lb-btn--glass">{L.home.ctaReel}</a>
        </div>
        <div class="hero__rule lb-reveal"><SpectrumRule width="180px" thickness={3} /></div>
      </div>
      <a href="#werk" class="hero__scroll lb-label">{L.home.scroll}</a>
    </section>

    <section id="werk" class="lb-section">
      <div class="lb-container">
        <header class="sec-head lb-reveal">
          <div><span class="lb-label">{L.home.selKicker}</span><h2 class="lb-display-m">{L.home.selTitle}</h2></div>
          <a href={locUrl('/werk/', lang)} class="sec-head__link">{L.home.selAll}</a>
        </header>
        <div class="work-grid lb-reveal">
          {teaser.map((item, i) => {
            const w = L.work[item.id];
            return (
              <a href={locUrl(`/werk/${item.id}/`, lang)} class:list={["lb-media lb-card", { big: i === 0 }]} aria-label={w.title}>
                <img src={src(item.photo, i === 0 ? 1600 : 1024)} srcset={srcset(item.photo)} sizes={i === 0 ? '(max-width:720px) 100vw, 66vw' : '(max-width:720px) 100vw, 33vw'} alt={w.alt} loading="lazy" width="1600" height="1066" />
                {item.type === 'video' && <span class="lb-card__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>}
                <div class="lb-card__meta">
                  <span class="lb-label lb-label--sky">{`0${i + 1} / 0${work.length}`} · {w.cat}</span>
                  <h3 class="lb-card__title">{w.title}</h3>
                  <span class="lb-card__sub lb-label">{w.place} · {item.year}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="lb-section course-teaser">
      <div class="lb-container">
        <a href={locUrl('/cursussen/', lang)} class="lb-media ct lb-reveal" aria-label={L.cursussen.c1.title}>
          <img src={src('1473968512647-3e447244af8f', 2000)} srcset={srcset('1473968512647-3e447244af8f')} sizes="100vw" alt="" loading="lazy" width="2000" height="1125" />
          <div class="ct__inner">
            <span class="lb-label lb-label--sky">{L.home.cFree}</span>
            <h2 class="lb-display-m" set:html={L.home.cTitle} />
            <p class="ct__sub">{L.home.cSub}</p>
            <span class="lb-btn ct__btn">{L.home.cBtn}</span>
          </div>
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,8,10,.55) 0%, rgba(8,8,10,.05) 22%, rgba(8,8,10,.15) 55%, rgba(8,8,10,.92) 100%); }
  .hero__inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(64px, 10vh, 130px); padding-top: 140px; }
  .hero__inner .lb-label { text-shadow: 0 1px 8px rgba(0,0,0,.65); }
  .hero__title { color: #fff; margin: 14px 0 0; text-shadow: 0 2px 18px rgba(0,0,0,.5); }
  .hero__lead { color: rgba(255,255,255,.92); font-size: clamp(17px, 2vw, 21px); max-width: 46ch; margin: 22px 0 0; text-shadow: 0 1px 10px rgba(0,0,0,.5); }
  .hero__cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
  .hero__rule { margin-top: 34px; }
  .hero__scroll { position: absolute; bottom: 26px; right: var(--lb-gutter); z-index: 2; color: rgba(255,255,255,.8); }
  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 32px; }
  .sec-head h2 { margin-top: 8px; }
  .sec-head__link { color: var(--lb-mist); font-size: var(--lb-small); white-space: nowrap; }
  .sec-head__link:hover { color: var(--lb-bone); }
  .work-grid { display: grid; grid-template-columns: 2fr 1fr; grid-auto-rows: 1fr; gap: 16px; }
  .lb-card { display: block; aspect-ratio: 4 / 3; }
  .lb-card.big { aspect-ratio: 16 / 10; grid-row: span 2; }
  .lb-card:hover img { transform: scale(1.03); }
  .lb-card__meta { position: absolute; left: 22px; right: 22px; bottom: 20px; z-index: 2; display: flex; flex-direction: column; gap: 6px; text-shadow: 0 1px 8px rgba(0,0,0,.6); }
  .lb-card__title { color: #fff; font-size: clamp(20px, 2.4vw, 30px); }
  .lb-card__sub { color: rgba(255,255,255,.8); }
  .lb-card__play { position: absolute; inset: 0; margin: auto; z-index: 2; width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.4); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  @media (max-width: 720px) { .work-grid { grid-template-columns: 1fr; } .lb-card.big { grid-row: auto; } .lb-card, .lb-card.big { aspect-ratio: 3 / 2; } }
  .ct { display: block; aspect-ratio: 21 / 9; }
  .ct__inner { position: absolute; z-index: 2; left: clamp(24px,4vw,56px); right: clamp(24px,4vw,56px); bottom: clamp(24px,4vw,48px); max-width: 60ch; }
  .ct__inner h2 { color: #fff; margin: 10px 0 0; }
  .ct__sub { color: rgba(255,255,255,.85); margin: 14px 0 20px; max-width: 52ch; }
  .ct__btn { pointer-events: none; }
  @media (max-width: 720px) { .ct { aspect-ratio: 4 / 5; } }
</style>
