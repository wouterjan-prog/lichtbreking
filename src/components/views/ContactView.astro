---
import Base from '../../layouts/Base.astro';
import GlassNav from '../GlassNav.astro';
import Footer from '../Footer.astro';
import SpectrumRule from '../SpectrumRule.astro';
import { t } from '../../i18n/ui.js';
const { lang = 'nl' } = Astro.props;
const L = t[lang].contact;
---
<Base title={L.title} description={L.desc} path="/contact/" lang={lang}>
  <GlassNav active="contact" lang={lang} />
  <main class="lb-container page">
    <header class="page-head lb-reveal">
      <span class="lb-label lb-label--sky">{L.kicker}</span>
      <h1 class="lb-display-l">{L.h1}</h1>
      <p class="lb-lead">{L.lead}</p>
      <div class="cta"><a href="mailto:hallo@lichtbreking.nl" class="lb-btn">hallo@lichtbreking.nl</a></div>
      <div class="rule"><SpectrumRule width="160px" thickness={3} /></div>
    </header>
    <div class="cards">
      {L.cards.map(([k, v, href]) => (
        <div class="card lb-reveal">
          <span class="lb-label">{k}</span>
          {href ? <a href={href} class="card__v">{v}</a> : <span class="card__v">{v}</span>}
        </div>
      ))}
    </div>
  </main>
  <Footer lang={lang} />
</Base>
<style>
  .page { padding-top: 140px; padding-bottom: 96px; }
  .page-head h1 { margin: 12px 0 18px; }
  .cta { margin: 26px 0 0; }
  .rule { margin-top: 30px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 44px; }
  .card { background: var(--lb-surface); border: 1px solid var(--lb-line); border-radius: var(--lb-r-lg); padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .card__v { color: var(--lb-bone); font-size: var(--lb-title); }
  a.card__v:hover { color: var(--lb-sky); }
  @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
</style>
