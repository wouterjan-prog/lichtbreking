---
import Base from '../../layouts/Base.astro';
import GlassNav from '../GlassNav.astro';
import Footer from '../Footer.astro';
import SpectrumRule from '../SpectrumRule.astro';
import { src, srcset } from '../../data/work.js';
import { t } from '../../i18n/ui.js';
const { lang = 'nl' } = Astro.props;
const L = t[lang].over;
---
<Base title={L.title} description={L.desc} path="/over/" lang={lang}>
  <GlassNav active="over" lang={lang} />
  <main>
    <section class="opener">
      <img class="opener__bg" src={src('1473968512647-3e447244af8f', 2000)} srcset={srcset('1473968512647-3e447244af8f')} sizes="100vw" alt="" fetchpriority="high" width="2000" height="1125" />
      <div class="opener__scrim" aria-hidden="true"></div>
      <div class="opener__inner lb-container">
        <span class="lb-label lb-label--sky lb-reveal">{L.kicker}</span>
        <h1 class="lb-display-l lb-reveal">{L.h1a}<br>{L.h1b}</h1>
      </div>
    </section>
    <section class="lb-section">
      <div class="lb-container body">
        <div class="story lb-reveal">
          <p class="lb-lead">{L.p1}</p>
          <p class="lb-muted">{L.p2}</p>
          <p class="lb-muted">{L.p3}</p>
          <SpectrumRule width="120px" />
        </div>
        <aside class="gear lb-reveal">
          <span class="lb-label">{L.gearTitle}</span>
          <ul>{L.gear.map(([k, v]) => <li><span class="lb-label">{k}</span><span class="gear__v">{v}</span></li>)}</ul>
        </aside>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
<style>
  .opener { position: relative; min-height: 70svh; display: flex; align-items: flex-end; overflow: hidden; }
  .opener__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .opener__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,8,10,.5) 0%, transparent 35%, rgba(8,8,10,.92) 100%); }
  .opener__inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(40px,6vw,80px); }
  .opener__inner h1 { color: #fff; margin-top: 12px; }
  .body { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(28px,5vw,64px); align-items: start; }
  .story p { margin-bottom: 18px; }
  .gear { background: var(--lb-surface); border: 1px solid var(--lb-line); border-radius: var(--lb-r-lg); padding: 26px; }
  .gear ul { margin-top: 16px; display: flex; flex-direction: column; gap: 16px; }
  .gear li { display: flex; flex-direction: column; gap: 4px; }
  .gear__v { color: var(--lb-bone); }
  @media (max-width: 760px) { .body { grid-template-columns: 1fr; } }
</style>
