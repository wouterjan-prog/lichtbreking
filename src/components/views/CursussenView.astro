---
import Base from '../../layouts/Base.astro';
import GlassNav from '../GlassNav.astro';
import Footer from '../Footer.astro';
import { src, srcset } from '../../data/work.js';
import { t, locUrl } from '../../i18n/ui.js';
const { lang = 'nl' } = Astro.props;
const L = t[lang].cursussen;
const courses = [
  { ...L.c1, href: '/cursus/vluchtfilmer/', badge: L.free, photo: '1507525428034-b723cf961d3e', soon: false },
  { ...L.c2, href: '/cursus/grondfilmer/', badge: L.free, photo: '1753588296403-be438eb432e5', soon: false },
  { ...L.c3, href: '#', badge: L.soon, photo: '1762740522491-2a4f7c754816', soon: true },
];
---
<Base title={L.title} description={L.desc} path="/cursussen/" lang={lang}>
  <GlassNav active="cursussen" lang={lang} />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container page">
    <header class="page-head lb-reveal">
      <span class="lb-label">{L.kicker}</span>
      <h1 class="lb-display-l">{L.h1}</h1>
      <p class="lb-lead">{L.lead}</p>
    </header>
    <div class="courses">
      {courses.map((c) => (
        <a href={c.href} class:list={["course lb-reveal", { soon: c.soon }]} aria-disabled={c.soon ? 'true' : undefined}>
          <div class="course__img lb-media">
            <img src={src(c.photo, 1024)} srcset={srcset(c.photo)} sizes="(max-width:860px) 100vw, 33vw" alt={c.title} loading="lazy" width="1200" height="800" />
            <span class:list={["course__badge", { soon: c.soon }]}>{c.badge}</span>
          </div>
          <div class="course__body">
            <span class="lb-label lb-label--sky">{c.kicker}</span>
            <h2 class="course__title">{c.title}</h2>
            <span class="lb-label">{c.meta}</span>
            <p class="course__desc">{c.desc}</p>
            <span class="course__cta">{c.soon ? L.soonBtn : L.open}</span>
          </div>
        </a>
      ))}
    </div>
    {lang === 'nl' && (
      <a href="/shotlist/" class="tool-cta lb-reveal">
        <div class="tool-cta__txt">
          <span class="lb-label lb-label--sky">Gratis tool</span>
          <h2 class="tool-cta__title">Shotlist-planner</h2>
          <p class="tool-cta__desc">Plan per locatie je shots — wide, medium, detail, drone of grond — en neem de lijst mee of print 'm.</p>
        </div>
        <span class="course__cta">Open de planner →</span>
      </a>
    )}
    {lang === 'nl' && (
      <a href="/gereedschap/" class="tool-cta lb-reveal">
        <div class="tool-cta__txt">
          <span class="lb-label lb-label--sky">Gratis tools</span>
          <h2 class="tool-cta__title">Gereedschap</h2>
          <p class="tool-cta__desc">ND-filter-calculator, wind go/no-go-checker en een pre-flight checklist — snel en praktisch voor onderweg.</p>
        </div>
        <span class="course__cta">Open het gereedschap →</span>
      </a>
    )}
    <p class="cursussen-note lb-muted lb-reveal">{L.note}</p>
  </main>
  <Footer lang={lang} />
</Base>
<style>
  .page { padding-top: 130px; padding-bottom: 96px; }
  .page-head { margin-bottom: 44px; }
  .page-head h1 { margin: 10px 0 18px; }
  .courses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .course { position: relative; display: flex; flex-direction: column; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); border-radius: var(--lb-r-lg); overflow: hidden; box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 16px 44px rgba(0,0,0,.28); transition: transform var(--lb-dur) var(--lb-ease); }
  .course::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.3px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .42; pointer-events: none; z-index: 2; }
  .course:hover { transform: translateY(-3px); }
  .course.soon { opacity: .72; pointer-events: none; }
  .course__img { aspect-ratio: 16 / 10; border-radius: 0; }
  .course__img::after { background: linear-gradient(180deg, transparent 55%, rgba(8,8,10,.5)); }
  .course__badge { position: absolute; top: 14px; left: 14px; z-index: 2; font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-night); background: var(--lb-bone); padding: 5px 10px; border-radius: 20px; }
  .course__badge.soon { background: rgba(255,255,255,.18); color: #fff; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .course__body { padding: 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .course__title { margin: 4px 0 2px; }
  .course__desc { color: var(--lb-mist); font-size: var(--lb-small); margin: 8px 0 16px; flex: 1; }
  .course__cta { color: var(--lb-bone); font-weight: 500; font-size: var(--lb-small); }
  .tool-cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 22px; padding: 26px 28px; background: var(--lb-ink); border: 1px solid var(--lb-line); border-radius: var(--lb-r-lg); transition: border-color var(--lb-dur) var(--lb-ease), transform var(--lb-dur) var(--lb-ease); }
  .tool-cta:hover { border-color: var(--lb-mist); transform: translateY(-2px); }
  .tool-cta__title { margin: 6px 0 4px; }
  .tool-cta__desc { color: var(--lb-mist); font-size: var(--lb-small); max-width: 60ch; margin: 0; }
  .cursussen-note { margin-top: 40px; max-width: 70ch; font-size: var(--lb-small); line-height: 1.7; }
  @media (max-width: 860px) { .courses { grid-template-columns: 1fr; } }
</style>
