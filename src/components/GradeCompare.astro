---
// Interactieve voor/na-grade — sleep om vlak D-Log M en een cinematische look te vergelijken.
const { caption = "Links: vlak D-Log M uit de camera. Rechts: dezelfde shot na een cinematische grade." } = Astro.props;
---
<figure class="gc">
  <div class="gc-head">
    <span class="lb-label lb-label--sky">Voor / na · sleep ⟷</span>
    <span class="gc-cam">DJI Mini 5 Pro · D-Log M</span>
  </div>
  <div class="gc-stage" data-gc>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="gcScene" viewBox="0 0 760 380">
      <defs>
        <linearGradient id="gcSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b4a7a"/><stop offset=".55" stop-color="#c98a52"/><stop offset="1" stop-color="#f2c27a"/></linearGradient>
        <linearGradient id="gcSea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9c98a"/><stop offset=".4" stop-color="#3f7fa6"/><stop offset="1" stop-color="#173b54"/></linearGradient>
      </defs>
      <rect width="760" height="220" fill="url(#gcSky)"/><circle cx="500" cy="178" r="40" fill="#ffe7b0"/>
      <rect y="220" width="760" height="160" fill="url(#gcSea)"/><ellipse cx="500" cy="240" rx="46" ry="34" fill="#ffe7b0" opacity=".55"/>
      <path d="M0 220 L160 220 L120 150 L70 185 L30 140 L0 165 Z" fill="#23303e"/>
      <path d="M610 220 L760 220 L760 120 L700 165 L660 130 Z" fill="#1d2a37"/>
      <rect y="218" width="760" height="3" fill="#ffffff" opacity=".18"/>
    </symbol></svg>
    <div class="gc-lay gc-flat"><svg viewBox="0 0 760 380" width="100%" height="100%" preserveAspectRatio="xMidYMid slice"><use href="#gcScene"/></svg></div>
    <div class="gc-lay gc-grade" data-gc-grade><svg viewBox="0 0 760 380" width="100%" height="100%" preserveAspectRatio="xMidYMid slice"><use href="#gcScene"/></svg></div>
    <div class="gc-handle" data-gc-handle><span>⟷</span></div>
    <span class="gc-tag gc-tag--l">Gegradeerd</span>
    <span class="gc-tag gc-tag--r">Plat log</span>
  </div>
  <figcaption class="gc-cap">{caption}</figcaption>
</figure>

<style is:global>
  .gc { margin: 1.8rem 0; }
  .gc-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
  .gc-cam { font-size: 12px; color: var(--lb-mist); }
  .gc-stage { position: relative; width: 100%; aspect-ratio: 760/360; border-radius: 16px; overflow: hidden; border: 1px solid var(--lb-glass-border); cursor: ew-resize; user-select: none; touch-action: none; }
  .gc-lay { position: absolute; inset: 0; }
  .gc-flat svg { filter: grayscale(.4) saturate(.5) contrast(.72) brightness(1.22); }
  .gc-grade { clip-path: inset(0 45% 0 0); }
  .gc-grade svg { filter: saturate(1.3) contrast(1.14) brightness(1.02); }
  .gc-grade::after { content: ""; position: absolute; inset: 0; background: linear-gradient(125deg, rgba(38,90,150,.30), rgba(255,150,60,.26)); mix-blend-mode: overlay; pointer-events: none; }
  .gc-handle { position: absolute; top: 0; bottom: 0; left: 55%; width: 2px; background: #F4F3EF; box-shadow: 0 0 0 1px rgba(0,0,0,.25); }
  .gc-handle span { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 34px; height: 34px; border-radius: 50%; background: #F4F3EF; color: #08080A; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; box-shadow: 0 2px 10px rgba(0,0,0,.4); }
  .gc-tag { position: absolute; top: 12px; font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; background: rgba(8,8,10,.6); padding: 4px 9px; border-radius: 6px; color: #cdd2d8; }
  .gc-tag--l { left: 14px; } .gc-tag--r { right: 14px; }
  .gc-cap { font-size: 12.5px; color: var(--lb-mist); margin: 10px 2px 0; }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-gc]').forEach(function (st) {
      var g = st.querySelector('[data-gc-grade]'), h = st.querySelector('[data-gc-handle]'), drag = false;
      function set(x) { var r = st.getBoundingClientRect(); var p = Math.max(2, Math.min(98, (x - r.left) / r.width * 100)); g.style.clipPath = 'inset(0 ' + (100 - p) + '% 0 0)'; h.style.left = p + '%'; }
      st.addEventListener('pointerdown', function (e) { drag = true; set(e.clientX); });
      window.addEventListener('pointermove', function (e) { if (drag) set(e.clientX); });
      window.addEventListener('pointerup', function () { drag = false; });
    });
  })();
</script>
