---
// Interactieve voor/na-grade op een ECHTE foto — sleep om vlak (log) en een cinematische look te vergelijken.
const {
  caption = "Links: een vlakke, ongegradeerde opname. Rechts: dezelfde shot na een cinematische grade.",
  photo = "1576682953661-a056a5073019",
} = Astro.props;
const url = `https://images.unsplash.com/photo-${photo}?w=1200&q=75&auto=format&fit=crop`;
---
<figure class="gc">
  <div class="gc-head">
    <span class="lb-label lb-label--sky">Voor / na · sleep ⟷</span>
    <span class="gc-cam">Kleurcorrectie &amp; grading</span>
  </div>
  <div class="gc-stage" data-gc>
    <div class="gc-lay gc-flat"><img src={url} alt="" loading="lazy" decoding="async" /></div>
    <div class="gc-lay gc-grade" data-gc-grade><img src={url} alt="" loading="lazy" decoding="async" /></div>
    <div class="gc-handle" data-gc-handle tabindex="0" role="slider" aria-label="Vergelijk voor en na — gebruik de pijltjestoetsen" aria-valuemin="0" aria-valuemax="100" aria-valuenow="45"><span>⟷</span></div>
    <span class="gc-tag gc-tag--l">Gegradeerd</span>
    <span class="gc-tag gc-tag--r">Ongegradeerd</span>
  </div>
  <figcaption class="gc-cap">{caption}</figcaption>
</figure>

<style is:global>
  .gc { margin: 1.8rem 0; }
  .gc-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
  .gc-cam { font-size: 12px; color: var(--lb-mist); }
  .gc-stage { position: relative; width: 100%; aspect-ratio: 3/2; max-height: 460px; border-radius: 16px; overflow: hidden; border: 1px solid var(--lb-glass-border); cursor: ew-resize; user-select: none; touch-action: none; background: #16171B; }
  .gc-lay { position: absolute; inset: 0; }
  .gc-lay img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gc-flat img { filter: grayscale(.35) saturate(.55) contrast(.74) brightness(1.16); }
  .gc-grade { clip-path: inset(0 45% 0 0); }
  .gc-grade img { filter: saturate(1.28) contrast(1.12) brightness(1.0); }
  .gc-grade::after { content: ""; position: absolute; inset: 0; background: linear-gradient(125deg, rgba(38,90,150,.26), rgba(255,150,60,.24)); mix-blend-mode: overlay; pointer-events: none; }
  .gc-handle { position: absolute; top: 0; bottom: 0; left: 55%; width: 2px; background: #F4F3EF; box-shadow: 0 0 0 1px rgba(0,0,0,.25); }
  .gc-handle span { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 36px; height: 36px; border-radius: 50%; background: #F4F3EF; color: #08080A; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; box-shadow: 0 2px 12px rgba(0,0,0,.45); }
  .gc-handle:focus-visible { outline: none; }
  .gc-handle:focus-visible span { outline: 3px solid var(--lb-sky); outline-offset: 2px; }
  .gc-tag { position: absolute; top: 12px; font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; background: rgba(8,8,10,.62); padding: 4px 9px; border-radius: 6px; color: #cdd2d8; }
  .gc-tag--l { left: 14px; } .gc-tag--r { right: 14px; }
  .gc-cap { font-size: 12.5px; color: var(--lb-mist); margin: 10px 2px 0; }
</style>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-gc]').forEach(function (st) {
      var g = st.querySelector('[data-gc-grade]'), h = st.querySelector('[data-gc-handle]'), drag = false, pct = 45;
      function apply() { g.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)'; h.style.left = pct + '%'; h.setAttribute('aria-valuenow', Math.round(pct)); }
      function setFromX(x) { var r = st.getBoundingClientRect(); pct = Math.max(2, Math.min(98, (x - r.left) / r.width * 100)); apply(); }
      st.addEventListener('pointerdown', function (e) { drag = true; setFromX(e.clientX); });
      window.addEventListener('pointermove', function (e) { if (drag) setFromX(e.clientX); });
      window.addEventListener('pointerup', function () { drag = false; });
      h.addEventListener('keydown', function (e) {
        var step = e.shiftKey ? 10 : 4;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { pct = Math.max(2, pct - step); apply(); e.preventDefault(); }
        else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { pct = Math.min(98, pct + step); apply(); e.preventDefault(); }
        else if (e.key === 'Home') { pct = 2; apply(); e.preventDefault(); }
        else if (e.key === 'End') { pct = 98; apply(); e.preventDefault(); }
      });
    });
  })();
</script>
