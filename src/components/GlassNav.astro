---
/* GlassNav.astro — zwevende glas-navigatie met thema-toggle, scroll-staat,
   actieve link en mobiel menu. */
import Logo from "./Logo.astro";
import { t, locUrl, switchUrl } from "../i18n/ui.js";
const { active = "", lang = "nl", switchHref } = Astro.props;
const L = t[lang] || t.nl;
const items = [
  { label: L.nav.werk, href: locUrl("/werk/", lang), id: "werk" },
  { label: L.nav.cursus, href: locUrl("/cursussen/", lang), id: "cursussen" },
  { label: L.nav.over, href: locUrl("/over/", lang), id: "over" },
  { label: L.nav.contact, href: locUrl("/contact/", lang), id: "contact" },
];
const langHref = switchHref || switchUrl(Astro.url.pathname, lang === "nl" ? "en" : "nl");
---
<header class="lb-nav-shell" data-lb-nav>
  <nav class="lb-nav" aria-label="Hoofdnavigatie">
    <a href={locUrl("/", lang)} class="lb-nav__brand" aria-label={L.nav.home}><Logo size={26} /></a>

    <button class="lb-nav__burger" id="lb-burger" aria-label={L.nav.menu} aria-expanded="false" aria-controls="lb-nav-links">
      <span></span><span></span><span></span>
    </button>

    <div class="lb-nav__links" id="lb-nav-links">
      {items.map((it) => (
        <a href={it.href} class={active === it.id ? "on" : ""} aria-current={active === it.id ? "page" : undefined}>{it.label}</a>
      ))}
      <div class="lb-nav__drop">
        <a href="/gereedschap/" class:list={["lb-nav__droptop", { on: active === "gereedschap" }]} aria-current={active === "gereedschap" ? "page" : undefined}>
          {L.nav.tools}
          <svg class="lb-nav__caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <div class="lb-nav__menu">
          <a href="/gereedschap/">{L.nav.nd}</a>
          <a href="/gouden-uur/">{L.nav.golden}</a>
        </div>
      </div>
      <a class="lb-nav__cta" href={locUrl("/showreel/", lang)}>{L.nav.showreel}</a>
      <a class="lb-nav__lang" href={langHref} aria-label={lang === "nl" ? "Switch to English" : "Schakel naar Nederlands"}>{L.otherName}</a>
      <button class="lb-nav__theme" id="lb-theme-toggle" aria-label={L.nav.theme} title={L.nav.theme}>
        <svg class="ic-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"/></svg>
        <svg class="ic-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z"/></svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .lb-nav-shell {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    padding: 18px var(--lb-gutter) 0; pointer-events: none;
  }
  .lb-nav {
    pointer-events: auto; position: relative;
    display: flex; align-items: center; flex-wrap: nowrap; gap: 18px;
    max-width: var(--lb-maxw); margin: 0 auto;
    border-radius: 26px; padding: 11px 12px 11px 20px;
    color: #fff; /* boven de hero: wit */
    background: rgba(255,255,255,.12);
    -webkit-backdrop-filter: blur(18px) saturate(185%);
    backdrop-filter: blur(18px) saturate(185%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 10px 34px rgba(0,0,0,.22);
    transition: background var(--lb-dur) var(--lb-ease), box-shadow var(--lb-dur) var(--lb-ease), color var(--lb-dur) var(--lb-ease);
  }
  /* refractie: spectrum-prisma rand (licht breekt in het glas) */
  .lb-nav::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px;
    background: linear-gradient(90deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: .9; pointer-events: none;
  }
  /* bij scroll: dichter glas + thema-tekstkleur, rand iets gedimd */
  .lb-nav-shell.scrolled .lb-nav {
    background: var(--lb-glass-solid);
    color: var(--lb-bone);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 10px 34px rgba(0,0,0,.28);
  }
  .lb-nav-shell.scrolled .lb-nav::after { opacity: .65; }

  .lb-nav__brand { display: inline-flex; align-items: center; flex: 0 0 auto; }
  .lb-nav__links { display: flex; align-items: center; gap: 22px; font-size: 15px; margin-left: auto; min-width: 0; }
  .lb-nav__links > a {
    color: inherit; opacity: .9; white-space: nowrap; flex: 0 0 auto;
    text-shadow: 0 1px 3px rgba(0,0,0,.28); transition: opacity .3s var(--lb-ease);
  }
  .lb-nav-shell.scrolled .lb-nav__links > a { text-shadow: none; }
  .lb-nav__links > a:hover, .lb-nav__links > a.on { opacity: 1; }
  /* CTA — altijd hoog contrast: bone-vlak + omgekeerde inkt-tekst */
  .lb-nav .lb-nav__cta {
    flex: 0 0 auto; white-space: nowrap; font-weight: 500;
    background: var(--lb-bone); color: var(--lb-ink) !important;
    padding: 9px 18px; border-radius: var(--lb-r-pill); opacity: 1; text-shadow: none;
    box-shadow: 0 2px 10px rgba(0,0,0,.18);
  }
  .lb-nav__theme {
    flex: 0 0 auto; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,.16); color: inherit; border: 1px solid rgba(255,255,255,.28); cursor: pointer;
  }
  .lb-nav-shell.scrolled .lb-nav__theme { background: rgba(127,127,140,.16); border-color: var(--lb-line); }
  .lb-nav__lang {
    flex: 0 0 auto; font-family: var(--lb-font-mono); font-size: 12px; letter-spacing: .08em;
    color: inherit; opacity: .82; padding: 6px 7px; border-radius: 8px; white-space: nowrap;
    text-shadow: 0 1px 3px rgba(0,0,0,.28); transition: opacity .25s var(--lb-ease);
  }
  .lb-nav__lang:hover { opacity: 1; }
  /* Gereedschap-dropdown */
  .lb-nav__drop { position: relative; flex: 0 0 auto; }
  .lb-nav__droptop { display: inline-flex; align-items: center; gap: 4px; color: inherit; opacity: .9; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,.28); transition: opacity .3s var(--lb-ease); cursor: pointer; }
  .lb-nav-shell.scrolled .lb-nav__droptop { text-shadow: none; }
  .lb-nav__droptop:hover, .lb-nav__droptop.on { opacity: 1; }
  .lb-nav__caret { transition: transform .25s var(--lb-ease); }
  .lb-nav__drop:hover .lb-nav__caret, .lb-nav__drop:focus-within .lb-nav__caret { transform: rotate(180deg); }
  .lb-nav__menu { position: absolute; top: calc(100% + 22px); left: 50%; transform: translateX(-50%) translateY(-6px); min-width: 216px; z-index: 60;
    background: var(--lb-surface); border-radius: 16px; padding: 6px; box-shadow: 0 20px 54px rgba(0,0,0,.42), inset 0 1px 0 var(--lb-glass-hi);
    display: flex; flex-direction: column; gap: 2px; opacity: 0; pointer-events: none; transition: opacity .22s var(--lb-ease), transform .22s var(--lb-ease); }
  /* spectrum-refractierand op het paneel */
  .lb-nav__menu::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.2px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .55; pointer-events: none; }
  /* onzichtbare brug zodat hover niet wegvalt over de tussenruimte */
  .lb-nav__menu::before { content: ""; position: absolute; top: -22px; left: 0; right: 0; height: 22px; }
  .lb-nav__drop:hover .lb-nav__menu, .lb-nav__drop:focus-within .lb-nav__menu { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }
  .lb-nav__menu a { position: relative; z-index: 1; color: var(--lb-bone); padding: 11px 14px; border-radius: 10px; white-space: nowrap; font-size: 15px; text-shadow: none; opacity: 1; transition: background .2s var(--lb-ease); }
  .lb-nav__menu a:hover { background: var(--lb-ink); }
  .lb-nav-shell.scrolled .lb-nav__lang { text-shadow: none; }
  .ic-moon { display: none; }
  :root[data-theme="dark"] .ic-sun { display: none; }
  :root[data-theme="dark"] .ic-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .ic-sun { display: none; }
    :root:not([data-theme]) .ic-moon { display: block; }
  }
  /* burger */
  .lb-nav__burger { display: none; flex-direction: column; gap: 4px; width: 38px; height: 36px;
    margin-left: auto; background: none; border: 0; cursor: pointer; padding: 9px 8px; color: inherit; }
  .lb-nav__burger span { height: 2px; width: 100%; background: currentColor; border-radius: 2px; transition: .3s var(--lb-ease); }
  .lb-nav__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .lb-nav__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .lb-nav__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 960px) {
    .lb-nav__burger { display: flex; }
    .lb-nav__links {
      position: absolute; top: calc(100% + 10px); right: 0; left: 0; margin-left: 0;
      flex-direction: column; align-items: stretch; gap: 4px; padding: 12px;
      border-radius: 18px; background: var(--lb-surface);
      border: 1px solid var(--lb-line); color: var(--lb-bone);
      box-shadow: var(--lb-shadow-float);
      opacity: 0; transform: translateY(-8px); pointer-events: none; transition: .3s var(--lb-ease);
    }
    .lb-nav__links.open { opacity: 1; transform: none; pointer-events: auto; }
    .lb-nav__links > a { opacity: 1; color: var(--lb-bone); text-shadow: none; padding: 11px 12px; border-radius: 10px; }
    .lb-nav__links > a:hover, .lb-nav__links > a.on { background: var(--lb-ink); }
    .lb-nav__lang { color: var(--lb-bone); text-shadow: none; }
    .lb-nav__cta { text-align: center; }
    .lb-nav__theme { margin-top: 4px; }
    /* dropdown wordt platte lijst in het flyout-menu */
    .lb-nav__drop { width: 100%; }
    .lb-nav__droptop { color: var(--lb-bone); text-shadow: none; padding: 11px 12px; border-radius: 10px; opacity: 1; }
    .lb-nav__caret { display: none; }
    .lb-nav__menu { position: static; transform: none; opacity: 1; pointer-events: auto; min-width: 0; padding: 2px 0 6px 10px;
      background: none; border: 0; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
    /* desktop-hover-transform mag hier niet lekken (anders schuift de tekst weg) */
    .lb-nav__drop:hover .lb-nav__menu, .lb-nav__drop:focus-within .lb-nav__menu { transform: none; }
    .lb-nav__menu::before, .lb-nav__menu::after { display: none; }
    .lb-nav__menu a { padding: 10px 12px; border-radius: 10px; opacity: 1; }
    .lb-nav__menu a:hover { background: var(--lb-ink); }
  }
</style>

<script is:inline>
  (function () {
    var shell = document.querySelector('[data-lb-nav]');
    if (shell) {
      var onScroll = function () { shell.classList.toggle('scrolled', window.scrollY > 40); };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
    var burger = document.getElementById('lb-burger');
    var links = document.getElementById('lb-nav-links');
    if (burger && links) {
      burger.addEventListener('click', function () {
        var open = links.classList.toggle('open');
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
    var toggle = document.getElementById('lb-theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', function () {
        var root = document.documentElement;
        var cur = root.getAttribute('data-theme');
        if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        var next = cur === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('lb-theme', next); } catch (e) {}
      });
    }
  })();
</script>
