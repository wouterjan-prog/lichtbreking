---
import '../styles/v4.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

const {
  titel,
  beschrijving = site.beschrijving,
  hero = false,          /* true → de pagina levert zelf de hero mét nav */
  ogAfbeelding = '/img/og.jpg',
  noindex = false,
} = Astro.props;

const paginaTitel = titel ? `${titel} · lichtbreking` : 'lichtbreking';
const canoniek = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogAfbeelding, site.url).href;

/* Gestructureerde data: wie de site is, welke site het is, en welke pagina je bekijkt.
   Zoekmachines lezen dit om merk, taal en samenhang te begrijpen. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organisatie`,
      name: 'Lichtbreking',
      url: `${site.url}/`,
      email: site.email,
      logo: { '@type': 'ImageObject', url: `${site.url}/app-icon-512.png` },
      sameAs: [site.instagram],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: 'lichtbreking',
      inLanguage: 'nl-NL',
      description: site.beschrijving,
      publisher: { '@id': `${site.url}/#organisatie` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canoniek}#pagina`,
      url: canoniek,
      name: paginaTitel,
      description: beschrijving,
      inLanguage: 'nl-NL',
      isPartOf: { '@id': `${site.url}/#website` },
    },
  ],
};
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{paginaTitel}</title>
    <meta name="description" content={beschrijving} />
    <link rel="canonical" href={canoniek} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#08080A" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />

    <!-- Albert Sans wordt zelf gehost en pas opgehaald als het lettertype echt
         nodig is. Op Apple-apparaten wint de systeemfont uit de stack, dus daar
         wordt er niets gedownload. -->

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lichtbreking" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={paginaTitel} />
    <meta property="og:description" content={beschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap.xml" />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </head>
  <body>
    <a class="lb-overslaan" href="#inhoud">Naar de inhoud</a>
    {!hero && <Nav variant="vast" />}
    <slot name="hero" />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
  </body>
</html>
