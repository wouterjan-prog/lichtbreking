---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import SpectrumRule from '../../components/SpectrumRule.astro';
import ProCheatsheet from '../../components/ProCheatsheet.astro';
import VeldkaartAction from '../../components/veldkaart/VeldkaartAction.astro';

const situaties = [
  { s: 'Zwembad', r: 'Onderwater-WB · geen filter · 4K/60 voor slow-mo · stabilisatie laag of uit.' },
  { s: 'Zee & snorkelen (0–5 m)', r: 'Onderwater-witbalans · dichtbij komen · zon in je rug · geen filter nodig.' },
  { s: 'Duiken (tot ~15 m)', r: 'Onderwater-WB + Dive-modus · ISO laag · diafragma open (f/2.0) · D-Log M voor kleurmarge.' },
  { s: 'Dieper / grotten / nacht', r: 'Witbalans stopt met werken → videolamp (WB op lampkleur), of D-Log M en corrigeren in de grade.' },
];

const basis = [
  'Bitrate op High + Video Quality Priority aan — de grootste kwaliteitswinst (kost accu en warmte).',
  '4K, framerate 25 fps (EU-look) of 50 fps als je wilt kunnen vertragen — meng geen families.',
  'Video is altijd 10-bit; geen aparte knop nodig.',
  'Pro-modus: EV −0.3, ISO als range 100–800 (vast op 100 voor cine), witbalans vast op 5600 K, Color op Normal (of D-Log M om te graden).',
  'Image adjustment: scherpte ("Texture") −1 à −2, ruisreductie −1 à −2 — zachter oogt filmischer.',
  'Beeldhoek en stabilisatie zijn gekoppeld: Wide, Natural Wide en UltraWide kunnen alléén met RockSteady; HorizonBalancing en HorizonSteady vergrendelen de FOV op Standard (dewarp). Kies per shot: breed beeld (RockSteady) of gegarandeerd rechte horizon (HorizonBalancing + Standard).',
];

const perGel = [
  { g: 'Algemeen / cinematisch', m: 'Video', r: '4K/25', f: 'Standard (Dewarp)', s: 'HorizonBalancing', d: 'f/2.8 vast (M) of Auto', x: 'WB 5600 K vast · breed beeld? Wide + RockSteady' },
  { g: 'Actie & sport', m: 'Video', r: '4K/50–60', f: 'Wide / UltraWide', s: 'RockSteady 3.0+', d: 'Auto', x: 'ISO-range 100–800' },
  { g: 'Slow-motion', m: 'Video', r: '4K/120 · 1080p 8× (240)', f: 'Wide', s: 'RockSteady', d: 'f/2.0–2.8', x: 'veel licht · >60 fps: geen horizonmodi' },
  { g: 'Weinig licht / avond', m: 'SuperNight', r: '4K/25–30', f: 'Standard (Dewarp)', s: 'HorizonBalancing', d: 'Large f/2.0', x: 'ISO laag · nooit 50/60 fps in donker' },
  { g: 'Stad met lampen ’s nachts', m: 'Video/Foto', r: '—', f: '—', s: '—', d: 'Starburst f/4.0', x: 'geeft sterretjes' },
  { g: 'Onder water (filterloos)', m: 'Video', r: '4K/25–30', f: 'Wide', s: 'laag / uit', d: 'f/2.0 of Auto', x: 'Dive-/onderwater-WB · Dive Case >20 m' },
  { g: 'Timelapse (statief)', m: 'Timelapse', r: '4K/25–30', f: 'Standard/Wide', s: 'uit', d: 'Auto', x: 'interval 2–5 s wolken, langer voor sterren · belichting + WB vast' },
  { g: 'Hyperlapse (lopend/rijdend)', m: 'Hyperlapse', r: '4K/25–30', f: 'Wide', s: 'RockSteady', d: 'Auto', x: '×5–×10 · WB vast' },
  { g: 'Foto landschap', m: 'Photo', r: 'RAW+JPEG · 4:3', f: 'Standard (Dewarp)', s: '—', d: 'Fixed f/2.8', x: 'WB 5600 K' },
  { g: 'Foto nacht', m: 'Photo', r: 'statief', f: 'Standard', s: '—', d: 'f/2.0', x: 'lange sluiter, ISO laag' },
  { g: 'Vertical / socials', m: 'Portrait Mode of 9:16', r: '2.7K/1080p', f: 'Natural Wide', s: 'RockSteady', d: 'Auto', x: 'belichting op huidtint' },
  { g: 'Onderwerp volgen', m: 'Subject Tracking', r: '2.7K 16:9 of 9:16 /30–60', f: 'Wide', s: 'RockSteady', d: 'Auto', x: 'houdt onderwerp gecentreerd' },
];

const modi = [
  { k: 'Photo', v: 'Stilstaand beeld. Kies RAW+JPEG voor bewerkingsruimte; 4:3 gebruikt de volledige sensor.' },
  { k: 'Video', v: 'Je hoofdmodus — altijd 10-bit.' },
  { k: 'SuperNight', v: 'Nachtmodus die het f/2.0-diafragma met ruisonderdrukking combineert; 4K tot 60 fps.' },
  { k: 'Portrait Mode', v: 'Herkent de persoon en optimaliseert de belichting voor natuurlijke huidtinten.' },
  { k: 'Subject Tracking', v: 'Houdt een bewegend onderwerp automatisch gecentreerd (ski, fiets); 2.7K/1080p.' },
  { k: 'Slow-motion', v: '4K 4× (120 fps), 1080p 8× (240 fps), tot 32× super-slow via interpolatie. Veel licht nodig.' },
  { k: 'Timelapse', v: 'Vanaf statief; versnelt beweging (wolken, sterren). Interval en duur instelbaar.' },
  { k: 'Hyperlapse', v: 'Timelapse terwijl je zelf beweegt, met RockSteady en ×2–×30 snelheid.' },
];

const fov = [
  { k: 'Standard (Dewarp)', v: 'Alle vertekening weg, rechte lijnen — het beste voor architectuur en landschapsfoto.' },
  { k: 'Natural Wide', v: 'Breed beeld, maar corrigeert verticale vertekening (gebouwen, bomen). Ideaal voor vloggen.' },
  { k: 'Wide', v: 'De allrounder: breed met beperkte bolling.' },
  { k: 'UltraWide', v: 'Het breedst, met de meeste fisheye-vertekening; voor actie dichtbij.' },
];

const aspect = [
  { k: '16:9', v: 'Standaard liggend — je default voor cinematisch/landschap; beste kwaliteit voor liggend afspelen.' },
  { k: '9:16 (Portrait)', v: 'Verticaal voor socials, ongeacht camerastand.' },
  { k: 'Landscape lock', v: 'Blijft horizontaal, ook als de camera kantelt.' },
  { k: 'Custom (vierkant)', v: 'Vangnet: film 1:1 met croplijnen als één opname zowel liggend als staand moet werken. Snij achteraf — kost breedte/resolutie per oriëntatie. Weet je je einddoel? Kies dan vooraf 16:9 of 9:16.' },
];

const stab = [
  { k: 'HorizonBalancing', v: 'Houdt de horizon recht binnen ±45° kanteling, met beperkte crop, tot 4K/60. Let op: vergrendelt de beeldhoek op Standard (dewarp) en werkt niet boven 60 fps.' },
  { k: 'RockSteady 3.0 / 3.0+', v: 'De enige modus met alle vier de beeldhoeken (Standard t/m UltraWide) en natuurlijke beweging. Pak deze voor breed beeld, 4K/120-slowmo (horizonmodi kunnen daar niet) en bewuste kanteling (berm, motor). 3.0+ bij heftige trillingen.' },
  { k: 'HorizonSteady', v: 'Vergrendelt de horizon over volle 360° rotatie (tot 4K/60), maar snijdt fors bij en vergrendelt óók op Standard-FOV. Alleen voor rollende of draaiende actie.' },
  { k: 'Uit / laag', v: 'Voor statief en timelapse (stabilisatie is daar ruis), en onder water laag of uit — daar is geen horizon om op te sturen.' },
];

const pro = [
  { k: 'Exposure (EV)', v: '−0.3 als vuistregel; action cams overbelichten licht. EV werkt alleen bij auto-belichting; in M stuur je met ND en diafragma.' },
  { k: 'ISO', v: 'Per preset vast of als min–max-range: 100–800 als standaard, op diepte tot 1600, vast op 100 voor cine en timelapse.' },
  { k: 'Witbalans', v: 'Vast op ~5600 K tegen kleurverspringen; 5000–5100 K voor sneeuw, warmer bij zonsondergang.' },
  { k: 'Color', v: 'Normal (klaar) of D-Log M (vlak, meer dynamisch bereik; met live color-recovery-preview en kleurherstel in de Mimo-app).' },
  { k: 'Variabel diafragma', v: 'Auto (f/2.0–4.0), Fixed (f/2.8, scherp tot 35 cm), Starburst (f/4.0, sterretjes, tot 20 cm), Large (f/2.0, nacht/macro).' },
  { k: 'Stabilization scenario', v: 'De stabilisatiekeuze koppelt aan je FOV en resolutie; onder water of op statief zet je hem lager of uit.' },
  { k: 'Image adjustment', v: 'Scherpte ("Texture") en ruisreductie — liever iets zachter (−1/−2). Scherpte voeg je later toe; weghalen kan niet.' },
];

const jsonld = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: 'DJI Osmo Action 6 — action & onderwater settings',
  inLanguage: 'nl-NL', url: 'https://www.lichtbreking.nl/gids/action-6/',
};
---
<Base
  title="DJI Osmo Action 6: action & onderwater settings — de gids"
  description="De complete instellingen voor de Osmo Action 6, boven én onder water. Cheatsheet, het variabele diafragma, de Dive-modus en onderwater-witbalans — filterloos — plus recepten per situatie."
  path="/gids/action-6/" image="/img/og-actiefilmer.png"
  jsonld={jsonld}>
  <GlassNav active="" switchHref="/en/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container a6-page">
    <header class="a6-head lb-reveal">
      <span class="lb-label lb-label--sky">Gids · DJI Osmo Action 6</span>
      <h1 class="lb-display-l">Action 6: boven &amp; onder water</h1>
      <p class="lb-lead">De complete instellingen voor de Osmo Action 6 — met het variabele diafragma, de Dive-modus en de onderwater-witbalans. Onder water werk ik <strong>filterloos</strong>: de camera haalt de kleur zelf terug.</p>
      <div class="a6-cta">
        <a href="/downloads/veldkaart-action-6.pdf" class="lb-btn" download>Veldkaart (PDF, print-klaar) ↓</a>
        <a href="/cursus/actiefilmer/" class="lb-btn lb-btn--ghost">Naar de cursus De Actiefilmer →</a>
        <a href="/artikelen/onderwater-action-instellingen/" class="lb-btn lb-btn--ghost">Onderwater-artikel</a>
      </div>
      <div class="a6-rule"><SpectrumRule width="160px" thickness={3} /></div>
    </header>

    <section class="a6-block a6-wide lb-reveal">
      <span class="lb-label lb-label--sky">Veldkaart · Curaçao-editie</span>
      <h2 class="lb-display-m">Instellen in 30 seconden</h2>
      <p class="lb-lead">Voor op je telefoon, of geprint in de cameratas: het instel-ritueel, je vijf custom modes (C1–C5) en per scène een Normaal- en een PRO-regel.</p>
      <VeldkaartAction />
    </section>

    <section class="a6-cheat lb-reveal">
      <span class="lb-label lb-label--sky">Cheatsheet</span>
      <h2 class="lb-display-m">Alle instellingen op een rij</h2>
      <p class="lb-lead">Dezelfde waarden als in de cursus en op de gereedschap-pagina — mét per instelling het waarom.</p>
      <ProCheatsheet cams={['action']} />
    </section>

    <section class="a6-block a6-wide lb-reveal">
      <span class="lb-label lb-label--sky">Alle instellingen</span>
      <h2 class="lb-display-m">Wanneer welke instelling?</h2>
      <p class="lb-lead">Zet de basis één keer goed; kies daarna per gelegenheid. Alle standen en pro-functies staan er kort onder.</p>

      <div class="a6-basis">
        <strong>De basis — één keer zetten</strong>
        <ul>{basis.map((b) => (<li>{b}</li>))}</ul>
      </div>

      <h3 class="a6-h3">Beste instelling per gelegenheid</h3>
      <div class="a6-scroll">
        <table class="a6-tbl">
          <thead><tr><th>Gelegenheid</th><th>Modus</th><th>Res / fps</th><th>FOV</th><th>Stabilisatie</th><th>Diafragma</th><th>Extra</th></tr></thead>
          <tbody>
            {perGel.map((r) => (<tr><td>{r.g}</td><td>{r.m}</td><td>{r.r}</td><td>{r.f}</td><td>{r.s}</td><td>{r.d}</td><td>{r.x}</td></tr>))}
          </tbody>
        </table>
      </div>

      <h3 class="a6-h3">Opnamemodi</h3>
      <div class="a6-sit">{modi.map((x) => (<div class="a6-sitrow"><span class="a6-sitk">{x.k}</span><span class="a6-sitv">{x.v}</span></div>))}</div>

      <h3 class="a6-h3">Beeldhoek (FOV)</h3>
      <div class="a6-sit">{fov.map((x) => (<div class="a6-sitrow"><span class="a6-sitk">{x.k}</span><span class="a6-sitv">{x.v}</span></div>))}</div>

      <h3 class="a6-h3">Aspect ratio</h3>
      <div class="a6-sit">{aspect.map((x) => (<div class="a6-sitrow"><span class="a6-sitk">{x.k}</span><span class="a6-sitv">{x.v}</span></div>))}</div>

      <h3 class="a6-h3">Stabilisatie</h3>
      <div class="a6-sit">{stab.map((x) => (<div class="a6-sitrow"><span class="a6-sitk">{x.k}</span><span class="a6-sitv">{x.v}</span></div>))}</div>

      <h3 class="a6-h3">Pro-functies</h3>
      <div class="a6-sit">{pro.map((x) => (<div class="a6-sitrow"><span class="a6-sitk">{x.k}</span><span class="a6-sitv">{x.v}</span></div>))}</div>
    </section>

    <section class="a6-block lb-reveal">
      <span class="lb-label lb-label--sky">Onder water</span>
      <h2 class="lb-display-m">Kleur terug — zónder kleurfilter</h2>
      <p class="lb-lead">Water slikt eerst rood, dan oranje en geel. De Action 6 corrigeert dat zelf met een aparte witbalans-sensor: zet de onderwater-witbalans (Dive-modus) aan en de kleuren komen terug — geen rood of magenta filter nodig, en je verliest geen licht.</p>
      <div class="a6-note">
        <strong>De grens van witbalans.</strong> Ondiep (zwembad, snorkelen, tot ~10–15 m) doet de onderwater-witbalans het uitstekend. Dieper is er te weinig rood licht over om terug te balanceren: pak dan een videolamp (witbalans op de lampkleur), of film in D-Log M en haal de laatste kleur terug in de grade.
      </div>
    </section>

    <section class="a6-block lb-reveal">
      <span class="lb-label lb-label--sky">Recepten</span>
      <h2 class="lb-display-m">Per situatie</h2>
      <div class="a6-sit">
        {situaties.map((x) => (
          <div class="a6-sitrow">
            <span class="a6-sitk">{x.s}</span>
            <span class="a6-sitv">{x.r}</span>
          </div>
        ))}
      </div>
      <p class="a6-fine">Vuistregels overal: dichtbij komen, alles handmatig vastzetten, zon in je rug, traag bewegen, en na afloop naspoelen met zoet water + de O-ring checken.</p>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  .a6-page { padding-top: 130px; padding-bottom: 96px; }
  .a6-head { max-width: 64ch; margin-bottom: 20px; }
  .a6-head h1 { margin: 10px 0 16px; }
  .a6-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .a6-rule { margin-top: 26px; }
  .a6-cheat { margin-top: 40px; }
  .a6-cheat h2, .a6-block h2 { margin: 8px 0 10px; }
  .a6-cheat .lb-lead, .a6-block .lb-lead { margin-bottom: 22px; }
  .a6-block { margin-top: 52px; max-width: 760px; }
  .a6-note { padding: 16px 18px; border-left: 3px solid var(--lb-sky); border-radius: 0 12px 12px 0; background: var(--lb-glass-card-bg); color: var(--lb-bone); line-height: 1.6; }
  .a6-sit { display: flex; flex-direction: column; gap: 10px; }
  .a6-sitrow { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 14px 16px; border-radius: 12px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); }
  @media (max-width: 640px) { .a6-sitrow { grid-template-columns: 1fr; gap: 4px; } }
  .a6-sitk { font-weight: 600; color: var(--lb-bone); }
  .a6-sitv { color: var(--lb-mist); font-size: .96rem; line-height: 1.55; }
  .a6-fine { margin-top: 16px; color: var(--lb-mist); font-size: .9rem; }
  .a6-wide { max-width: 980px; }
  .a6-h3 { font-size: 1.05rem; color: var(--lb-bone); margin: 24px 0 8px; }
  .a6-basis { padding: 16px 18px; border-left: 3px solid var(--lb-sky); border-radius: 0 12px 12px 0; background: var(--lb-glass-card-bg); color: var(--lb-bone); }
  .a6-basis ul { margin: 8px 0 0; padding-left: 1.1rem; }
  .a6-basis li { margin: 4px 0; color: var(--lb-mist); line-height: 1.5; }
  .a6-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--lb-glass-border); border-radius: 12px; margin: 6px 0 4px; }
  .a6-tbl { width: 100%; border-collapse: collapse; min-width: 760px; font-size: .92rem; }
  .a6-tbl th, .a6-tbl td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--lb-glass-border); vertical-align: top; }
  .a6-tbl th { color: var(--lb-bone); font-weight: 600; background: var(--lb-glass-card-bg); white-space: nowrap; }
  .a6-tbl td { color: var(--lb-mist); }
  .a6-tbl tbody tr td:first-child { color: var(--lb-bone); font-weight: 600; }
  .a6-tbl tbody tr:last-child td { border-bottom: 0; }
</style>
