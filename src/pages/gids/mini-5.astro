---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import SpectrumRule from '../../components/SpectrumRule.astro';
import VeldkaartMini from '../../components/veldkaart/VeldkaartMini.astro';

const jsonld = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: 'DJI Mini 5 Pro — cinematic settings & veldkaart',
  inLanguage: 'nl-NL', url: 'https://www.lichtbreking.nl/gids/mini-5/',
};
---
<Base
  title="DJI Mini 5 Pro: cinematic settings — de veldkaart"
  description="De complete veldkaart voor de DJI Mini 5 Pro: instel-ritueel, ND-keuze, per scène de beste instellingen in Normaal en PRO, plus hyperlapse, panorama en foto. Print-klaar als PDF."
  path="/gids/mini-5/" image="/img/og-art-dji-mini-5-pro-instellingen.png"
  hasEn={true}
  jsonld={jsonld}>
  <GlassNav active="" hasEn={true} switchHref="/en/gids/mini-5/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container m5-page">
    <header class="m5-head lb-reveal">
      <span class="lb-label lb-label--sky">Gids · DJI Mini 5 Pro</span>
      <h1 class="lb-display-l">Mini 5 Pro: traag vliegen, vast belichten</h1>
      <p class="lb-lead">De veldkaart voor cinematische dronebeelden: het instel-ritueel, de ND-keuze en per scène de beste instellingen — in Normaal én PRO. De drone heeft geen presets, maar DJI Fly onthoudt je instellingen; per vlucht raak je alleen ND, witbalans en ISO aan.</p>
      <div class="m5-cta">
        <a href="/downloads/veldkaart-mini-5-pro.pdf" class="lb-btn" download>Veldkaart (PDF, print-klaar) ↓</a>
        <a href="/cursus/vluchtfilmer/" class="lb-btn lb-btn--ghost">Naar de cursus De Vluchtfilmer →</a>
        <a href="/artikelen/dji-mini-5-pro-instellingen/" class="lb-btn lb-btn--ghost">Instellingen-artikel</a>
      </div>
      <div class="m5-rule"><SpectrumRule width="160px" thickness={3} /></div>
    </header>

    <section class="m5-block lb-reveal">
      <span class="lb-label lb-label--sky">Veldkaart · Curaçao-editie</span>
      <h2 class="lb-display-m">Instellen in 30 seconden</h2>
      <p class="lb-lead">Voor op je telefoon, of geprint in de dronetas. Vliegen doe je in Cine-modus; de rest staat hieronder.</p>
      <VeldkaartMini />
    </section>

    <section class="m5-block lb-reveal">
      <span class="lb-label lb-label--sky">Verder leren</span>
      <h2 class="lb-display-m">Van instellingen naar beelden</h2>
      <p class="lb-lead">De instellingen zijn het halve werk; beweging is de andere helft. De zeven cinematische dronebewegingen en de besturingsinstellingen voor vloeiender vliegen staan in de artikelen, en stap voor stap in de gratis cursus De Vluchtfilmer.</p>
      <div class="m5-cta">
        <a href="/artikelen/mini-5-pro-cinematische-bewegingen/" class="lb-btn lb-btn--ghost">De 7 cinematische bewegingen →</a>
        <a href="/artikelen/cinematische-besturing-veiligheid-mini-5-pro/" class="lb-btn lb-btn--ghost">Vloeiender vliegen →</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  .m5-page { padding-top: 130px; padding-bottom: 96px; }
  .m5-head { max-width: 64ch; margin-bottom: 20px; }
  .m5-head h1 { margin: 10px 0 16px; }
  .m5-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .m5-rule { margin-top: 26px; }
  .m5-block { margin-top: 52px; max-width: 900px; }
  .m5-block h2 { margin: 8px 0 10px; }
  .m5-block .lb-lead { margin-bottom: 22px; }
</style>
