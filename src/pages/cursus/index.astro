---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const modules = [
  { n: '01', t: 'Ken je toestel', d: 'Knop voor knop, zonder te kijken.' },
  { n: '02', t: 'Je eerste vlucht', d: 'Opstijgen, zweven, landen — met vertrouwen.' },
  { n: '03', t: 'Veiligheid & RTH', d: 'De instellingen die je drone redden.' },
  { n: '04', t: 'Alle instellingen', d: 'Camera, drone en controller compleet.' },
  { n: '05', t: 'Camera diep', d: 'Film en foto, per lichtsituatie.' },
  { n: '06', t: 'Cinematische moves', d: 'Push-in, orbit, reveal, parallax.' },
  { n: '07', t: 'Slimme modi', d: 'De drone vliegt voor je.' },
  { n: '08', t: 'Weinig licht & hyperlapse', d: 'Blauwe uur en tijd door beweging.' },
  { n: '09', t: 'Licht plannen', d: 'De zon als je hoofdgereedschap.' },
  { n: '10', t: 'Compositie & diepte', d: 'Lagen, lijnen, en het kader.' },
  { n: '11', t: 'Denk als filmmaker', d: 'Verhaal, ritme en spanning.' },
  { n: '12', t: 'Het onverwachte', d: 'Rustig blijven als het misgaat.' },
  { n: '13', t: 'Monteren', d: 'Van losse clips naar één film.' },
  { n: '14', t: 'Kleur & LUTs', d: 'Van vakantie naar cinematisch.' },
  { n: '15', t: 'Op locatie', d: 'Reisklaar, regels en de beste spots.' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'De Vluchtfilmer',
  description: 'Leer je DJI-drone filmen, niet alleen vliegen. Vijftien modules van eerste opstart tot afgemonteerde cinematische film.',
  inLanguage: 'nl-NL',
  url: 'https://www.lichtbreking.nl/cursus/',
  provider: { '@type': 'Person', name: 'Lichtbreking', url: 'https://www.lichtbreking.nl/' },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT15H',
  },
  isAccessibleForFree: true,
};
---
<Base
  title="De Vluchtfilmer — gratis drone-cursus | Lichtbreking"
  description="Leer je DJI-drone filmen, niet alleen vliegen. Vijftien modules van eerste opstart tot afgemonteerde cinematische film — gratis."
  path="/cursus/"
  jsonld={jsonld}
>
  <Nav active="cursus" />

  <main class="course">
    <section class="c-hero">
      <div class="c-prism" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow reveal">De Vluchtfilmer · gratis cursus</p>
        <h1 class="display reveal">Leer je drone<br><span class="refract">filmen</span>.</h1>
        <p class="lead reveal">
          Van uitpakken tot afgemonteerde film. Vijftien modules, vijfentwintig shot-recepten,
          beslisbomen en een complete veldgids — alles wat je nodig hebt om cinematische beelden te maken.
        </p>
        <div class="reveal" style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem">
          <a href="/cursus/vluchtfilmer/" class="btn btn-primary">Open de cursus</a>
          <a href="#inhoud" class="btn btn-glass">Bekijk de inhoud</a>
        </div>
      </div>
    </section>

    <section id="inhoud" class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Vijftien modules</p>
        <h2>Wat je leert</h2>
      </div>
      <div class="mod-grid">
        {modules.map((m) => (
          <a href="/cursus/vluchtfilmer/" class="mod glass reveal">
            <span class="mod-n">{m.n}</span>
            <span class="mod-t">{m.t}</span>
            <span class="mod-d">{m.d}</span>
          </a>
        ))}
      </div>
      <div class="reveal" style="text-align:center;margin-top:3rem">
        <a href="/cursus/vluchtfilmer/" class="btn btn-primary">Start nu →</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .c-hero { position: relative; padding-top: 9rem; padding-bottom: 2rem; overflow: hidden; }
  .c-prism {
    position: absolute; top: -20%; right: -10%; width: 55%; height: 80%;
    background: var(--spectrum); filter: blur(100px); opacity: .2;
    border-radius: 50%; mix-blend-mode: screen;
  }
  .c-hero .display { margin: 1.2rem 0 1.4rem; }
  .mod-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .mod {
    display: flex; flex-direction: column; gap: .35rem;
    padding: 1.4rem 1.5rem; border-radius: var(--r);
    transition: transform .35s var(--ease);
  }
  .mod:hover { transform: translateY(-3px); }
  .mod-n { font-family: var(--mono); font-size: .8rem; color: var(--ink-dim); letter-spacing: .1em; }
  .mod-t { font-weight: 600; font-size: 1.08rem; color: var(--on-glass); }
  .mod-d { font-size: .92rem; color: var(--on-glass-dim); }
  @media (max-width: 820px) { .mod-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .mod-grid { grid-template-columns: 1fr; } }
</style>
