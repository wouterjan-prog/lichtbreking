---
/* Oude cursus-landing is verhuisd naar /cursussen/. Redirect behoudt inkomende links. */
const dest = '/cursussen/';
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={`https://www.lichtbreking.nl${dest}`} />
  <meta name="robots" content="noindex, follow" />
  <title>Verhuisd naar Cursussen · Lichtbreking</title>
</head>
<body style="background:#08080A;color:#F4F3EF;font-family:-apple-system,system-ui,sans-serif;display:grid;place-items:center;min-height:100vh">
  <p>Doorsturen naar <a href={dest} style="color:#7FB4D6">cursussen</a>…</p>
</body>
</html>
