---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const courses = [
  {
    slug: '/cursus/vluchtfilmer/',
    kicker: 'Drone · DJI Mini 5 Pro',
    title: 'De Vluchtfilmer',
    tag: 'lucht',
    desc: 'Leer je drone filmen, niet alleen vliegen. Vijftien modules van uitpakken tot afgemonteerde cinematische film — met shot-recepten, beslisbomen en een complete veldgids.',
    points: ['15 modules + naslag', 'Van eerste vlucht tot kleurgrading', 'Shot-recepten & veldgids'],
    accent: 'teal',
  },
  {
    slug: '/cursus/grondfilmer/',
    kicker: 'Camera · DJI Osmo Pocket 4',
    title: 'De Grondfilmer',
    tag: 'grond',
    desc: 'De beelden op ooghoogte die je drone compleet maken. Twaalf modules over de Pocket 4 als grondcamera — en hoe je lucht en grond samensmelt tot één cinematische film.',
    points: ['12 modules + veldgids', 'Cinematische gimbal-techniek', 'Drone + Pocket matchen tot één film'],
    accent: 'olive',
  },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Cursussen — Lichtbreking',
  itemListElement: courses.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Course',
      name: c.title,
      description: c.desc,
      inLanguage: 'nl-NL',
      url: 'https://www.lichtbreking.nl' + c.slug,
      provider: { '@type': 'Person', name: 'Lichtbreking', url: 'https://www.lichtbreking.nl/' },
      isAccessibleForFree: true,
    },
  })),
};
---
<Base
  title="Cursussen — drone & camera filmen | Lichtbreking"
  description="Twee gratis cursussen: De Vluchtfilmer (DJI Mini 5 Pro drone) en De Grondfilmer (DJI Osmo Pocket 4). Leer cinematisch filmen vanuit de lucht én op de grond."
  path="/cursus/"
  jsonld={jsonld}
>
  <Nav active="cursus" />

  <main class="course">
    <section class="c-hero">
      <div class="c-prism" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow reveal">Twee gratis cursussen</p>
        <h1 class="display reveal">Leer licht<br><span class="refract">vastleggen</span>.</h1>
        <p class="lead reveal">
          Cinematisch filmen vanuit de lucht én op de grond. Kies je toestel — of volg ze allebei
          en leer hoe drone en camera samen één film vormen.
        </p>
      </div>
    </section>

    <section class="wrap">
      <div class="course-grid">
        {courses.map((c) => (
          <article class={`ccard reveal ${c.accent}`}>
            <div class="ccard-top">
              <span class="ccard-kicker">{c.kicker}</span>
              <h2 class="ccard-title">{c.title}</h2>
            </div>
            <p class="ccard-desc">{c.desc}</p>
            <ul class="ccard-points">
              {c.points.map((p) => <li>{p}</li>)}
            </ul>
            <a href={c.slug} class="btn btn-primary ccard-btn">Open de cursus →</a>
          </article>
        ))}
      </div>

      <div class="reveal combo-note">
        <p>
          <strong>Tip:</strong> de twee cursussen vullen elkaar aan. De drone geeft het epische overzicht,
          de Pocket 4 de intieme beelden op ooghoogte. De Grondfilmer leert je hoe je ze tot één geheel monteert.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .c-hero { position: relative; padding-top: 9rem; padding-bottom: 1rem; overflow: hidden; }
  .c-prism {
    position: absolute; top: -20%; right: -10%; width: 55%; height: 80%;
    background: var(--spectrum); filter: blur(100px); opacity: .2;
    pointer-events: none;
  }
  .course-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.6rem;
    margin-top: 1rem;
  }
  @media (max-width: 760px) { .course-grid { grid-template-columns: 1fr; } }

  .ccard {
    display: flex; flex-direction: column;
    padding: 2.2rem 2rem 2rem; border-radius: 20px;
    background: var(--bg-soft);
    border: 1px solid var(--hairline);
    position: relative; overflow: hidden;
  }
  .ccard::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  }
  .ccard.teal::before { background: linear-gradient(90deg, #2a8a99, #1f6f7a); }
  .ccard.olive::before { background: linear-gradient(90deg, #6b7340, #b06a1c); }

  .ccard-kicker {
    font-family: var(--mono, monospace); font-size: .72rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--ink-dim);
  }
  .ccard.teal .ccard-kicker { color: #4bb3c4; }
  .ccard.olive .ccard-kicker { color: #c08a3c; }
  /* Lichte modus: donkerdere accenten zodat de labels leesbaar blijven op de lichte kaart */
  :global(:root[data-theme="light"]) .ccard.teal .ccard-kicker,
  :global(:root[data-theme="light"]) .ccard.teal .ccard-points li::before { color: #146570; }
  :global(:root[data-theme="light"]) .ccard.olive .ccard-kicker,
  :global(:root[data-theme="light"]) .ccard.olive .ccard-points li::before { color: #8a5512; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .ccard.teal .ccard-kicker,
    :global(:root:not([data-theme])) .ccard.teal .ccard-points li::before { color: #146570; }
    :global(:root:not([data-theme])) .ccard.olive .ccard-kicker,
    :global(:root:not([data-theme])) .ccard.olive .ccard-points li::before { color: #8a5512; }
  }
  .ccard-title {
    font-family: var(--serif, var(--sans)); font-weight: 600;
    font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .4rem 0 0; letter-spacing: -.01em;
  }
  .ccard-desc { color: var(--ink-soft); margin: 1.2rem 0 1.4rem; line-height: 1.6; flex-grow: 0; }
  .ccard-points { list-style: none; margin: 0 0 1.8rem; padding: 0; }
  .ccard-points li {
    position: relative; padding-left: 1.5rem; margin-bottom: .6rem;
    color: var(--ink-soft); font-size: .95rem;
  }
  .ccard-points li::before {
    content: '✓'; position: absolute; left: 0; font-weight: 700;
  }
  .ccard.teal .ccard-points li::before { color: #2a8a99; }
  .ccard.olive .ccard-points li::before { color: #b06a1c; }
  .ccard-btn { margin-top: auto; align-self: flex-start; }

  .combo-note {
    margin: 2.6rem auto 0; max-width: 70ch; text-align: center;
    padding: 1.4rem 1.6rem; border-radius: 14px;
    background: var(--bg-soft);
    border: 1px solid var(--hairline);
  }
  .combo-note p { color: var(--ink-soft); margin: 0; line-height: 1.6; }
</style>
