---
import Base from '../../../layouts/Base.astro';
import GlassNav from '../../../components/GlassNav.astro';
import Footer from '../../../components/Footer.astro';
import SpectrumRule from '../../../components/SpectrumRule.astro';
import ProCheatsheet from '../../../components/ProCheatsheet.astro';
import GradeCompare from '../../../components/GradeCompare.astro';
import { courses, getLessons } from '../../../data/courses.js';
import '../../../styles/course.css';

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course } = Astro.props;
const cams = course.slug === 'grondfilmer' ? ['pocket'] : course.slug === 'kleurfilmer' ? ['mini', 'pocket'] : ['mini'];
const camLabel = cams.length > 1 ? 'de Mini 5 Pro én de Osmo Pocket 4' : cams[0] === 'pocket' ? 'de Osmo Pocket 4' : 'de Mini 5 Pro';
const lessons = getLessons(course);
const total = course.modules.length;
const hasCards = (course.naslag || []).some((r) => r.key === 'printkaarten');
const quickStart = (course.naslag || []).find((r) => r.key === 'starthier');

// groepeer modules per deel (in volgorde)
const parts = [];
for (const m of course.modules) {
  let p = parts.find((x) => x.title === m.part);
  if (!p) { p = { title: m.part, items: [] }; parts.push(p); }
  p.items.push(m);
}

const jsonld = {
  '@context': 'https://schema.org', '@type': 'Course', name: course.title, description: course.lead,
  inLanguage: 'nl-NL', url: `https://www.lichtbreking.nl/cursus/${course.slug}/`,
  provider: { '@type': 'Person', name: 'Lichtbreking', url: 'https://www.lichtbreking.nl/' }, isAccessibleForFree: true,
};
---
<Base title={course.title} description={course.lead} path={`/cursus/${course.slug}/`} image={`/img/og-${course.slug}.png`} jsonld={jsonld}>
  <GlassNav active="cursussen" switchHref="/en/cursussen/" />
  <main id="hoofdinhoud" tabindex="-1" class="cur" data-course={course.slug} data-key={course.storageKey} data-total={total}>
    <section class="cur-hero lb-container">
      <a href="/cursussen/" class="back lb-label">← Cursussen</a>
      <span class="lb-label lb-label--sky">{course.kicker}</span>
      <h1 class="lb-display-l">{course.title}</h1>
      <p class="lb-lead">{course.lead}</p>
      <div class="meta">
        {course.meta.map(([k, v]) => <div class="meta__row"><span class="lb-label">{k}</span><span class="meta__v">{v}</span></div>)}
      </div>
      {quickStart && (
        <a href={`/cursus/${course.slug}/les/${quickStart.key}/`} class="quick-cta">
          <span class="quick-cta__tag">Weinig tijd?</span>
          <span class="quick-cta__txt">Begin hier — binnen 30 minuten je eerste shot</span>
          <span class="quick-cta__arrow">→</span>
        </a>
      )}
      <div class="prog">
        <div class="prog-track"><div class="prog-fill" id="progFill"></div></div>
        <span class="lb-label" id="progLabel">0 / {total}</span>
        <button class="reset" id="resetBtn" hidden>Reset</button>
      </div>
      <div class="cur-cta">
        <a href={`/cursus/${course.slug}/les/1/`} class="lb-btn" id="startBtn">Start de cursus</a>
        {hasCards && <a href={`/cursus/${course.slug}/les/printkaarten/`} class="lb-btn lb-btn--ghost">Print de veldkaarten</a>}
      </div>
      <div class="rule"><SpectrumRule width="160px" thickness={3} /></div>

      <div class="diploma" id="diploma" hidden>
        <span class="lb-label lb-label--sky">Diploma · {total} / {total} modules</span>
        <h2 class="lb-display-m">{course.title} — voltooid</h2>
        <p class="diploma__name" id="diplomaName">Jouw naam</p>
        <p class="lb-lead">Je hebt alle modules en kennischecks afgerond. Mooi werk — tijd om te vliegen.</p>
        <div class="diploma__row">
          <input type="text" id="diplomaInput" placeholder="Vul je naam in voor op het diploma" />
          <button class="lb-btn" id="diplomaPrint">Print / bewaar als PDF</button>
        </div>
      </div>
    </section>

    <section class="cur-body lb-container">
      <div class="intro course-body" set:html={course.intro} />

      <div class="modlist">
        {parts.map((p, pi) => (
          <div class="part">
            <div class="part-head"><span class="lb-label">{`Deel 0${pi + 1}`}</span><h2 class="lb-display-m">{p.title}</h2></div>
            {p.items.map((m) => (
              <a href={`/cursus/${course.slug}/les/${m.n}/`} class="row" data-n={m.n}>
                <span class="row-status" aria-hidden="true"></span>
                <span class="row-num lb-label">{String(m.n).padStart(2, '0')}</span>
                <span class="row-main">
                  <span class="row-title" set:html={m.title} />
                  <span class="row-tag lb-label">{m.tag}</span>
                </span>
                <span class="row-min lb-label">{m.min} min</span>
              </a>
            ))}
          </div>
        ))}
        {course.casestudy && course.casestudy.length > 0 && (
          <div class="part part--case">
            <div class="part-head"><span class="lb-label">Praktijkcase</span><h2 class="lb-display-m">Praktijkcase: Curaçao</h2><p class="part-intro">Een complete reis als voorbeeld — optioneel, los van de algemene cursus.</p></div>
            {course.casestudy.map((r) => (
              <a href={`/cursus/${course.slug}/les/${r.key}/`} class="row" data-n={r.key}>
                <span class="row-status" aria-hidden="true"></span>
                <span class="row-num lb-label">◆</span>
                <span class="row-main"><span class="row-title">{r.title}</span><span class="row-tag lb-label">De reis als voorbeeld</span></span>
                <span class="row-min lb-label">{r.min} min</span>
              </a>
            ))}
          </div>
        )}
        {course.naslag && course.naslag.length > 0 && (
          <div class="part">
            <div class="part-head"><span class="lb-label">Naslag</span><h2 class="lb-display-m">Naslag &amp; veldgids</h2></div>
            {course.naslag.map((r) => (
              <a href={`/cursus/${course.slug}/les/${r.key}/`} class="row" data-n={r.key}>
                <span class="row-status" aria-hidden="true"></span>
                <span class="row-num lb-label">★</span>
                <span class="row-main"><span class="row-title">{r.title}</span><span class="row-tag lb-label">Naslag om op te zoeken</span></span>
                <span class="row-min lb-label">{r.min} min</span>
              </a>
            ))}
          </div>
        )}
      </div>

      {course.slug !== 'actiefilmer' && (
      <div class="cur-cheat">
        <span class="lb-label lb-label--sky">Veldkaart</span>
        <h2 class="lb-display-m">Pro-instellingen in één oogopslag</h2>
        <p class="lb-lead">De handmatige instellingen voor {camLabel} — met per instelling de waarde én het waarom.{course.slug === 'kleurfilmer' ? ' Beide camera’s filmen een vlak 10-bit log-profiel (D-Log M op de Mini, echte D-Log op de Pocket 4), dus de grade-workflow in deze cursus geldt voor allebei.' : ' Print de veldkaarten hierboven om ze mee te nemen.'}</p>
        <ProCheatsheet cams={cams} />
        {course.slug === 'kleurfilmer' && <GradeCompare caption="Sleep om te zien wat een grade doet: links plat D-Log M uit de camera, rechts de cinematische look die je in deze cursus leert maken." />}
      </div>
      )}
    </section>
  </main>
  <Footer />
</Base>

<style>
  .cur-hero { padding-top: 120px; padding-bottom: 10px; }
  .cur-cheat { margin-top: 48px; }
  .cur-cheat h2 { margin: 8px 0 12px; }
  .cur-cheat .lb-lead { margin-bottom: 22px; }
  .back { display: inline-block; color: var(--lb-mist); margin-bottom: 22px; }
  .back:hover { color: var(--lb-bone); }
  .cur-hero h1 { margin: 10px 0 16px; }
  .meta { display: flex; flex-wrap: wrap; gap: 14px 40px; margin: 26px 0 0; }
  .meta__row { display: flex; flex-direction: column; gap: 4px; }
  .meta__v { color: var(--lb-bone); }
  .quick-cta { display: inline-flex; align-items: center; gap: 12px; margin: 26px 0 4px; padding: 12px 18px; border-radius: var(--lb-r-pill); border: 1px solid var(--lb-sky); background: rgba(127,180,214,.08); color: var(--lb-bone); transition: background var(--lb-dur) var(--lb-ease), transform var(--lb-dur) var(--lb-ease); }
  .quick-cta:hover { background: rgba(127,180,214,.16); transform: translateY(-1px); }
  .quick-cta__tag { font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-sky); }
  .quick-cta__txt { font-size: .95rem; }
  .quick-cta__arrow { color: var(--lb-sky); }
  @media (max-width: 560px) { .quick-cta { flex-wrap: wrap; } }
  .prog { display: flex; align-items: center; gap: 14px; margin: 30px 0 24px; max-width: 460px; }
  .prog-track { flex: 1; height: 6px; background: var(--lb-line); border-radius: 6px; overflow: hidden; }
  .prog-fill { height: 100%; width: 0; border-radius: 6px; background: var(--lb-spectrum); transition: width .5s var(--lb-ease); }
  .reset { font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--lb-mist); background: none; border: 1px solid var(--lb-line); border-radius: 20px; padding: 5px 12px; cursor: pointer; }
  .reset:hover { color: var(--lb-bone); }
  .cur-cta { margin-bottom: 6px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .rule { margin-top: 30px; }
  .diploma { margin-top: 34px; padding: 1.8rem 2rem; border: 2px solid var(--lb-orange); border-radius: 16px; background: rgba(255,154,46,.05); max-width: 560px; }
  .diploma h2 { margin: 8px 0 6px; }
  .diploma__name { font-family: var(--lb-font-display); font-size: 1.5rem; color: var(--lb-bone); margin: 6px 0 10px; }
  .diploma__row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 18px; }
  .diploma__row input { flex: 1; min-width: 200px; background: var(--lb-ink); border: 1px solid var(--lb-line); color: var(--lb-bone); border-radius: 10px; padding: .7rem .9rem; font-size: .95rem; }

  .cur-body { padding-top: 40px; padding-bottom: 100px; display: grid; grid-template-columns: 1fr; gap: 10px; }
  .intro { max-width: 70ch; margin-bottom: 30px; }
  .modlist { display: flex; flex-direction: column; gap: 40px; }
  .part-head { margin-bottom: 14px; }
  .part-head h2 { margin-top: 6px; }
  .part-intro { color: var(--lb-mist); margin-top: 8px; max-width: 60ch; }
  .row {
    display: grid; grid-template-columns: 22px 34px 1fr auto; align-items: center; gap: 16px;
    padding: 16px 4px; border-bottom: 1px solid var(--lb-line); transition: background .25s var(--lb-ease);
  }
  .row:hover { background: var(--lb-ink); }
  .row-status { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--lb-line); }
  .row.done .row-status { background: var(--lb-green); border-color: var(--lb-green); }
  .row.current .row-status { border-color: var(--lb-sky); box-shadow: inset 0 0 0 3px var(--lb-sky); }
  .row-num { color: var(--lb-mist); }
  .row-main { display: flex; flex-direction: column; gap: 3px; }
  .row-title { color: var(--lb-bone); font-size: 1.05rem; }
  .row-tag { color: var(--lb-mist); }
  .row-min { color: var(--lb-mist); white-space: nowrap; }
  @media (max-width: 560px) { .row { grid-template-columns: 18px 28px 1fr; } .row-min { display: none; } }
</style>

<script is:inline>
  (function () {
    var main = document.querySelector('.cur'); if (!main) return;
    var key = main.getAttribute('data-key');
    var total = parseInt(main.getAttribute('data-total'), 10);
    var done = [];
    try { done = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) {}
    var rows = main.querySelectorAll('.row');
    var firstUndone = null;
    rows.forEach(function (r) {
      var n = r.getAttribute('data-n');
      if (done.indexOf(n) !== -1) r.classList.add('done');
      else if (!firstUndone && /^\d+$/.test(n)) firstUndone = n;
    });
    var moduleDone = done.filter(function (x) { return /^\d+$/.test(x); }).length;
    var pct = total ? Math.round(moduleDone / total * 100) : 0;
    var fill = document.getElementById('progFill'); if (fill) fill.style.width = pct + '%';
    var label = document.getElementById('progLabel'); if (label) label.textContent = moduleDone + ' / ' + total;
    var start = document.getElementById('startBtn');
    if (start) {
      if (firstUndone && moduleDone > 0) { start.textContent = 'Hervat — les ' + firstUndone; start.href = start.href.replace(/les\/\d+\//, 'les/' + firstUndone + '/'); }
      else if (moduleDone >= total) { start.textContent = 'Opnieuw bekijken'; }
    }
    if (moduleDone > 0) {
      // markeer huidige (eerste onafgeronde)
      if (firstUndone) { var cr = main.querySelector('.row[data-n="' + firstUndone + '"]'); if (cr) cr.classList.add('current'); }
      var rb = document.getElementById('resetBtn');
      if (rb) { rb.hidden = false; rb.addEventListener('click', function () { localStorage.removeItem(key); location.reload(); }); }
    }
    var dip = document.getElementById('diploma');
    if (dip && total > 0 && moduleDone >= total) {
      dip.hidden = false;
      var nm = document.getElementById('diplomaName'), inp = document.getElementById('diplomaInput');
      var saved = ''; try { saved = localStorage.getItem(key + ':name') || ''; } catch (e) {}
      if (saved) { nm.textContent = saved; inp.value = saved; }
      inp.addEventListener('input', function () { var v = inp.value.trim(); nm.textContent = v || 'Jouw naam'; try { localStorage.setItem(key + ':name', v); } catch (e) {} });
      var pb = document.getElementById('diplomaPrint');
      if (pb) pb.addEventListener('click', function () { document.body.classList.add('print-diploma'); window.print(); setTimeout(function () { document.body.classList.remove('print-diploma'); }, 600); });
    }
  })();
</script>
