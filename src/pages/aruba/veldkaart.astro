---
// A4 print-/PDF-veldkaart van de Aruba-gids — alle spots, coördinaten, type, beste move & licht.
import { arubaSpots } from '../../data/arubaspots.js';
const groups = [
  { t: 'fly', label: 'Drone-top — go (met DCAA-toestemming)', color: '#1f8a3b' },
  { t: 'care', label: 'Met beleid', color: '#b86a12' },
  { t: 'no', label: 'No-fly — film met de Pocket', color: '#c0392b' },
  { t: 'pocket', label: 'Pocket 4 — vanaf de grond', color: '#6b32a8' },
];
const coord = (ll) => `${ll[0].toFixed(4)}, ${ll[1].toFixed(4)}`;
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Aruba — veldkaart (A4 / PDF)</title>
<meta name="robots" content="noindex" />
<style is:global>
  :root{ --ink:#13171c; --mut:#5c636b; --line:#d9dde2; --gold:#9a6b12; --spectrum:linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB);
    --mono:ui-monospace,"SF Mono",Menlo,monospace; --text:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; }
  *{ box-sizing:border-box }
  body{ margin:0; background:#e9ebee; color:var(--ink); font-family:var(--text); line-height:1.45; }
  .bar{ position:sticky; top:0; z-index:20; display:flex; gap:12px; align-items:center; justify-content:center; flex-wrap:wrap; padding:14px; background:#0b0f13; color:#fff; }
  .bar p{ margin:0; font-size:13px; color:#c7ccd2; max-width:46ch; text-align:center; }
  .btn{ appearance:none; border:0; cursor:pointer; font-weight:600; font-size:14px; padding:.65rem 1.1rem; border-radius:8px; color:#06231f; background:#E7C98F; text-decoration:none; }
  .btn.ghost{ color:#fff; background:rgba(255,255,255,.12); }
  .sheet{ width:210mm; min-height:297mm; margin:22px auto; background:#fff; padding:16mm 15mm; box-shadow:0 18px 50px rgba(0,0,0,.25); }
  .top{ display:flex; justify-content:space-between; align-items:flex-end; border-bottom:2px solid var(--ink); padding-bottom:10px; }
  .kick{ font-family:var(--mono); letter-spacing:.18em; text-transform:uppercase; font-size:10px; color:var(--gold); }
  h1{ font-size:30px; font-weight:800; text-transform:uppercase; margin:4px 0 0; letter-spacing:-.01em; }
  .top .meta{ text-align:right; font-size:11px; color:var(--mut); }
  .rule{ height:3px; background:var(--spectrum); border-radius:2px; margin:0 0 14px; }
  .settings{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin:14px 0 18px; }
  .box{ border:1px solid var(--line); border-radius:10px; padding:12px 14px; }
  .box h2{ font-size:12px; text-transform:uppercase; letter-spacing:.06em; margin:0 0 8px; color:var(--gold); }
  .nd{ display:flex; justify-content:space-between; font-size:12.5px; padding:3px 0; border-bottom:1px dotted var(--line); }
  .nd:last-child{ border-bottom:0; } .nd b{ font-family:var(--mono); }
  .pro{ font-size:12px; } .pro span{ display:inline-block; margin:2px 8px 2px 0; } .pro b{ font-family:var(--mono); color:var(--gold); }
  .grp{ margin-top:14px; break-inside:avoid; }
  .grp h2{ font-size:13px; text-transform:uppercase; letter-spacing:.05em; margin:0 0 6px; display:flex; align-items:center; gap:8px; }
  .grp h2 i{ width:10px; height:10px; border-radius:50%; display:inline-block; }
  table{ width:100%; border-collapse:collapse; font-size:11.5px; }
  th{ text-align:left; font-size:9.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--mut); border-bottom:1px solid var(--line); padding:4px 6px; }
  td{ padding:5px 6px; border-bottom:1px solid #eef1f3; vertical-align:top; }
  td.nm{ font-weight:600; width:30%; }
  td.co{ font-family:var(--mono); color:var(--mut); white-space:nowrap; }
  .foot{ margin-top:18px; padding-top:10px; border-top:1px solid var(--line); font-size:10px; color:var(--mut); }
  .foot b{ color:var(--ink); }
  @media print{
    @page{ size:A4 portrait; margin:0; }
    body{ background:#fff; } .bar{ display:none !important; }
    .sheet{ width:auto; min-height:auto; margin:0; box-shadow:none; padding:12mm 12mm; }
    *{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  }
</style>
</head>
<body>
  <div class="bar">
    <p>Print of bewaar als PDF (A4) om mee te nemen — coördinaten, type en de beste move per spot.</p>
    <button class="btn" id="dl">Download als PDF</button>
    <a class="btn ghost" href="/aruba/">← Terug naar de gids</a>
  </div>

  <div class="sheet">
    <div class="top">
      <div><span class="kick">lichtbreking · veldkaart</span><h1>Drone op Aruba</h1></div>
      <div class="meta">{arubaSpots.length} spots · lichtbreking.nl/aruba</div>
    </div>
    <div class="rule"></div>

    <div class="settings">
      <div class="box">
        <h2>ND-filter (houd 1/50 s)</h2>
        <div class="nd"><span>Bewolkt</span><b>ND8</b></div>
        <div class="nd"><span>Zonnig</span><b>ND16</b></div>
        <div class="nd"><span>Felle middagzon</span><b>ND32</b></div>
        <div class="nd"><span>Wit zand / spiegelend water</span><b>ND64</b></div>
      </div>
      <div class="box">
        <h2>Pro-instellingen</h2>
        <div class="pro">
          <span><b>4K</b> resolutie</span><span><b>24–30</b> fps</span><span><b>1/50</b> sluiter</span>
          <span><b>100</b> ISO</span><span><b>5500K</b> witbalans vast</span><span><b>Normal</b> kleurprofiel</span><span><b>−1</b> scherpte</span>
        </div>
      </div>
    </div>

    {groups.map((g) => (
      <div class="grp">
        <h2><i style={`background:${g.color}`}></i>{g.label}</h2>
        <table>
          <thead><tr><th>Spot</th><th>Coördinaten</th><th>Beste move</th><th>Beste licht</th></tr></thead>
          <tbody>
            {arubaSpots.filter((s) => s.t === g.t).map((s) => (
              <tr><td class="nm">{s.n}</td><td class="co">{coord(s.ll)}</td><td>{s.move}</td><td>{s.light}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}

    <div class="foot">
      <b>Regels:</b> vraag vooraf DCAA-toestemming (e-mail, minstens 1 dag eerder) · lokaal mobiel nummer · max 120 m · zicht (VLOS) · niet bij luchthaven, cruise-haven Oranjestad of Arikok National Park. Regelgeving kan wijzigen — bevestig altijd bij de DCAA. Coördinaten zijn benaderingen. © lichtbreking.nl
    </div>
  </div>

  <script is:inline>
    document.getElementById('dl').addEventListener('click', function(){
      try{ if(window.va) window.va('event',{name:'print_veldkaart',page:'aruba'}); }catch(e){}
      window.print();
    });
  </script>
</body>
</html>
