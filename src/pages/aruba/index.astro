---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { arubaSpots } from '../../data/arubaspots.js';
---
<Base
  title="Drone op Aruba — de gids"
  description="De complete gids voor dronevliegen en filmen op Aruba: de mooiste spots op een exacte kaart met filters, de DCAA-toestemming die je vooraf regelt, no-fly-zones en de beste instellingen en moves."
  path="/aruba/">
  <GlassNav active="" switchHref="/en/cursussen/" hero />

  <main id="hoofdinhoud" tabindex="-1" class="ar-page">

    <!-- COVER -->
    <section class="ar-cover">
      <div class="ar-bg"></div><div class="ar-scrim"></div>
      <svg class="ar-dronefly" width="86" height="44" viewBox="0 0 92 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <ellipse cx="18" cy="12" rx="13" ry="3.4" opacity=".85"/><ellipse cx="74" cy="12" rx="13" ry="3.4" opacity=".85"/>
        <line x1="18" y1="14" x2="34" y2="26"/><line x1="74" y1="14" x2="58" y2="26"/><rect x="34" y="24" width="24" height="12" rx="4"/><circle cx="46" cy="30" r="2.2" fill="#fff" stroke="none"/>
      </svg>
      <div class="ar-cover-in">
        <span class="ar-kick">De complete gids · lichtbreking</span>
        <h1 class="ar-h1"><span>Drone op</span><span>Aruba</span></h1>
        <div class="ar-rule"></div>
        <div class="ar-meta"><span><b>11</b> drone-spots</span><span><b>2</b> Pocket 4-spots</span><span><b>2</b> no-fly</span><span>vooraf <b>DCAA-toestemming</b></span></div>
      </div>
    </section>

    <!-- REGELS -->
    <section class="ar-sec ar-rules"><div class="ar-wrap">
      <span class="ar-kick">Voor je vliegt</span>
      <h2 class="ar-h2">De regels — kort</h2>
      <div class="ar-rgrid">
        <div class="ar-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg><b>DCAA vooraf</b><span>toestemming per e-mail</span></div>
        <div class="ar-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20V8M12 8l-4 4M12 8l4 4M4 4h16"/></svg><b>Max 120 m</b><span>hoogte</span></div>
        <div class="ar-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg><b>Zicht (VLOS)</b><span>overdag</span></div>
        <div class="ar-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 22s4-2 10-2 10 2 10 2"/><path d="M12 2v12"/><path d="m8 8 4-4 4 4"/></svg><b>Niet bij Arikok</b><span>natuurpark = verboden</span></div>
      </div>
      <div class="ar-reg"><b>Let op:</b> recreatief vliegen mag op Aruba, maar je vraagt vooraf toestemming aan de DCAA en blijft weg van de luchthaven, de cruise-haven in Oranjestad en het Arikok National Park. Bevestig de actuele regels altijd bij de DCAA vóór je vliegt.</div>
    </div></section>

    <!-- MAP -->
    <section class="ar-sec ar-map-sec"><div class="ar-wrap">
      <span class="ar-kick">Aruba · de kaart</span>
      <h2 class="ar-h2">Waar vlieg &amp; film je?</h2>
      <div class="ar-legend">
        <span><i style="background:#46C95F"></i>Drone-top</span>
        <span><i style="background:#FF9A2E"></i>Met beleid</span>
        <span><i style="background:#FF6B5E"></i>No-fly</span>
        <span><i class="sq" style="background:#9B4DDB"></i>Pocket 4 (grond)</span>
        <span class="ar-legend-hint">klik of beweeg over een marker</span>
      </div>
      <div class="ar-filters" id="arFilters">
        <button class="ar-fbtn on" data-f="all" type="button">Alles</button>
        <button class="ar-fbtn" data-f="fly" type="button">Drone-top</button>
        <button class="ar-fbtn" data-f="care" type="button">Met beleid</button>
        <button class="ar-fbtn" data-f="no" type="button">No-fly</button>
        <button class="ar-fbtn" data-f="pocket" type="button">Pocket 4</button>
        <input class="ar-search" id="arSearch" type="search" placeholder="Zoek een spot…" aria-label="Zoek een spot" autocomplete="off" />
      </div>
      <div class="ar-stage">
        <div class="ar-mapbox"><div id="arMap"></div></div>
        <div class="ar-panel">
          <div class="ar-ph empty" id="arPh"><span>Kies een spot op de kaart<br>voor een beeld &amp; tip</span></div>
          <div class="ar-pbody" id="arPbody" style="display:none"><span class="ar-badge" id="arBadge"></span><h3 id="arPname"></h3><p id="arPtip"></p><div class="ar-chips" id="arChips"></div></div>
        </div>
      </div>
      <p class="ar-mapnote">Kaartdata © OpenStreetMap-bijdragers, tegels © CARTO. Markers staan op hun werkelijke GPS-coördinaten (benaderingen voor navigatie).</p>
    </div></section>

    <!-- VOORAF -->
    <section class="ar-sec"><div class="ar-wrap">
      <span class="ar-kick">Voor vertrek</span>
      <h2 class="ar-h2">Zo regel je de toestemming</h2>
      <p class="ar-lead">Aruba werkt met voorafgaande toestemming van de luchtvaartautoriteit (DCAA). Regel dit ruim op tijd, dan kun je daar zonder zorgen vliegen.</p>
      <ol class="ar-steps">
        <li><span class="ar-stepn">1</span><div><b>Mail de DCAA vooraf</b><p>Vraag minstens één dag van tevoren per e-mail toestemming aan voor je geplande vlucht(en), met datum, locatie en tijd.</p></div></li>
        <li><span class="ar-stepn">2</span><div><b>Zorg voor een lokaal mobiel nummer</b><p>De verkeerstoren wil je tijdens je vlucht kunnen bereiken op een Arubaans mobiel nummer — een buitenlands of vast nummer volstaat niet.</p></div></li>
        <li><span class="ar-stepn">3</span><div><b>Blijf uit de gevoelige zones</b><p>Geen vluchten bij de luchthaven, heliports of de cruise-haven van Oranjestad, en niet in het Arikok National Park.</p></div></li>
        <li><span class="ar-stepn">4</span><div><b>Vlieg verantwoord</b><p>Overdag, binnen zicht, onder 120 m, niet boven mensen, voertuigen of menigtes, en met respect voor privacy bij hotels, villa’s en stranden.</p></div></li>
      </ol>
      <p class="ar-fineprint">Regelgeving kan wijzigen — bevestig de actuele eisen en het juiste e-mailadres altijd bij de DCAA vóór je reist. Dit is informatief, geen officieel advies.</p>
    </div></section>

    <!-- INSTELLINGEN-LINK -->
    <section class="ar-sec"><div class="ar-wrap ar-settings">
      <span class="ar-kick">Instellingen &amp; techniek</span>
      <h2 class="ar-h2">Fel licht, wit zand — zelfde recept</h2>
      <p class="ar-lead">Het felle Caribische licht vraagt om een ND-filter zodat je op 1/50 s blijft, witbalans handmatig vast (~5500 K) en scherpte op −1. De complete cheatsheet en rekenhulpen staan al klaar.</p>
      <div class="ar-cta">
        <a class="ar-btn" href="/gereedschap/">ND-calculator &amp; Pro-cheatsheet →</a>
        <a class="ar-btn ar-btn--ghost" href="/aruba/veldkaart/">🗺️ Print-veldkaart (A4)</a>
        <a class="ar-btn ar-btn--ghost" href="/gouden-uur/">Plan het gouden uur</a>
      </div>
      <p class="ar-fineprint">Tip: de zustereilanden verschillen sterk. Op <a href="/curacao/">Curaçao</a> mag je na registratie zelf vliegen; <b>Bonaire</b> is voor recreatieve drones vrijwel volledig verboden (het hele eiland is beschermd natuurgebied) — daar film je het beste vanaf de grond met de Pocket 4.</p>
    </div></section>

    <!-- SOURCES -->
    <section class="ar-sec ar-close"><div class="ar-wrap">
      <span class="ar-kick">lichtbreking</span>
      <h2 class="ar-h2">Vlieg veilig. Film cinematisch.</h2>
      <p class="ar-disc">Met zorg samengesteld op basis van openbare bronnen (juni 2026). Regelgeving op Aruba kan wijzigen — bevestig de actuele regels, no-fly-zones en de DCAA-procedure altijd vóór je vliegt.</p>
      <p class="ar-src">Bronnen: Aruba Department of Civil Aviation (DCAA) · openbare drone-regelgevingsoverzichten.</p>
    </div></section>

  </main>
  <Footer />
</Base>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style is:global>
  .ar-page{ --night:#08080A; --bone:#F4F1EA; --mist:#AEB0B6; --gold:#E7C98F;
    --green:#46C95F; --orange:#FF9A2E; --red:#FF6B5E; --teal:#2FB8C4; --sky:#7FB2FF;
    --spectrum:linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB);
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
    background:var(--night); color:var(--bone); line-height:1.55; overflow-x:hidden; }
  .ar-page :is(h1,h2,h3){ font-family:var(--lb-font-display,inherit); }
  .ar-wrap{ max-width:1080px; margin:0 auto; padding:0 18px; }
  .ar-kick{ font-family:var(--mono); letter-spacing:.22em; text-transform:uppercase; font-size:12px; color:var(--gold); }
  .ar-h2{ font-size:clamp(26px,4.4vw,42px); font-weight:800; text-transform:uppercase; letter-spacing:-.01em; margin:8px 0 6px; line-height:1; color:var(--bone); }
  .ar-lead{ color:var(--mist); font-size:14.5px; margin:0 0 22px; max-width:62ch; }
  .ar-sec{ position:relative; padding:46px 0; }

  .ar-cover{ position:relative; height:100vh; min-height:560px; overflow:hidden; }
  .ar-bg{ position:absolute; inset:-4%; background:url('https://images.unsplash.com/photo-1600582910964-5b7c109e6868?w=1900&q=78&auto=format&fit=crop') center/cover; animation:ar-ken 24s ease-in-out infinite alternate; }
  @keyframes ar-ken{0%{transform:scale(1.03)}100%{transform:scale(1.16) translate(-2%,-2%)}}
  .ar-scrim{ position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.5),rgba(0,0,0,.05) 30%,rgba(6,12,16,.95)); }
  .ar-cover-in{ position:relative; z-index:2; height:100%; display:flex; flex-direction:column; justify-content:flex-end; padding:0 clamp(20px,6vw,70px) clamp(40px,6vw,76px); }
  .ar-cover-in .ar-kick{ opacity:0; animation:ar-rise .9s .2s forwards; color:#ffe6b8; }
  .ar-h1{ font-size:clamp(48px,12vw,150px); line-height:.9; font-weight:800; text-transform:uppercase; letter-spacing:-.02em; margin:8px 0 4px; text-shadow:0 6px 50px rgba(0,0,0,.45); color:#fff; }
  .ar-h1 span{ display:block; opacity:0; animation:ar-rise 1s forwards; }
  .ar-h1 span:nth-child(1){ animation-delay:.35s } .ar-h1 span:nth-child(2){ animation-delay:.5s }
  .ar-rule{ height:3px; width:200px; border-radius:3px; background:var(--spectrum); transform-origin:left; transform:scaleX(0); animation:ar-grow 1.1s .6s forwards; margin:16px 0; }
  .ar-meta{ display:flex; gap:22px; flex-wrap:wrap; font-family:var(--mono); font-size:12.5px; color:#eaf1f4; opacity:0; animation:ar-rise 1s .85s forwards; }
  .ar-meta b{ color:var(--gold); }
  .ar-dronefly{ position:absolute; top:16%; right:11%; z-index:2; color:#fff; animation:ar-float 5s ease-in-out infinite; }
  @keyframes ar-float{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-16px) rotate(3deg)}}
  @keyframes ar-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  @keyframes ar-grow{to{transform:scaleX(1)}}

  .ar-rules{ padding-top:54px; }
  .ar-rgrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .ar-rc{ position:relative; background:rgba(20,22,28,.5); border-radius:14px; padding:16px; text-align:center; box-shadow:inset 0 1px 0 rgba(255,255,255,.12); }
  .ar-rc svg{ color:var(--gold); }
  .ar-rc b{ display:block; margin-top:8px; font-size:15px; }
  .ar-rc span{ font-size:12px; color:var(--mist); }
  .ar-reg{ margin-top:12px; border-radius:14px; padding:13px 16px; background:rgba(255,90,80,.12); border-left:4px solid var(--red); font-size:13.5px; }
  .ar-reg b{ color:#ffd2cd; }

  .ar-legend{ display:flex; gap:15px; font-size:12.5px; color:var(--mist); flex-wrap:wrap; align-items:center; margin:6px 0 14px; }
  .ar-legend i{ width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:5px; vertical-align:middle; }
  .ar-legend i.sq{ border-radius:4px; }
  .ar-legend-hint{ margin-left:auto; color:#7f8085; }
  .ar-filters{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:0 0 14px; }
  .ar-fbtn{ appearance:none; cursor:pointer; font-family:inherit; font-size:12.5px; font-weight:600; color:var(--bone); background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:7px 14px; }
  .ar-fbtn:hover{ background:rgba(255,255,255,.12); }
  .ar-fbtn.on{ color:#06231f; background:var(--gold); border-color:transparent; }
  .ar-search{ flex:1; min-width:160px; font-family:inherit; font-size:13px; color:var(--bone); background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:8px 14px; }
  .ar-search::placeholder{ color:var(--mist); } .ar-search:focus{ outline:none; border-color:var(--gold); }
  .ar-stage{ display:grid; grid-template-columns:1.7fr 1fr; gap:18px; align-items:stretch; }
  .ar-mapbox{ position:relative; }
  #arMap{ height:560px; border-radius:20px; overflow:hidden; background:#0b1a1f; box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 20px 50px rgba(0,0,0,.4); position:relative; z-index:1; }
  .ar-mapbox::after{ content:""; position:absolute; inset:0; border-radius:20px; padding:1.3px; background:var(--spectrum); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.4; pointer-events:none; z-index:500; }
  .ar-panel{ position:relative; border-radius:18px; overflow:hidden; min-height:400px; background:#0e1116; box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 16px 44px rgba(0,0,0,.34); display:flex; flex-direction:column; }
  .ar-ph{ position:relative; flex:1; background-size:cover; background-position:center; }
  .ar-ph::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent 38%,rgba(8,8,10,.86)); }
  .ar-ph.empty{ background:linear-gradient(135deg,#0c2d33,#103e3a); display:grid; place-items:center; }
  .ar-ph.empty span{ position:relative; z-index:2; color:var(--mist); font-size:13px; text-align:center; padding:0 22px; }
  .ar-pbody{ position:relative; z-index:2; padding:14px 16px 16px; margin-top:-86px; }
  .ar-badge{ display:inline-block; font-family:var(--mono); font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; padding:3px 9px; border-radius:20px; margin-bottom:7px; }
  .ar-badge.fly{ color:#bfeccf; background:rgba(70,201,95,.22) } .ar-badge.care{ color:#ffd9a8; background:rgba(255,154,46,.22) } .ar-badge.no{ color:#ffc7c1; background:rgba(255,90,80,.24) } .ar-badge.pocket{ color:#dcc0ff; background:rgba(155,77,219,.26) }
  .ar-pbody h3{ margin:0 0 4px; font-size:19px; color:var(--bone); }
  .ar-pbody p{ margin:0; color:#d7d6dc; font-size:13.5px; }
  .ar-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .ar-chip{ font-size:11.5px; color:#dfe2e6; background:rgba(255,255,255,.08); border-radius:8px; padding:4px 8px; line-height:1.3; }
  .ar-chip b{ color:var(--gold); font-weight:600; margin-right:2px; }
  .ar-mapnote{ color:var(--mist); font-size:12px; margin-top:10px; }
  .ar-page .leaflet-container{ background:#0b1a1f; font-family:inherit; }
  .ar-page .leaflet-tooltip{ background:#14171c; color:#fff; border:none; box-shadow:0 4px 14px rgba(0,0,0,.4); }
  .ar-page .leaflet-tooltip-top:before{ border-top-color:#14171c; }

  .ar-steps{ list-style:none; margin:18px 0 0; padding:0; display:grid; gap:12px; max-width:760px; }
  .ar-steps li{ display:flex; gap:14px; align-items:flex-start; background:rgba(20,22,28,.5); border-radius:14px; padding:15px 16px; box-shadow:inset 0 1px 0 rgba(255,255,255,.1); }
  .ar-stepn{ flex:0 0 auto; width:28px; height:28px; border-radius:50%; display:grid; place-items:center; font-family:var(--mono); font-weight:700; font-size:13px; color:#06231f; background:var(--gold); }
  .ar-steps b{ display:block; font-size:15px; margin-bottom:2px; }
  .ar-steps p{ margin:0; color:var(--mist); font-size:13px; }
  .ar-fineprint{ color:var(--mist); font-size:12px; margin-top:14px; opacity:.85; }
  .ar-fineprint a{ color:var(--sky); }

  .ar-cta{ display:flex; gap:12px; flex-wrap:wrap; }
  .ar-btn{ display:inline-block; padding:.8rem 1.3rem; border-radius:999px; font-weight:600; font-size:.95rem; text-decoration:none; color:#06231f; background:var(--gold); transition:transform .25s ease; }
  .ar-btn--ghost{ color:var(--bone); background:rgba(255,255,255,.08); box-shadow:inset 0 0 0 1px rgba(255,255,255,.18); }
  .ar-btn:hover{ transform:translateY(-2px); }
  .ar-close{ text-align:center; padding-bottom:64px; }
  .ar-disc{ font-size:12px; color:var(--mist); max-width:70ch; margin:14px auto 0; opacity:.85; }
  .ar-src{ font-size:11.5px; color:var(--mist); margin-top:8px; }

  @media(max-width:820px){
    .ar-rgrid{ grid-template-columns:1fr 1fr; }
    .ar-stage{ grid-template-columns:1fr; } #arMap{ height:440px; }
  }
  @media(prefers-reduced-motion:reduce){
    .ar-bg,.ar-dronefly{ animation:none; }
    .ar-h1 span,.ar-cover-in .ar-kick,.ar-meta,.ar-rule{ animation:none; opacity:1; transform:none; }
  }
</style>

<script define:vars={{ ARSPOTS: arubaSpots }}>window.ARSPOTS = ARSPOTS;</script>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
(function(){
  function init(){
    if(!window.L){ return setTimeout(init,120); }
    var U=function(id){ return 'https://images.unsplash.com/photo-'+id+'?w=900&q=72&auto=format&fit=crop'; };
    var COL={fly:'#46C95F',care:'#FF9A2E',no:'#FF6B5E'};
    var spots = window.ARSPOTS || [];

    var map=L.map('arMap',{zoomControl:true,scrollWheelZoom:false,attributionControl:true}).setView([12.52,-69.98],11);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{maxZoom:19,attribution:'© OpenStreetMap, © CARTO'}).addTo(map);

    var ph=document.getElementById('arPh'), pbody=document.getElementById('arPbody'), chips=document.getElementById('arChips');
    function chip(label,val){ return '<span class="ar-chip"><b>'+label+'</b> '+val+'</span>'; }
    function render(s){
      pbody.style.display='block';
      document.getElementById('arPname').textContent=s.n;
      document.getElementById('arPtip').textContent=s.tip;
      var b=document.getElementById('arBadge'); b.className='ar-badge '+s.t;
      b.textContent = s.t==='fly'?'Drone-top · go':(s.t==='care'?'Drone · met beleid':(s.t==='pocket'?'Pocket 4 · grond':'No-fly · verboden'));
      var c='';
      if(s.light && s.light!=='—') c+=chip('☀︎',s.light);
      if(s.wind && s.wind!=='—') c+=chip('💨',s.wind);
      if(s.move && s.move!=='Niet vliegen') c+=chip('🎬',s.move);
      chips.innerHTML=c;
      ph.classList.remove('empty');
      if(s.img){ ph.style.background="url('"+U(s.img)+"') center/cover"; ph.innerHTML=''; }
      else { ph.style.background='linear-gradient(135deg,#3a1416,#5a1d1d)'; ph.innerHTML='<div style="position:absolute;inset:0;display:grid;place-items:center;color:#ffb4ad;font-size:34px;z-index:2">⛔</div>'; }
    }
    var pIcon=L.divIcon({className:'',iconSize:[18,18],iconAnchor:[9,9],html:'<div style="width:16px;height:16px;border-radius:5px;background:#9B4DDB;border:2px solid #2a0f3d;box-shadow:0 0 0 1px rgba(255,255,255,.25);display:grid;place-items:center"><span style="width:5px;height:5px;border-radius:50%;background:#fff;display:block"></span></div>'});
    var entries=[];
    spots.forEach(function(s){
      var m;
      if(s.t==='pocket'){ m=L.marker(s.ll,{icon:pIcon}); }
      else { m=L.circleMarker(s.ll,{radius:8,weight:2,color:'#06231f',fillColor:COL[s.t],fillOpacity:.95}); }
      m.bindTooltip(s.n,{direction:'top',offset:[0,-6]});
      m.on('mouseover',function(){render(s);}); m.on('click',function(){render(s);});
      m.addTo(map);
      entries.push({s:s,m:m,on:true});
    });

    var curCat='all', curQ='';
    function applyFilter(){
      var vis=[];
      entries.forEach(function(e){
        var ok=(curCat==='all'||e.s.t===curCat) && (!curQ || e.s.n.toLowerCase().indexOf(curQ)>=0);
        if(ok && !e.on){ e.m.addTo(map); e.on=true; }
        else if(!ok && e.on){ map.removeLayer(e.m); e.on=false; }
        if(ok) vis.push(e.s.ll);
      });
      if(vis.length){ map.fitBounds(L.latLngBounds(vis),{padding:[28,28],maxZoom:14}); }
    }
    var fbtns=document.querySelectorAll('.ar-fbtn');
    fbtns.forEach(function(btn){ btn.addEventListener('click',function(){
      fbtns.forEach(function(b){ b.classList.remove('on'); }); btn.classList.add('on');
      curCat=btn.getAttribute('data-f'); applyFilter();
    }); });
    var search=document.getElementById('arSearch');
    if(search){ search.addEventListener('input',function(){ curQ=search.value.trim().toLowerCase(); applyFilter(); }); }

    function fitIsland(){ map.fitBounds(L.latLngBounds(spots.map(function(s){return s.ll;})),{padding:[28,28]}); }
    fitIsland();
    map.on('resize',function(){ if(curCat==='all'&&!curQ) fitIsland(); });
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',init); } else { init(); }
})();
</script>
