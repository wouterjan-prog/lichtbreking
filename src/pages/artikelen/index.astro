---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { articles } from '../../data/articles.js';

const sorted = [...articles].sort((a, b) => (a.date < b.date ? 1 : -1));
const featured = sorted.find((a) => a.featured) || sorted[0];
const rest = sorted.filter((a) => a !== featured);
const cats = [...new Set(sorted.map((a) => a.cat))];
const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Artikelen" description="Korte, praktische artikelen over drone- en cameratechniek, het mooiste licht en montage. Gratis te lezen — leer sneller mooiere beelden maken." path="/artikelen/">
  <GlassNav active="artikelen" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container art-page">
    <header class="art-head lb-reveal">
      <span class="lb-label lb-label--sky">Artikelen</span>
      <h1 class="lb-display-l">Leren over licht, lucht &amp; beweging</h1>
      <p class="lb-lead">Korte, praktische artikelen over drone- en cameratechniek, het mooiste licht en de montage erna. Gratis te lezen — bedoeld om je sneller mooiere beelden te laten maken.</p>
    </header>

    <div class="art-filters lb-reveal" id="artFilters">
      <button class="art-chip on" data-filter="all">Alles</button>
      {cats.map((c) => <button class="art-chip" data-filter={c}>{c}</button>)}
    </div>

    <a href={`/artikelen/${featured.slug}/`} class="art-feat lb-reveal" data-cat={featured.cat}>
      <div class={`art-ph ${featured.ph}`}></div>
      <div class="art-feat__body">
        <div class="art-meta"><span class="art-tag">{featured.cat}</span><span class="art-read">{featured.readMin} min · uitgelicht</span></div>
        <h2 class="art-feat__title">{featured.title}</h2>
        <p class="art-feat__exc">{featured.excerpt}</p>
        <span class="art-go">Lees het artikel →</span>
      </div>
    </a>

    <div class="art-grid" id="artGrid">
      {rest.map((a) => (
        <a href={`/artikelen/${a.slug}/`} class="art-card lb-reveal" data-cat={a.cat}>
          <div class={`art-ph ${a.ph}`}></div>
          <div class="art-card__body">
            <div class="art-meta"><span class="art-tag">{a.cat}</span></div>
            <h3 class="art-card__title">{a.title}</h3>
            <p class="art-card__exc">{a.excerpt}</p>
            <span class="art-read">{a.readMin} min · {fmt(a.date)}</span>
          </div>
        </a>
      ))}
    </div>

    <p class="art-empty lb-muted" id="artEmpty" hidden>Geen artikelen in deze categorie — kies "Alles".</p>
  </main>
  <Footer />
</Base>

<style>
  .art-page { padding-top: 130px; padding-bottom: 96px; max-width: 1040px; }
  .art-head { max-width: 64ch; margin-bottom: 32px; }
  .art-head h1 { margin: 10px 0 16px; }
  .art-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 34px; }
  .art-chip { font-family: var(--lb-font-mono); font-size: 12px; letter-spacing: .04em; color: var(--lb-mist); background: rgba(127,127,140,.12); border: 1px solid var(--lb-line); border-radius: 20px; padding: 7px 14px; cursor: pointer; transition: background var(--lb-dur) var(--lb-ease), color var(--lb-dur) var(--lb-ease); }
  .art-chip:hover { color: var(--lb-bone); }
  .art-chip.on { color: var(--lb-night); background: var(--lb-bone); border-color: transparent; }

  .art-ph { background: linear-gradient(135deg,#16171B,#2FB8C4 145%); }
  .art-ph.l { background: linear-gradient(135deg,#16171B,#FF9A2E 145%); }
  .art-ph.t { background: linear-gradient(135deg,#16171B,#2FB8C4 145%); }
  .art-ph.d { background: linear-gradient(135deg,#16171B,#FF5147 145%); }
  .art-ph.m { background: linear-gradient(135deg,#16171B,#9B4DDB 145%); }
  .art-ph.r { background: linear-gradient(135deg,#16171B,#46C95F 145%); }
  .art-ph.c { background: linear-gradient(135deg,#16171B,#2F7CF0 145%); }

  .art-feat { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; border-radius: 20px; overflow: hidden; margin-bottom: 30px; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 16px 44px rgba(0,0,0,.26); transition: transform var(--lb-dur) var(--lb-ease); }
  .art-feat::after, .art-card::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.2px; background: var(--lb-spectrum-135); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .34; pointer-events: none; }
  .art-feat:hover, .art-card:hover { transform: translateY(-3px); }
  .art-feat .art-ph { min-height: 260px; }
  .art-feat__body { padding: 28px 30px; display: flex; flex-direction: column; justify-content: center; }
  .art-feat__title { font-size: 1.7rem; margin: 10px 0 10px; line-height: 1.15; }
  .art-feat__exc { color: var(--lb-mist); margin: 0 0 16px; }

  .art-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .art-card { position: relative; display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 14px 40px rgba(0,0,0,.24); transition: transform var(--lb-dur) var(--lb-ease); }
  .art-card .art-ph { height: 150px; }
  .art-card__body { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; }
  .art-card__title { font-size: 1.05rem; margin: 4px 0 7px; line-height: 1.25; }
  .art-card__exc { color: var(--lb-mist); font-size: var(--lb-small); margin: 0 0 12px; flex: 1; }

  .art-meta { display: flex; align-items: center; gap: 8px; }
  .art-tag { font-family: var(--lb-font-mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--lb-sky); background: rgba(47,124,240,.16); padding: 3px 8px; border-radius: 20px; }
  .art-read { font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .04em; color: var(--lb-mist); opacity: .85; }
  .art-go { color: var(--lb-sky); font-size: var(--lb-small); }
  .art-empty { margin-top: 24px; }

  @media (max-width: 820px) { .art-grid { grid-template-columns: 1fr 1fr; } .art-feat { grid-template-columns: 1fr; } .art-feat .art-ph { min-height: 160px; } }
  @media (max-width: 560px) { .art-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.art-chip');
    var cards = document.querySelectorAll('[data-cat]');
    var empty = document.getElementById('artEmpty');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.classList.remove('on'); });
        chip.classList.add('on');
        var f = chip.getAttribute('data-filter');
        var shown = 0;
        cards.forEach(function (card) {
          var hit = f === 'all' || card.getAttribute('data-cat') === f;
          card.style.display = hit ? '' : 'none';
          if (hit) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      });
    });
  })();
</script>
