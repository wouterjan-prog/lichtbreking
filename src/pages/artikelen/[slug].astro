---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { articles } from '../../data/articles.js';
import { viz, articleHero, inlineFigures } from '../../data/visuals.js';
import { src, srcset } from '../../data/work.js';
import GradeCompare from '../../components/GradeCompare.astro';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const related = articles.filter((a) => a.slug !== article.slug).slice(0, 3);
const hero = articleHero[article.slug] || { viz: 'default' };
// inline mini-diagrammen vóór passende koppen plaatsen
let bodyHtml = article.body;
const figs = inlineFigures[article.slug];
if (figs) {
  bodyHtml = bodyHtml.replace(/<h2>([\s\S]*?)<\/h2>/g, (m, txt) => {
    const hit = figs.find((f) => txt.includes(f.k));
    return hit ? `<figure class="lb-fig">${viz(hit.v)}</figure>${m}` : m;
  });
}
---
<Base title={article.title} description={article.excerpt} path={`/artikelen/${article.slug}/`} type="article" image={`/img/og-art-${article.slug}.png`}>
  <GlassNav active="artikelen" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container post-page">
    <a href="/artikelen/" class="post-back lb-reveal">← Alle artikelen</a>

    {hero.photo
      ? <img class="post-hero post-hero--photo lb-reveal" src={src(hero.photo, 1600)} srcset={srcset(hero.photo)} sizes="(max-width: 900px) 100vw, 860px" alt={article.title} width="1600" height="700" loading="lazy" decoding="async" />
      : <div class="post-hero post-hero--viz lb-reveal" set:html={viz(hero.viz)}></div>}

    <header class="post-head lb-reveal">
      <div class="post-meta"><span class="art-tag">{article.cat}</span><span class="art-read">{article.readMin} min lezen · {fmt(article.date)}</span></div>
      <h1 class="post-title">{article.title}</h1>
      <p class="post-lead lb-muted">{article.excerpt}</p>
    </header>

    <article class="post-body lb-reveal" set:html={bodyHtml}></article>

    {article.slug === 'kleurprofielen-uitgelegd' && (
      <div class="post-body lb-reveal">
        <h2>Probeer het zelf</h2>
        <GradeCompare />
      </div>
    )}

    <div class="post-cta lb-reveal">
      <span class="lb-label lb-label--sky">Gratis cursus</span>
      <h2>Leer het stap voor stap</h2>
      <p>Twee gratis cursussen brengen je van eerste opstart tot afgemonteerde cinematische film.</p>
      <a href="/cursussen/" class="lb-btn">Naar de cursussen →</a>
    </div>

    {related.length > 0 && (
      <section class="post-related">
        <span class="lb-label">Lees ook</span>
        <div class="post-rel-grid">
          {related.map((a) => (
            <a href={`/artikelen/${a.slug}/`} class="post-rel">
              <span class="art-tag">{a.cat}</span>
              <strong>{a.title}</strong>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .post-page { padding-top: 120px; padding-bottom: 96px; max-width: 760px; }
  .post-back { display: inline-block; color: var(--lb-mist); font-size: var(--lb-small); margin-bottom: 22px; transition: color var(--lb-dur) var(--lb-ease); }
  .post-back:hover { color: var(--lb-bone); }
  .post-hero { border-radius: 18px; margin-bottom: 26px; overflow: hidden; }
  .post-hero--photo { display: block; width: 100%; height: 280px; object-fit: cover; }
  .post-hero--viz { background: radial-gradient(120% 140% at 70% 0%, #1a1c22, #0d0e12); border: 1px solid var(--lb-glass-border); padding: 6px; }
  .post-hero--viz :global(svg) { max-height: 300px; }
  :root[data-theme="light"] .post-hero--viz { background: radial-gradient(120% 140% at 70% 0%, #20222a, #14151a); }
  @media (prefers-color-scheme: light) { :root:not([data-theme]) .post-hero--viz { background: radial-gradient(120% 140% at 70% 0%, #20222a, #14151a); } }
  @media (prefers-reduced-motion: reduce) { .post-hero--viz :global(svg) :global(*) { animation: none !important; } .post-hero--viz :global(animate), .post-hero--viz :global(animateTransform), .post-hero--viz :global(animateMotion) { display: none; } }
  .art-ph { height: 240px; background: linear-gradient(135deg,#3f3f46,#6b7280 60%,#9ca3af); }
  .post-body :global(.lb-fig) { margin: 1.5rem 0 .4rem; padding: 8px; border-radius: 14px; background: radial-gradient(120% 140% at 70% 0%, #1a1c22, #0d0e12); border: 1px solid var(--lb-glass-border); }
  .post-body :global(.lb-fig svg) { display: block; max-height: 200px; }
  @media (prefers-reduced-motion: reduce) { .post-body :global(.lb-fig animate), .post-body :global(.lb-fig animateTransform), .post-body :global(.lb-fig animateMotion) { display: none; } }
  .art-ph { background: linear-gradient(135deg,#3f3f46,#6b7280 60%,#9ca3af); }
  .art-ph.l { background: linear-gradient(135deg,#b45309,#f59e0b 55%,#fcd34d); }
  .art-ph.t { background: linear-gradient(135deg,#3f3f46,#6b7280 60%,#9ca3af); }
  .art-ph.d { background: linear-gradient(135deg,#7c2d12,#ea580c 60%,#fb923c); }
  .art-ph.m { background: linear-gradient(135deg,#4c1d95,#7c3aed 60%,#c4b5fd); }
  .art-ph.r { background: linear-gradient(135deg,#134e4a,#0d9488 60%,#5eead4); }
  .art-ph.c { background: linear-gradient(135deg,#9d174d,#db2777 60%,#f9a8d4); }

  .post-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .art-tag { font-family: var(--lb-font-mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--lb-sky); background: rgba(47,124,240,.16); padding: 3px 8px; border-radius: 20px; }
  .art-read { font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .04em; color: var(--lb-mist); opacity: .85; }
  .post-title { font-size: clamp(28px, 4.5vw, 40px); line-height: 1.12; margin: 0 0 12px; }
  .post-lead { font-size: 1.1rem; margin: 0 0 8px; }

  .post-body { font-size: 1.05rem; line-height: 1.75; color: var(--lb-bone); }
  .post-body :global(h2) { font-size: 1.4rem; margin: 2rem 0 .7rem; }
  .post-body :global(p) { margin: 0 0 1.1rem; color: var(--lb-bone); }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 1.2rem; padding-left: 1.3rem; color: var(--lb-bone); }
  .post-body :global(li) { margin: .4rem 0; }
  .post-body :global(a) { color: var(--lb-sky); text-decoration: underline; text-underline-offset: 2px; }
  .post-body :global(strong) { color: var(--lb-bone); }
  .post-body :global(.callout) { background: rgba(70,201,95,.10); border-left: 4px solid var(--lb-green-ink); border-radius: 0 12px 12px 0; padding: 1.1rem 1.3rem; margin: 1.6rem 0; }
  .post-body :global(.callout .c-label) { font-family: var(--lb-font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-green-ink); font-weight: 700; margin-bottom: .35rem; }
  .post-body :global(.callout p) { margin: 0; }
  /* Wel/geen-filter beslisblok */
  .post-body :global(.fbox) { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 1.4rem 0 .7rem; }
  .post-body :global(.fbox__col) { border-radius: 12px; padding: 14px 16px; border: 1px solid var(--lb-line); }
  .post-body :global(.fbox__col--yes) { background: rgba(70,201,95,.10); border-left: 4px solid var(--lb-green-ink); }
  .post-body :global(.fbox__col--no) { background: rgba(224,88,77,.10); border-left: 4px solid #e0584d; }
  .post-body :global(.fbox__h) { display: block; font-family: var(--lb-font-mono); font-size: .8rem; letter-spacing: .05em; text-transform: uppercase; font-weight: 700; margin-bottom: 8px; }
  .post-body :global(.fbox__col--yes .fbox__h) { color: var(--lb-green-ink); }
  .post-body :global(.fbox__col--no .fbox__h) { color: #e0584d; }
  :root[data-theme="light"] .post-body :global(.fbox__col--no .fbox__h) { color: #c0392b; }
  @media (prefers-color-scheme: light) { :root:not([data-theme]) .post-body :global(.fbox__col--no .fbox__h) { color: #c0392b; } }
  .post-body :global(.fbox p) { margin: 0 0 .4rem; font-size: .9rem; color: var(--lb-bone); }
  .post-body :global(.fbox ul) { margin: 0; padding-left: 1.15rem; }
  .post-body :global(.fbox li) { font-size: .9rem; margin: .25rem 0; }
  .post-body :global(.fbox-rule) { font-size: .92rem; color: var(--lb-mist); border-left: 3px solid var(--lb-sky); padding: 2px 0 2px 12px; margin: 0 0 1.4rem; }
  @media (max-width: 560px) { .post-body :global(.fbox) { grid-template-columns: 1fr; } }

  .post-cta { position: relative; margin: 40px 0 0; padding: 26px 28px; border-radius: 18px; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 14px 40px rgba(0,0,0,.22); }
  .post-cta::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.2px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .4; pointer-events: none; }
  .post-cta h2 { margin: 8px 0 6px; font-size: 1.3rem; }
  .post-cta p { color: var(--lb-mist); margin: 0 0 16px; }

  .post-related { margin-top: 44px; }
  .post-rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; }
  .post-rel { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; padding: 16px; border-radius: 14px; border: 1px solid var(--lb-line); background: var(--lb-ink); transition: border-color var(--lb-dur) var(--lb-ease), transform var(--lb-dur) var(--lb-ease); }
  .post-rel:hover { border-color: var(--lb-mist); transform: translateY(-2px); }
  .post-rel strong { font-size: .95rem; line-height: 1.3; }
  @media (max-width: 620px) { .post-rel-grid { grid-template-columns: 1fr; } }
</style>
