---
// Standalone, print-/Instagram-geoptimaliseerde deelkaart van de Curaçao-gids.
// Story-formaat (9:16) kaarten; "Download als PDF" gebruikt de print-naar-PDF van de browser.
const U = (id, w = 1000) => `https://images.unsplash.com/photo-${id}?w=${w}&q=74&auto=format&fit=crop`;
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Drone op Curaçao — deelkaart (PDF)</title>
<meta name="robots" content="noindex" />
<style is:global>
  :root{
    --night:#08080A; --ink:#0c1116; --bone:#F4F1EA; --mist:#AEB0B6; --gold:#E7C98F;
    --green:#46C95F; --orange:#FF9A2E; --red:#FF6B5E; --violet:#9B4DDB; --teal:#2FB8C4;
    --spectrum:linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB);
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
    --text:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  body{margin:0;background:#15171c;color:var(--bone);font-family:var(--text);line-height:1.5;-webkit-font-smoothing:antialiased}

  /* toolbar — niet zichtbaar in print */
  .bar{position:sticky;top:0;z-index:20;display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap;
       padding:14px;background:rgba(8,8,10,.82);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.08)}
  .bar p{margin:0;font-size:13px;color:var(--mist);max-width:48ch;text-align:center}
  .btn{appearance:none;border:0;cursor:pointer;font-weight:600;font-size:14px;padding:.7rem 1.2rem;border-radius:999px;color:#06231f;background:var(--gold)}
  .btn.ghost{color:var(--bone);background:rgba(255,255,255,.08);box-shadow:inset 0 0 0 1px rgba(255,255,255,.2)}

  .deck{display:flex;flex-direction:column;align-items:center;gap:22px;padding:26px 14px 60px}

  /* story-kaart 9:16 */
  .card{position:relative;width:min(440px,92vw);aspect-ratio:9/16;border-radius:26px;overflow:hidden;
        background:var(--ink);box-shadow:0 24px 60px rgba(0,0,0,.5);color:var(--bone);display:flex;flex-direction:column}
  .card::after{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.4px;background:var(--spectrum);
        -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.5;pointer-events:none;z-index:6}
  .pad{position:relative;z-index:3;padding:30px 26px}
  .kick{font-family:var(--mono);letter-spacing:.2em;text-transform:uppercase;font-size:11px;color:var(--gold);margin:0}
  .ttl{font-size:30px;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;line-height:1.02;margin:8px 0 0}
  .rule{height:3px;width:120px;border-radius:3px;background:var(--spectrum);margin:14px 0}
  .lead{color:#cfd2d6;font-size:13.5px;margin:0}

  /* COVER */
  .cover .bg{position:absolute;inset:0;background-size:cover;background-position:center;z-index:1}
  .cover .scrim{position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,rgba(0,0,0,.45),rgba(0,0,0,.1) 36%,rgba(6,11,15,.96))}
  .cover .pad{margin-top:auto}
  .cover h1{font-size:54px;font-weight:800;text-transform:uppercase;line-height:.9;letter-spacing:-.02em;margin:6px 0 0;text-shadow:0 6px 40px rgba(0,0,0,.4)}
  .cover .meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;font-family:var(--mono);font-size:11px}
  .pill{padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.12);color:#eaf1f4}
  .pill b{color:var(--gold)}

  /* REGELS */
  .fill{background:radial-gradient(120% 90% at 20% 0%,#0e2a30,#0a1116 60%)}
  .reglist{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}
  .rc{background:rgba(255,255,255,.05);border-radius:16px;padding:16px;text-align:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.1)}
  .rc svg{color:var(--gold)} .rc b{display:block;margin-top:8px;font-size:16px} .rc span{font-size:12px;color:var(--mist)}
  .warn{margin-top:16px;border-radius:14px;padding:14px 16px;background:rgba(255,90,80,.14);border-left:4px solid var(--red);font-size:13px}
  .warn b{color:#ffd2cd}

  /* SPOTS */
  .spotgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
  .sp{position:relative;border-radius:14px;overflow:hidden;aspect-ratio:4/3;background:#0f1419}
  .sp .im{position:absolute;inset:0;background-size:cover;background-position:center}
  .sp::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(8,8,10,.85))}
  .sp .nm{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:8px 10px;font-size:12.5px;font-weight:700;text-shadow:0 1px 6px rgba(0,0,0,.6)}
  .sp .dt{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--mist);margin-top:14px}
  .legend i{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:4px;vertical-align:middle}
  .legend i.sq{border-radius:3px}

  /* INSTELLINGEN */
  .ndtable{margin-top:18px;border-radius:16px;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
  .ndrow{display:grid;grid-template-columns:1fr auto;gap:8px;padding:13px 16px;font-size:14px;align-items:center}
  .ndrow:nth-child(odd){background:rgba(255,255,255,.04)}
  .ndrow b{font-family:var(--mono);color:var(--gold);font-size:15px}
  .dials{display:flex;gap:8px;margin-top:16px}
  .dials div{flex:1;background:rgba(255,255,255,.06);border-radius:12px;padding:12px 6px;text-align:center}
  .dials b{display:block;font-size:18px} .dials span{font-family:var(--mono);font-size:10px;color:var(--mist);text-transform:uppercase;letter-spacing:.04em}
  .note{color:var(--mist);font-size:12.5px;margin:14px 0 0}

  /* MOVES */
  .moves{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
  .mv{background:rgba(255,255,255,.05);border-radius:14px;padding:13px 14px}
  .mv .n{font-family:var(--mono);font-size:11px;color:var(--gold)} .mv b{display:block;font-size:15px;margin-top:2px} .mv span{font-size:12px;color:var(--mist)}
  .wind{margin-top:14px;border-radius:14px;padding:14px 16px;background:rgba(47,184,196,.12);border-left:4px solid var(--teal);font-size:13px}
  .wind b{color:#bfeef2}

  /* CTA */
  .cta{background:radial-gradient(120% 90% at 80% 100%,#10242b,#0a1116 60%)}
  .cta .pad{margin-top:auto;text-align:center}
  .dot{width:30px;height:30px;border-radius:9px;background:var(--spectrum);margin:0 auto 12px}
  .handle{font-family:var(--mono);font-size:14px;color:var(--gold);margin-top:10px}
  .small{font-size:11.5px;color:var(--mist);margin-top:14px;opacity:.85}

  /* PRINT → 9:16 portrait pagina's */
  @media print{
    @page{ size:108mm 192mm; margin:0; }
    body{background:#fff}
    .bar{display:none !important}
    .deck{display:block;padding:0;gap:0}
    .card{width:108mm;height:192mm;aspect-ratio:auto;border-radius:0;box-shadow:none;break-after:page;page-break-after:always}
    .card::after{display:none}
    .card:last-child{break-after:auto}
    *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  }
</style>
</head>
<body>
  <div class="bar">
    <p>6 deelbare story-kaarten (9:16). Tik op <b>Download als PDF</b> en kies "Bewaar als PDF" — elke pagina is precies één Instagram-story.</p>
    <button class="btn" id="dl">Download als PDF</button>
    <a class="btn ghost" href="/curacao/">← Terug naar de gids</a>
  </div>

  <div class="deck">

    <!-- 1 — COVER -->
    <section class="card cover">
      <div class="bg" style={`background-image:url('${U("1753618282728-f05ecfc5c9d6",1200)}')`}></div>
      <div class="scrim"></div>
      <div class="pad">
        <p class="kick">De complete gids · lichtbreking</p>
        <h1>Drone op<br>Curaçao</h1>
        <div class="rule"></div>
        <div class="meta">
          <span class="pill"><b>18</b> drone-spots</span>
          <span class="pill"><b>9</b> Pocket 4</span>
          <span class="pill"><b>4</b> no-fly</span>
        </div>
      </div>
    </section>

    <!-- 2 — REGELS -->
    <section class="card fill">
      <div class="pad">
        <p class="kick">Voor je vliegt</p>
        <h2 class="ttl">De regels — kort</h2>
        <div class="rule"></div>
        <div class="reglist">
          <div class="rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4"/><rect x="4" y="3" width="16" height="18" rx="2"/></svg><b>Registreren</b><span>RAC + CCAA, vooraf</span></div>
          <div class="rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20V8M12 8l-4 4M12 8l4 4M4 4h16"/></svg><b>Max 120 m</b><span>hoogte</span></div>
          <div class="rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg><b>Zicht (VLOS)</b><span>altijd</span></div>
          <div class="rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5"/><path d="M18 9h4M20 7v4"/></svg><b>50 m</b><span>van mensen</span></div>
        </div>
        <div class="warn"><b>Let op:</b> registreren is verplicht — zonder registratie kan je drone bij de douane worden ingenomen. Check de actuele no-fly-kaart bij de CCAA.</div>
      </div>
    </section>

    <!-- 3 — SPOTS -->
    <section class="card fill">
      <div class="pad">
        <p class="kick">Curaçao · de kaart</p>
        <h2 class="ttl">De mooiste spots</h2>
        <div class="rule"></div>
        <div class="spotgrid">
          <div class="sp"><div class="im" style={`background-image:url('${U("1685101144016-301f2fa7671c",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--green)"></span>Knip</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1519144350867-5c35e4a41a6c",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--green)"></span>Westpunt</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1771822157101-d94c1e8c05fb",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--green)"></span>Jeremi</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1616555846456-6d53b92669a8",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--green)"></span>Cas Abao</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1603384447003-758330a56ded",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--green)"></span>Klein Curaçao</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1636517031771-46f4032c895f",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--orange)"></span>Willemstad</div></div>
        </div>
        <div class="legend">
          <span><i style="background:var(--green)"></i>Drone-top</span>
          <span><i style="background:var(--orange)"></i>Met beleid</span>
          <span><i style="background:var(--red)"></i>No-fly</span>
          <span><i class="sq" style="background:var(--violet)"></i>Pocket 4</span>
        </div>
        <p class="note">Volledige interactieve kaart met 26 spots op lichtbreking.nl/curacao</p>
      </div>
    </section>

    <!-- 4 — INSTELLINGEN -->
    <section class="card fill">
      <div class="pad">
        <p class="kick">Instellingen</p>
        <h2 class="ttl">Fel licht? Kies je ND</h2>
        <div class="rule"></div>
        <div class="ndtable">
          <div class="ndrow"><span>Bewolkt</span><b>ND8</b></div>
          <div class="ndrow"><span>Zonnig</span><b>ND16</b></div>
          <div class="ndrow"><span>Felle middagzon</span><b>ND32</b></div>
          <div class="ndrow"><span>Wit zand / spiegelend water</span><b>ND64</b></div>
        </div>
        <div class="dials">
          <div><b>4K</b><span>resolutie</span></div>
          <div><b>24–30</b><span>fps</span></div>
          <div><b>1/50</b><span>sluiter</span></div>
          <div><b>100</b><span>ISO</span></div>
        </div>
        <p class="note">Sluiterhoek 180° = sluiter op het dubbele van je framerate. ND houdt het licht tegen zodat je die trage sluiter haalt — zonder overbelichting.</p>
      </div>
    </section>

    <!-- 5 — MOVES -->
    <section class="card fill">
      <div class="pad">
        <p class="kick">Techniek</p>
        <h2 class="ttl">De mooiste moves</h2>
        <div class="rule"></div>
        <div class="moves">
          <div class="mv"><span class="n">01</span><b>Reveal</b><span>Achteruit + omhoog</span></div>
          <div class="mv"><span class="n">02</span><b>Orbit</b><span>Rondje, ~30 sec</span></div>
          <div class="mv"><span class="n">03</span><b>Parallax</b><span>Zijwaarts, diepte</span></div>
          <div class="mv"><span class="n">04</span><b>Top-down</b><span>Recht omhoog</span></div>
          <div class="mv"><span class="n">05</span><b>Tracking</b><span>Volgen van achter</span></div>
          <div class="mv"><span class="n">tip</span><b>Gouden uur</b><span>Zacht, warm licht</span></div>
        </div>
        <div class="wind"><b>Passaatwind</b> — bijna altijd uit het (noord)oosten, sterker bij kliffen. Lichte drones worden zo de zee op geblazen: check wind &amp; stoten en vlieg met de neus tegen de wind.</div>
      </div>
    </section>

    <!-- 6 — POCKET 4 + CTA -->
    <section class="card cta">
      <div class="pad" style="margin-top:24px">
        <p class="kick">Geen drone? Pak de Pocket 4</p>
        <h2 class="ttl">Vanaf de grond</h2>
        <div class="rule"></div>
        <div class="spotgrid">
          <div class="sp"><div class="im" style={`background-image:url('${U("1636517031771-46f4032c895f",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--violet)"></span>Punda &amp; markt</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1779814888539-310978a5dada",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--violet)"></span>Hato Caves</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1553520077-205eb37650fa",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--violet)"></span>Flamingo's Jan Kok</div></div>
          <div class="sp"><div class="im" style={`background-image:url('${U("1775351602871-a4656a8af484",600)}')`}></div><div class="nm"><span class="dt" style="background:var(--violet)"></span>Shete Boka</div></div>
        </div>
      </div>
      <div class="pad">
        <div class="dot"></div>
        <p class="kick" style="text-align:center">Vlieg veilig. Film cinematisch.</p>
        <p class="handle">lichtbreking.nl/curacao · @lichtbreking</p>
        <p class="small">Met zorg samengesteld op basis van openbare bronnen (juni 2026). Regelgeving kan wijzigen — bevestig de actuele regels &amp; no-fly-zones altijd bij de CCAA vóór je vliegt.</p>
      </div>
    </section>

  </div>

  <script is:inline>
    document.getElementById('dl').addEventListener('click', function(){
      try{ if(window.va) window.va('event',{name:'pdf_download',page:'curacao'}); }catch(e){}
      window.print();
    });
  </script>
</body>
</html>
