---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { curacaoSpots } from '../../data/curacaospots.js';
---
<Base
  title="Drone op Curaçao — de gids"
  description="De complete gids voor dronevliegen en filmen op Curaçao: 30+ spots op een exacte kaart met filters, no-fly-zones, de juiste ND- en Pro-instellingen, de beste moves én losse Pocket 4-spots vanaf de grond."
  path="/curacao/">
  <GlassNav active="" switchHref="/en/cursussen/" hero />

  <main id="hoofdinhoud" tabindex="-1" class="cur-page">

    <!-- ============ COVER ============ -->
    <section class="cur-cover">
      <div class="cur-bg"></div><div class="cur-scrim"></div>
      <svg class="cur-dronefly" width="86" height="44" viewBox="0 0 92 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <ellipse cx="18" cy="12" rx="13" ry="3.4" opacity=".85"/><ellipse cx="74" cy="12" rx="13" ry="3.4" opacity=".85"/>
        <line x1="18" y1="14" x2="34" y2="26"/><line x1="74" y1="14" x2="58" y2="26"/><rect x="34" y="24" width="24" height="12" rx="4"/><circle cx="46" cy="30" r="2.2" fill="#fff" stroke="none"/>
      </svg>
      <div class="cur-cover-in">
        <span class="cur-kick">De complete gids · lichtbreking</span>
        <h1 class="cur-h1"><span>Drone op</span><span>Curaçao</span></h1>
        <div class="cur-rule"></div>
        <div class="cur-meta"><span><b>18</b> drone-spots</span><span><b>9</b> Pocket 4-spots</span><span><b>4</b> no-fly</span><span>juiste <b>instellingen</b> &amp; moves</span></div>
      </div>
    </section>

    <!-- ============ RULES ============ -->
    <section class="cur-sec cur-rules"><div class="cur-wrap">
      <span class="cur-kick">Voor je vliegt</span>
      <h2 class="cur-h2">De regels — kort</h2>
      <div class="cur-rgrid">
        <div class="cur-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4"/><rect x="4" y="3" width="16" height="18" rx="2"/></svg><b>Registreren</b><span>RAC + CCAA, vooraf</span></div>
        <div class="cur-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20V8M12 8l-4 4M12 8l4 4M4 4h16"/></svg><b>Max 120 m</b><span>hoogte</span></div>
        <div class="cur-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/></svg><b>Zicht (VLOS)</b><span>altijd</span></div>
        <div class="cur-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5"/><path d="M18 9h4M20 7v4"/></svg><b>50 m</b><span>van mensen</span></div>
      </div>
      <div class="cur-reg"><b>Let op:</b> registreren is verplicht — een drone zonder voorafgaande registratie kan bij de douane in beslag worden genomen. Bevestig de actuele regels &amp; no-fly-kaart altijd bij de CCAA vóór je vliegt.</div>
    </div></section>

    <!-- ============ MAP ============ -->
    <section class="cur-sec cur-map-sec"><div class="cur-wrap">
      <span class="cur-kick">Curaçao · de kaart</span>
      <h2 class="cur-h2">Waar vlieg &amp; film je?</h2>
      <div class="cur-legend">
        <span><i style="background:#46C95F"></i>Drone-top</span>
        <span><i style="background:#FF9A2E"></i>Met beleid</span>
        <span><i style="background:#FF6B5E"></i>No-fly</span>
        <span><i class="sq" style="background:#9B4DDB"></i>Pocket 4 (grond)</span>
        <span class="cur-legend-hint">klik of beweeg over een marker</span>
      </div>
      <div class="cur-filters" id="curFilters">
        <button class="cur-fbtn on" data-f="all" type="button">Alles</button>
        <button class="cur-fbtn" data-f="fly" type="button">Drone-top</button>
        <button class="cur-fbtn" data-f="care" type="button">Met beleid</button>
        <button class="cur-fbtn" data-f="no" type="button">No-fly</button>
        <button class="cur-fbtn" data-f="pocket" type="button">Pocket 4</button>
        <input class="cur-search" id="curSearch" type="search" placeholder="Zoek een spot…" aria-label="Zoek een spot" autocomplete="off" />
      </div>
      <div class="cur-stage">
        <div class="cur-mapbox"><div id="curMap"></div></div>
        <div class="cur-panel">
          <div class="cur-ph empty" id="curPh"><span>Kies een spot op de kaart<br>voor een beeld &amp; tip</span></div>
          <div class="cur-pbody" id="curPbody" style="display:none"><span class="cur-badge" id="curBadge"></span><h3 id="curPname"></h3><p id="curPtip"></p><div class="cur-chips" id="curChips"></div></div>
        </div>
      </div>
      <p class="cur-mapnote">Kaartdata © OpenStreetMap-bijdragers, tegels © CARTO. Alle markers staan op hun werkelijke GPS-coördinaten.</p>
    </div></section>

    <!-- ============ VOORAF ============ -->
    <section class="cur-sec"><div class="cur-wrap">
      <span class="cur-kick">Voor vertrek</span>
      <h2 class="cur-h2">Zo regel je het vooraf</h2>
      <p class="cur-lead">Op Curaçao is registratie verplicht en de douane controleert erop. Regel dit thuis, dan sta je daar meteen goed.</p>
      <ol class="cur-steps">
        <li><span class="cur-stepn">1</span><div><b>Registreer je drone</b><p>Meld je drone aan bij de Regulatory Authority of Curaçao (RAC). Doe dit ruim vóór vertrek — zonder bewijs van registratie kan je drone bij de douane worden ingenomen.</p></div></li>
        <li><span class="cur-stepn">2</span><div><b>Vraag toestemming bij de CCAA</b><p>Voor vluchten geldt de luchtvaartautoriteit (CCAA). Check de actuele regels en no-fly-zones en vraag waar nodig toestemming aan — zeker rond Hato, de cruise-terminal en natuurparken.</p></div></li>
        <li><span class="cur-stepn">3</span><div><b>Toon je papieren bij de douane</b><p>Houd je registratiebewijs (en eventueel toestemming) bij de hand bij aankomst. Een drone zonder papieren kan worden vastgehouden tot je het regelt.</p></div></li>
        <li><span class="cur-stepn">4</span><div><b>Check je verzekering</b><p>Zorg voor een aansprakelijkheidsverzekering die dronevliegen in het buitenland dekt. Vlieg altijd binnen zicht (VLOS), onder 120 m en op 50 m van mensen.</p></div></li>
      </ol>
      <p class="cur-fineprint">Regelgeving kan wijzigen — bevestig de actuele eisen altijd bij de RAC en CCAA vóór je reist. Dit is informatief, geen officieel advies.</p>
    </div></section>

    <!-- ============ SETTINGS ============ -->
    <section class="cur-sec"><div class="cur-wrap">
      <span class="cur-kick">Instellingen</span>
      <h2 class="cur-h2">Het licht is fel — kies je ND</h2>
      <p class="cur-lead">Het zonlicht boven het water is hard. Schuif van bewolkt naar felle middagzon en zie welk ND-filter je nodig hebt om op 1/50 s te blijven filmen.</p>
      <div class="cur-two">
        <div class="cur-card">
          <div class="cur-prev"><div class="cur-previmg"></div><div class="cur-ndtint" id="curNdtint"></div><div class="cur-ndlabel" id="curNdlabel">ND16</div><div class="cur-verdict" id="curVerdict">Mooi belicht ✓</div></div>
          <div class="cur-sl"><label><span>Licht</span><span id="curLname">Zonnig</span></label><input type="range" id="curLight" min="0" max="3" step="1" value="1" aria-label="Lichtsterkte"></div>
        </div>
        <div class="cur-card">
          <div class="cur-dials">
            <div class="cur-shutter"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="3"/><path d="M50 50 L50 4 A46 46 0 0 1 96 50 Z" fill="rgba(231,201,143,.85)"/><circle cx="50" cy="50" r="6" fill="#0e1116" stroke="rgba(255,255,255,.4)" stroke-width="2"/></svg></div>
            <div style="flex:1"><div class="cur-dlab">Sluiterhoek 180°</div><div class="cur-dval">1/50 s</div></div>
          </div>
          <div class="cur-mini" style="margin-top:14px"><div><b>4K</b><span>resolutie</span></div><div><b>24–30</b><span>fps</span></div><div><b>100</b><span>ISO</span></div></div>
          <div class="cur-mini" style="margin-top:8px"><div><b>5500K</b><span>witbalans vast</span></div><div><b>Normal</b><span>kleurprofiel</span></div><div><b>−1</b><span>scherpte</span></div></div>
          <p class="cur-cardnote">Zet witbalans handmatig vast (nooit auto tijdens een shot) en scherpte op −1 voor een filmischer beeld. Kleurprofiel <b>Normal</b> is direct klaar; <b>D-Log</b> alleen als je later kleurt. ND houdt je op 1/50 s zonder overbelichting. <a href="/artikelen/pro-instellingen-uitgelegd/" style="color:var(--gold)">Alle Pro-instellingen uitgelegd →</a></p>
        </div>
      </div>
    </div></section>

    <!-- ============ MOVES + WIND ============ -->
    <section class="cur-sec"><div class="cur-wrap">
      <span class="cur-kick">Techniek</span>
      <h2 class="cur-h2">De mooiste moves</h2>
      <div class="cur-mgrid">
        <div class="cur-mcard"><svg class="cur-scene" viewBox="0 0 220 120" aria-hidden="true"><path d="M0 102 H220" stroke="#1d6e5f" stroke-width="2"/><polygon points="150,102 168,66 186,102" fill="#15564a"/><circle cx="60" cy="94" r="7" fill="#0f3f37"/><path id="curp1" d="M60 90 C90 86 110 64 150 36" fill="none" stroke="#2fb8c4" stroke-width="1.5" stroke-dasharray="3 4" opacity=".7"/><g><circle class="cur-dronef" r="4"/><animateMotion dur="3s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;.8;1" calcMode="linear"><mpath href="#curp1"/></animateMotion></g></svg><div class="cur-mcap"><span class="cur-num">01</span><b>Reveal</b><span>Achteruit + omhoog</span></div></div>
        <div class="cur-mcard"><svg class="cur-scene" viewBox="0 0 220 120" aria-hidden="true"><circle cx="110" cy="62" r="9" fill="#15564a"/><ellipse id="curp2" cx="110" cy="62" rx="70" ry="34" fill="none" stroke="#2fb8c4" stroke-width="1.5" stroke-dasharray="3 4" opacity=".7"/><g><circle class="cur-dronef" r="4"/><animateMotion dur="4s" repeatCount="indefinite"><mpath href="#curp2"/></animateMotion></g></svg><div class="cur-mcap"><span class="cur-num">02</span><b>Orbit</b><span>Rondje, ~30 sec</span></div></div>
        <div class="cur-mcard"><svg class="cur-scene" viewBox="0 0 220 120" aria-hidden="true"><circle cx="110" cy="70" r="10" fill="#15564a"/><rect x="20" y="38" width="10" height="28" fill="#0f3f37"/><rect x="190" y="38" width="10" height="28" fill="#0f3f37"/><path id="curp3" d="M30 28 H190" fill="none" stroke="#2fb8c4" stroke-width="1.5" stroke-dasharray="3 4" opacity=".7"/><g><circle class="cur-dronef" r="4"/><animateMotion dur="3.4s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;.5;1" calcMode="linear"><mpath href="#curp3"/></animateMotion></g></svg><div class="cur-mcap"><span class="cur-num">03</span><b>Parallax-slide</b><span>Zijwaarts, diepte</span></div></div>
        <div class="cur-mcard"><svg class="cur-scene" viewBox="0 0 220 120" aria-hidden="true"><rect x="92" y="54" width="36" height="34" rx="4" fill="#15564a"/><path id="curp4" d="M110 104 V22" fill="none" stroke="#2fb8c4" stroke-width="1.5" stroke-dasharray="3 4" opacity=".7"/><g><circle class="cur-dronef" r="4"/><animateMotion dur="3s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;.75;1" calcMode="linear"><mpath href="#curp4"/></animateMotion></g></svg><div class="cur-mcap"><span class="cur-num">04</span><b>Top-down</b><span>Recht omhoog</span></div></div>
        <div class="cur-mcard"><svg class="cur-scene" viewBox="0 0 220 120" aria-hidden="true"><path d="M0 96 H220" stroke="#1d6e5f" stroke-width="2"/><g><circle r="6" fill="#15564a"/><animateMotion dur="4s" repeatCount="indefinite" path="M20 84 H200"/></g><g><circle class="cur-dronef" r="4"/><animateMotion dur="4s" repeatCount="indefinite" path="M-6 66 H174"/></g></svg><div class="cur-mcap"><span class="cur-num">05</span><b>Tracking shot</b><span>Volgen van achter</span></div></div>
        <div class="cur-mcard cur-windrow">
          <svg width="110" height="110" viewBox="0 0 110 110" aria-hidden="true"><circle cx="55" cy="55" r="50" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="2"/><text x="55" y="16" text-anchor="middle" fill="#9fb7bd" font-size="10" font-family="monospace">N</text><text x="98" y="59" text-anchor="middle" fill="#9fb7bd" font-size="10" font-family="monospace">O</text><text x="55" y="103" text-anchor="middle" fill="#9fb7bd" font-size="10" font-family="monospace">Z</text><text x="12" y="59" text-anchor="middle" fill="#9fb7bd" font-size="10" font-family="monospace">W</text><g class="cur-needle"><polygon points="55,14 61,57 49,57" fill="#FF6B5E"/><polygon points="55,96 61,57 49,57" fill="#e7e6ea"/><circle cx="55" cy="57" r="5" fill="#0e1116" stroke="#fff" stroke-width="2"/></g></svg>
          <div><span class="cur-num">let op</span><br><b class="cur-windh">Passaatwind — bijna altijd uit het (noord)oosten</b><p class="cur-windp">Sterker bij de kliffen en open stranden. Lichte drones worden zo de zee op geblazen — check wind &amp; windstoten, en vlieg met de neus tegen de wind.</p></div>
        </div>
      </div>
    </div></section>

    <!-- ============ CLOSE / SOURCES ============ -->
    <section class="cur-sec cur-close"><div class="cur-wrap">
      <span class="cur-kick">lichtbreking</span>
      <h2 class="cur-h2">Vlieg veilig. Film cinematisch.</h2>
      <p class="cur-lead" style="margin-bottom:18px">Meer gratis gidsen, cursussen &amp; tools vind je elders op de site. Heb je zelf mooie Curaçao-beelden geschoten? Tag <b>@lichtbreking</b> — wie weet komen ze in deze gids.</p>
      <div class="cur-cta">
        <a class="cur-btn" id="curPdf" href="/curacao/deelbaar/">⬇︎ Deelbare gids (PDF) voor Instagram</a>
        <a class="cur-btn cur-btn--ghost" id="curVeld" href="/curacao/veldkaart/">🗺️ Print-veldkaart (A4)</a>
        <a class="cur-btn cur-btn--ghost" href="/gouden-uur/">Plan het gouden uur</a>
      </div>
      <p class="cur-disc">Informatief, met zorg samengesteld op basis van openbare bronnen (juni 2026). Regelgeving op Curaçao kan wijzigen — bevestig de actuele regels en no-fly-zones altijd bij de CCAA vóór je vliegt.</p>
      <p class="cur-src">Bronnen: Regulatory Authority of Curaçao (RAC) · Curaçao Civil Aviation Authority (CCAA) · Curaçao Film Commission.</p>
    </div></section>

  </main>
  <Footer />
</Base>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style is:global>
  .cur-page{ --night:#08080A; --bone:#F4F1EA; --mist:#AEB0B6; --gold:#E7C98F;
    --green:#46C95F; --orange:#FF9A2E; --red:#FF6B5E; --teal:#2FB8C4; --sky:#7FB2FF;
    --spectrum:linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB);
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
    background:var(--night); color:var(--bone); line-height:1.55; overflow-x:hidden; }
  .cur-page :is(h1,h2,h3){ font-family:var(--lb-font-display,inherit); }
  .cur-wrap{ max-width:1080px; margin:0 auto; padding:0 18px; }
  .cur-kick{ font-family:var(--mono); letter-spacing:.22em; text-transform:uppercase; font-size:12px; color:var(--gold); }
  .cur-h2{ font-size:clamp(26px,4.4vw,42px); font-weight:800; text-transform:uppercase; letter-spacing:-.01em; margin:8px 0 6px; line-height:1; color:var(--bone); }
  .cur-lead{ color:var(--mist); font-size:14.5px; margin:0 0 22px; max-width:62ch; }
  .cur-sec{ position:relative; padding:46px 0; }

  /* COVER */
  .cur-cover{ position:relative; height:100vh; min-height:560px; overflow:hidden; }
  .cur-bg{ position:absolute; inset:-4%; background:url('https://images.unsplash.com/photo-1753618282728-f05ecfc5c9d6?w=1900&q=78&auto=format&fit=crop') center/cover; animation:cur-ken 24s ease-in-out infinite alternate; }
  @keyframes cur-ken{0%{transform:scale(1.03)}100%{transform:scale(1.16) translate(-2%,-2%)}}
  .cur-scrim{ position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.5),rgba(0,0,0,.05) 30%,rgba(6,12,16,.95)); }
  .cur-cover-in{ position:relative; z-index:2; height:100%; display:flex; flex-direction:column; justify-content:flex-end; padding:0 clamp(20px,6vw,70px) clamp(40px,6vw,76px); }
  .cur-cover-in .cur-kick{ opacity:0; animation:cur-rise .9s .2s forwards; color:#ffe6b8; }
  .cur-h1{ font-size:clamp(48px,12vw,150px); line-height:.9; font-weight:800; text-transform:uppercase; letter-spacing:-.02em; margin:8px 0 4px; text-shadow:0 6px 50px rgba(0,0,0,.45); color:#fff; }
  .cur-h1 span{ display:block; opacity:0; animation:cur-rise 1s forwards; }
  .cur-h1 span:nth-child(1){ animation-delay:.35s } .cur-h1 span:nth-child(2){ animation-delay:.5s }
  .cur-rule{ height:3px; width:200px; border-radius:3px; background:var(--spectrum); transform-origin:left; transform:scaleX(0); animation:cur-grow 1.1s .6s forwards; margin:16px 0; }
  .cur-meta{ display:flex; gap:22px; flex-wrap:wrap; font-family:var(--mono); font-size:12.5px; color:#eaf1f4; opacity:0; animation:cur-rise 1s .85s forwards; }
  .cur-meta b{ color:var(--gold); }
  .cur-dronefly{ position:absolute; top:16%; right:11%; z-index:2; color:#fff; animation:cur-float 5s ease-in-out infinite; }
  @keyframes cur-float{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-16px) rotate(3deg)}}
  @keyframes cur-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  @keyframes cur-grow{to{transform:scaleX(1)}}

  /* RULES */
  .cur-rules{ padding-top:54px; }
  .cur-rgrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .cur-rc{ position:relative; background:rgba(20,22,28,.5); border-radius:14px; padding:16px; text-align:center; box-shadow:inset 0 1px 0 rgba(255,255,255,.12); }
  .cur-rc svg{ color:var(--gold); }
  .cur-rc b{ display:block; margin-top:8px; font-size:15px; }
  .cur-rc span{ font-size:12px; color:var(--mist); }
  .cur-reg{ margin-top:12px; border-radius:14px; padding:13px 16px; background:rgba(255,90,80,.12); border-left:4px solid var(--red); font-size:13.5px; }
  .cur-reg b{ color:#ffd2cd; }

  /* MAP */
  .cur-legend{ display:flex; gap:15px; font-size:12.5px; color:var(--mist); flex-wrap:wrap; align-items:center; margin:6px 0 14px; }
  .cur-legend i{ width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:5px; vertical-align:middle; }
  .cur-legend i.sq{ border-radius:4px; }
  .cur-legend-hint{ margin-left:auto; color:#7f8085; }
  .cur-stage{ display:grid; grid-template-columns:1.7fr 1fr; gap:18px; align-items:stretch; }
  .cur-mapbox{ position:relative; }
  #curMap{ height:560px; border-radius:20px; overflow:hidden; background:#0b1a1f; box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 20px 50px rgba(0,0,0,.4); position:relative; z-index:1; }
  .cur-mapbox::after{ content:""; position:absolute; inset:0; border-radius:20px; padding:1.3px; background:var(--spectrum); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.4; pointer-events:none; z-index:500; }
  .cur-panel{ position:relative; border-radius:18px; overflow:hidden; min-height:400px; background:#0e1116; box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 16px 44px rgba(0,0,0,.34); display:flex; flex-direction:column; }
  .cur-ph{ position:relative; flex:1; background-size:cover; background-position:center; }
  .cur-ph::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent 38%,rgba(8,8,10,.86)); }
  .cur-ph.empty{ background:linear-gradient(135deg,#0c2d33,#103e3a); display:grid; place-items:center; }
  .cur-ph.empty span{ position:relative; z-index:2; color:var(--mist); font-size:13px; text-align:center; padding:0 22px; }
  .cur-houses{ position:absolute; left:0; right:0; bottom:38%; display:flex; height:46%; z-index:1; }
  .cur-houses i{ flex:1; border-radius:6px 6px 0 0; margin:0 1px; }
  .cur-pbody{ position:relative; z-index:2; padding:14px 16px 16px; margin-top:-86px; }
  .cur-badge{ display:inline-block; font-family:var(--mono); font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; padding:3px 9px; border-radius:20px; margin-bottom:7px; }
  .cur-badge.fly{ color:#bfeccf; background:rgba(70,201,95,.22) } .cur-badge.care{ color:#ffd9a8; background:rgba(255,154,46,.22) } .cur-badge.no{ color:#ffc7c1; background:rgba(255,90,80,.24) } .cur-badge.pocket{ color:#dcc0ff; background:rgba(155,77,219,.26) }
  .cur-pbody h3{ margin:0 0 4px; font-size:19px; color:var(--bone); }
  .cur-pbody p{ margin:0; color:#d7d6dc; font-size:13.5px; }
  .cur-mapnote{ color:var(--mist); font-size:12px; margin-top:10px; }

  /* filters + zoeken */
  .cur-filters{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:0 0 14px; }
  .cur-fbtn{ appearance:none; cursor:pointer; font-family:inherit; font-size:12.5px; font-weight:600; color:var(--bone); background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:7px 14px; transition:background .2s,border-color .2s; }
  .cur-fbtn:hover{ background:rgba(255,255,255,.12); }
  .cur-fbtn.on{ color:#06231f; background:var(--gold); border-color:transparent; }
  .cur-search{ flex:1; min-width:160px; font-family:inherit; font-size:13px; color:var(--bone); background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:8px 14px; }
  .cur-search::placeholder{ color:var(--mist); }
  .cur-search:focus{ outline:none; border-color:var(--gold); }

  /* panel-chips: licht/wind/move */
  .cur-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .cur-chip{ font-size:11.5px; color:#dfe2e6; background:rgba(255,255,255,.08); border-radius:8px; padding:4px 8px; line-height:1.3; }
  .cur-chip b{ color:var(--gold); font-weight:600; margin-right:2px; }

  /* vooraf-stappen */
  .cur-steps{ list-style:none; margin:18px 0 0; padding:0; display:grid; gap:12px; max-width:760px; }
  .cur-steps li{ display:flex; gap:14px; align-items:flex-start; background:rgba(20,22,28,.5); border-radius:14px; padding:15px 16px; box-shadow:inset 0 1px 0 rgba(255,255,255,.1); }
  .cur-stepn{ flex:0 0 auto; width:28px; height:28px; border-radius:50%; display:grid; place-items:center; font-family:var(--mono); font-weight:700; font-size:13px; color:#06231f; background:var(--gold); }
  .cur-steps b{ display:block; font-size:15px; margin-bottom:2px; }
  .cur-steps p{ margin:0; color:var(--mist); font-size:13px; }
  .cur-fineprint{ color:var(--mist); font-size:12px; margin-top:14px; opacity:.85; }
  .cur-page .leaflet-container{ background:#0b1a1f; font-family:inherit; }
  .cur-page .leaflet-popup-content-wrapper,.cur-page .leaflet-popup-tip{ background:#14171c; color:#fff; }
  .cur-page .leaflet-tooltip{ background:#14171c; color:#fff; border:none; box-shadow:0 4px 14px rgba(0,0,0,.4); }
  .cur-page .leaflet-tooltip-top:before{ border-top-color:#14171c; }

  /* SETTINGS */
  .cur-two{ display:grid; grid-template-columns:1fr 1fr; gap:18px; align-items:start; }
  .cur-card{ position:relative; border-radius:20px; background:rgba(20,22,28,.55); box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 16px 40px rgba(0,0,0,.3); padding:18px; }
  .cur-card::after{ content:""; position:absolute; inset:0; border-radius:inherit; padding:1.2px; background:var(--spectrum); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.32; pointer-events:none; }
  .cur-prev{ position:relative; height:230px; border-radius:14px; overflow:hidden; }
  .cur-previmg{ position:absolute; inset:0; background:url('https://images.unsplash.com/photo-1753618282728-f05ecfc5c9d6?w=1100&q=78&auto=format&fit=crop') center/cover; }
  .cur-ndtint{ position:absolute; inset:0; background:#0a1418; opacity:.16; }
  .cur-ndlabel{ position:absolute; top:12px; right:12px; z-index:3; font-family:var(--mono); font-weight:700; font-size:19px; color:#06231f; background:var(--gold); padding:6px 12px; border-radius:11px; }
  .cur-verdict{ position:absolute; left:12px; bottom:12px; z-index:3; font-family:var(--mono); font-size:11.5px; padding:6px 11px; border-radius:20px; color:#bfeccf; background:rgba(70,201,95,.22); }
  .cur-sl{ margin:16px 4px 2px; }
  .cur-sl label{ display:flex; justify-content:space-between; font-family:var(--mono); font-size:11px; letter-spacing:.06em; color:var(--mist); text-transform:uppercase; margin-bottom:7px; }
  .cur-sl input[type=range]{ width:100%; accent-color:var(--gold); }
  .cur-dials{ display:flex; gap:12px; align-items:center; }
  .cur-shutter{ width:96px; height:96px; flex:0 0 auto; }
  .cur-shutter svg{ width:100%; height:100%; animation:cur-spin 2.6s linear infinite; }
  @keyframes cur-spin{to{transform:rotate(360deg)}}
  .cur-dlab{ font-family:var(--mono); font-size:11px; color:var(--mist); }
  .cur-dval{ font-size:22px; font-weight:800; color:var(--gold); }
  .cur-mini{ display:flex; gap:8px; }
  .cur-mini div{ flex:1; background:rgba(127,127,140,.12); border-radius:12px; padding:10px 4px; text-align:center; }
  .cur-mini b{ display:block; font-size:17px; } .cur-mini span{ font-family:var(--mono); font-size:9.5px; color:var(--mist); letter-spacing:.05em; text-transform:uppercase; }
  .cur-cardnote{ color:var(--mist); font-size:12.5px; margin:12px 0 0; }

  /* MOVES */
  .cur-mgrid{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .cur-mcard{ position:relative; border-radius:16px; overflow:hidden; background:rgba(20,22,28,.55); box-shadow:inset 0 1px 0 rgba(255,255,255,.12); }
  .cur-scene{ display:block; width:100%; background:linear-gradient(180deg,#0c2230,#0a1820); }
  .cur-mcap{ padding:9px 12px 12px; } .cur-mcap b{ font-size:14px; display:block; color:var(--bone); } .cur-mcap span{ font-size:11.5px; color:var(--mist); }
  .cur-num{ font-family:var(--mono); font-size:10.5px; color:var(--gold); letter-spacing:.1em; }
  .cur-dronef{ fill:#fff; }
  .cur-windrow{ grid-column:span 3; display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:center; padding:16px; }
  .cur-needle{ transform-origin:55px 55px; animation:cur-sway 4s ease-in-out infinite; }
  @keyframes cur-sway{0%,100%{transform:rotate(42deg)}50%{transform:rotate(50deg)}}
  .cur-windh{ font-size:16px; color:var(--bone); } .cur-windp{ color:var(--mist); font-size:12.5px; margin:4px 0 0; }

  /* CLOSE */
  .cur-close{ text-align:center; padding-bottom:64px; }
  .cur-close .cur-lead{ margin-left:auto; margin-right:auto; }
  .cur-cta{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
  .cur-btn{ display:inline-block; padding:.8rem 1.3rem; border-radius:999px; font-weight:600; font-size:.95rem; text-decoration:none; color:#06231f; background:var(--gold); transition:transform .25s ease; }
  .cur-btn--ghost{ color:var(--bone); background:rgba(255,255,255,.08); box-shadow:inset 0 0 0 1px rgba(255,255,255,.18); }
  .cur-btn:hover{ transform:translateY(-2px); }
  .cur-disc{ font-size:12px; color:var(--mist); max-width:70ch; margin:22px auto 0; opacity:.85; }
  .cur-src{ font-size:11.5px; color:var(--mist); margin-top:8px; }

  @media(max-width:820px){
    .cur-rgrid{ grid-template-columns:1fr 1fr; }
    .cur-stage{ grid-template-columns:1fr; } #curMap{ height:440px; }
    .cur-two{ grid-template-columns:1fr; }
    .cur-mgrid{ grid-template-columns:1fr 1fr; } .cur-windrow{ grid-column:span 2; }
  }
  @media(prefers-reduced-motion:reduce){
    .cur-bg,.cur-dronefly,.cur-needle,.cur-shutter svg{ animation:none; }
    .cur-h1 span,.cur-cover-in .cur-kick,.cur-meta,.cur-rule{ animation:none; opacity:1; transform:none; }
  }
</style>

<script define:vars={{ CURSPOTS: curacaoSpots }}>window.CURSPOTS = CURSPOTS;</script>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
(function(){
  function init(){
    if(!window.L){ return setTimeout(init,120); }
    var U=function(id){ return 'https://images.unsplash.com/photo-'+id+'?w=900&q=72&auto=format&fit=crop'; };
    var COL={fly:'#46C95F',care:'#FF9A2E',no:'#FF6B5E'};
    var spots = window.CURSPOTS || [];

    var map=L.map('curMap',{zoomControl:true,scrollWheelZoom:false,attributionControl:true}).setView([12.18,-68.98],11);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{maxZoom:19,attribution:'© OpenStreetMap, © CARTO'}).addTo(map);

    var ph=document.getElementById('curPh'), pbody=document.getElementById('curPbody'), chips=document.getElementById('curChips');
    function chip(label,val){ return '<span class="cur-chip"><b>'+label+'</b> '+val+'</span>'; }
    function render(s){
      pbody.style.display='block';
      document.getElementById('curPname').textContent=s.n;
      document.getElementById('curPtip').textContent=s.tip;
      var b=document.getElementById('curBadge'); b.className='cur-badge '+s.t;
      b.textContent = s.t==='fly'?'Drone-top · go':(s.t==='care'?'Drone · met beleid':(s.t==='pocket'?'Pocket 4 · grond':'No-fly · verboden'));
      var c='';
      if(s.light && s.light!=='—') c+=chip('☀︎',s.light);
      if(s.wind && s.wind!=='—') c+=chip('💨',s.wind);
      if(s.move && s.move!=='Niet vliegen') c+=chip('🎬',s.move);
      chips.innerHTML=c;
      ph.classList.remove('empty');
      if(s.img && s.img.indexOf('grad:')===0){ ph.style.background=s.img.slice(5); ph.innerHTML=''; }
      else if(s.img){ ph.style.background="url('"+U(s.img)+"') center/cover"; ph.innerHTML=''; }
      else { ph.style.background='linear-gradient(135deg,#3a1416,#5a1d1d)'; ph.innerHTML='<div style="position:absolute;inset:0;display:grid;place-items:center;color:#ffb4ad;font-size:34px;z-index:2">⛔</div>'; }
    }
    var pIcon=L.divIcon({className:'',iconSize:[18,18],iconAnchor:[9,9],html:'<div style="width:16px;height:16px;border-radius:5px;background:#9B4DDB;border:2px solid #2a0f3d;box-shadow:0 0 0 1px rgba(255,255,255,.25);display:grid;place-items:center"><span style="width:5px;height:5px;border-radius:50%;background:#fff;display:block"></span></div>'});
    var entries=[];
    spots.forEach(function(s){
      var m;
      if(s.t==='pocket'){ m=L.marker(s.ll,{icon:pIcon}); }
      else { m=L.circleMarker(s.ll,{radius:8,weight:2,color:'#06231f',fillColor:COL[s.t],fillOpacity:.95}); }
      m.bindTooltip(s.n,{direction:'top',offset:[0,-6]});
      m.on('mouseover',function(){render(s);}); m.on('click',function(){render(s);});
      m.addTo(map);
      entries.push({s:s,m:m,on:true});
    });

    /* ====== filters + zoeken ====== */
    var curCat='all', curQ='';
    function applyFilter(){
      var vis=[];
      entries.forEach(function(e){
        var ok=(curCat==='all'||e.s.t===curCat) && (!curQ || e.s.n.toLowerCase().indexOf(curQ)>=0);
        if(ok && !e.on){ e.m.addTo(map); e.on=true; }
        else if(!ok && e.on){ map.removeLayer(e.m); e.on=false; }
        if(ok) vis.push(e.s.ll);
      });
      if(vis.length){ map.fitBounds(L.latLngBounds(vis),{padding:[28,28],maxZoom:14}); }
    }
    var fbtns=document.querySelectorAll('.cur-fbtn');
    fbtns.forEach(function(btn){ btn.addEventListener('click',function(){
      fbtns.forEach(function(b){ b.classList.remove('on'); }); btn.classList.add('on');
      curCat=btn.getAttribute('data-f'); applyFilter();
    }); });
    var search=document.getElementById('curSearch');
    if(search){ search.addEventListener('input',function(){ curQ=search.value.trim().toLowerCase(); applyFilter(); }); }

    function fitIsland(){ map.fitBounds(L.latLngBounds(spots.map(function(s){return s.ll;})),{padding:[28,28]}); }
    fitIsland();
    map.on('resize',function(){ if(curCat==='all'&&!curQ) fitIsland(); });

    /* ====== ND-simulator ====== */
    var steps=[{name:'Bewolkt',nd:'ND8',tint:.07},{name:'Zonnig',nd:'ND16',tint:.16},{name:'Felle zon',nd:'ND32',tint:.30},{name:'Wit zand',nd:'ND64',tint:.44}];
    var light=document.getElementById('curLight');
    function updL(){var s=steps[+light.value];document.getElementById('curLname').textContent=s.name;document.getElementById('curNdlabel').textContent=s.nd;document.getElementById('curNdtint').style.opacity=s.tint;document.getElementById('curVerdict').textContent='Mooi belicht met '+s.nd+' ✓';}
    if(light){ light.addEventListener('input',updL); updL(); }

    /* ====== PDF-download analytics ====== */
    var pdf=document.getElementById('curPdf');
    if(pdf){ pdf.addEventListener('click',function(){ try{ if(window.va) window.va('event',{name:'pdf_download',page:'curacao'}); }catch(e){} }); }
    var veld=document.getElementById('curVeld');
    if(veld){ veld.addEventListener('click',function(){ try{ if(window.va) window.va('event',{name:'veldkaart_open',page:'curacao'}); }catch(e){} }); }
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',init); } else { init(); }
})();
</script>
