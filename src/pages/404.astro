---
import Base from '../layouts/Base.astro';
---
<Base titel="Pagina niet gevonden" noindex={true}>
  <div class="lb-404">
    <div>
      <h1>404</h1>
      <div class="lb-rule lb-rule--kort" style="margin:0 auto 18px"></div>
      <p style="color:var(--lb-ink-55);max-width:44ch;margin:0 auto 26px;line-height:1.7">
        Deze pagina bestaat niet meer. De site is opnieuw opgebouwd, dus oude links kunnen
        doodlopen.
      </p>
      <a class="lb-knop" href="/">Naar het beeld</a>
    </div>
  </div>
</Base>
