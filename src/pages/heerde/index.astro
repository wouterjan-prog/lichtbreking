---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { heerdeSpots } from '../../data/heerdespots.js';
---
<Base
  title="Drone rond Heerde & de Veluwe — waar mag het?"
  description="Eerlijke gids voor dronevliegen rond Heerde, de Veluwe en de IJssel: waar het wél mag (open boerenland, kanaal), waar niet (Natura 2000), met een exacte kaart, filters en de regels op een rij."
  path="/heerde/" image="/img/og-heerde.png">
  <GlassNav active="spots" switchHref="/en/cursussen/" hero />

  <main id="hoofdinhoud" tabindex="-1" class="hr-page">

    <!-- COVER -->
    <section class="hr-cover">
      <div class="hr-bg"></div><div class="hr-scrim"></div>
      <svg class="hr-dronefly" width="86" height="44" viewBox="0 0 92 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <ellipse cx="18" cy="12" rx="13" ry="3.4" opacity=".85"/><ellipse cx="74" cy="12" rx="13" ry="3.4" opacity=".85"/>
        <line x1="18" y1="14" x2="34" y2="26"/><line x1="74" y1="14" x2="58" y2="26"/><rect x="34" y="24" width="24" height="12" rx="4"/><circle cx="46" cy="30" r="2.2" fill="#fff" stroke="none"/>
      </svg>
      <div class="hr-cover-in">
        <span class="hr-kick">De lokale gids · lichtbreking</span>
        <h1 class="hr-h1"><span>Drone rond</span><span>Heerde</span></h1>
        <div class="hr-rule"></div>
        <div class="hr-meta"><span><b>3</b> plekken waar het mag</span><span><b>4</b> Pocket-spots</span><span><b>Veluwe</b> = beschermd</span></div>
      </div>
    </section>

    <!-- REGELS -->
    <section class="hr-sec hr-rules"><div class="hr-wrap">
      <span class="hr-kick">Voor je vliegt</span>
      <h2 class="hr-h2">De regels — kort</h2>
      <div class="hr-rgrid">
        <div class="hr-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4"/><rect x="4" y="3" width="16" height="18" rx="2"/></svg><b>Registreer (RDW)</b><span>≥250 g of camera</span></div>
        <div class="hr-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20V8M12 8l-4 4M12 8l4 4M4 4h16"/></svg><b>Max 120 m</b><span>en in zicht (VLOS)</span></div>
        <div class="hr-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21s2-6 9-6 9 6 9 6"/><circle cx="12" cy="7" r="4"/></svg><b>50 m</b><span>van mensen</span></div>
        <div class="hr-rc"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg><b>Niet boven Natura 2000</b><span>Veluwe & IJssel</span></div>
      </div>
      <div class="hr-reg"><b>Let op:</b> de Veluwe (bos &amp; heide) en grote delen van de IJssel-uiterwaarden zijn <b>Natura 2000</b> — daar is dronevliegen verboden (boetes tot €800). Vlieg op open boerenland buiten die gebieden, met de gewone EU-regels. Lees ook de <a href="/artikelen/drone-regels-nederland-eu/">drone-regels NL &amp; EU</a>.</div>
    </div></section>

    <!-- MAP -->
    <section class="hr-sec hr-map-sec"><div class="hr-wrap">
      <span class="hr-kick">Heerde &amp; omstreken · de kaart</span>
      <h2 class="hr-h2">Waar mag je vliegen?</h2>
      <div class="hr-legend">
        <span><i style="background:#46C95F"></i>Mag (met de regels)</span>
        <span><i style="background:#FF9A2E"></i>Met beleid</span>
        <span><i style="background:#FF6B5E"></i>Niet (Natura 2000)</span>
        <span><i class="sq" style="background:#9B4DDB"></i>Pocket 4 (grond)</span>
        <span class="hr-legend-hint">klik of beweeg over een marker</span>
      </div>
      <div class="hr-filters" id="hrFilters">
        <button class="hr-fbtn on" data-f="all" type="button">Alles</button>
        <button class="hr-fbtn" data-f="fly" type="button">Mag</button>
        <button class="hr-fbtn" data-f="care" type="button">Met beleid</button>
        <button class="hr-fbtn" data-f="no" type="button">Niet</button>
        <button class="hr-fbtn" data-f="pocket" type="button">Pocket 4</button>
        <input class="hr-search" id="hrSearch" type="search" placeholder="Zoek een plek…" aria-label="Zoek een plek" autocomplete="off" />
      </div>
      <div class="hr-stage">
        <div class="hr-mapbox"><div id="hrMap"></div></div>
        <div class="hr-panel">
          <div class="hr-ph empty" id="hrPh"><span>Kies een plek op de kaart<br>voor een beeld &amp; tip</span></div>
          <div class="hr-pbody" id="hrPbody" style="display:none"><span class="hr-badge" id="hrBadge"></span><h3 id="hrPname"></h3><p id="hrPtip"></p><div class="hr-chips" id="hrChips"></div></div>
        </div>
      </div>
      <p class="hr-mapnote">Kaartdata © OpenStreetMap-bijdragers, tegels © CARTO. Markers staan op hun werkelijke GPS-coördinaten (benaderingen). De exacte Natura 2000-grenzen check je vooraf — zie hieronder.</p>
    </div></section>

    <!-- LEGAAL -->
    <section class="hr-sec"><div class="hr-wrap">
      <span class="hr-kick">Voor je opstijgt</span>
      <h2 class="hr-h2">Zo blijf je legaal</h2>
      <p class="hr-lead">In dit gebied zit veel beschermde natuur dicht op elkaar. Met deze stappen weet je zeker dat je goed zit.</p>
      <ol class="hr-steps">
        <li><span class="hr-stepn">1</span><div><b>Registreer je en haal je bewijs</b><p>Drone van 250 g of zwaarder, of met camera? Registreer je als exploitant bij de RDW en haal het EU-vliegbewijs A1/A3.</p></div></li>
        <li><span class="hr-stepn">2</span><div><b>Check Natura 2000</b><p>De Veluwe en grote delen van de IJssel-uiterwaarden zijn Natura 2000 — daar mag je niet vliegen. Controleer de exacte grenzen vooraf (de beheerplannen staan bij BIJ12).</p></div></li>
        <li><span class="hr-stepn">3</span><div><b>Check de no-fly-kaart</b><p>Kijk op de officiële drone-no-fly-kaart voor luchthavens, CTR’s en militaire laagvliegroutes (die lopen ook over de Veluwe). Bij twijfel: niet vliegen.</p></div></li>
        <li><span class="hr-stepn">4</span><div><b>Blijf weg van mensen</b><p>Houd 50 m afstand van mensen, blijf onder 120 m, in zicht, en respecteer privacy bij woningen en recreatie.</p></div></li>
      </ol>
      <p class="hr-fineprint">Regelgeving en gebiedsgrenzen kunnen wijzigen — bevestig de actuele situatie altijd vóór je vliegt. Dit is informatief, geen officieel advies.</p>
    </div></section>

    <!-- INSTELLINGEN-LINK -->
    <section class="hr-sec"><div class="hr-wrap">
      <span class="hr-kick">Instellingen &amp; techniek</span>
      <h2 class="hr-h2">Zacht Hollands licht — zelfde basis</h2>
      <p class="hr-lead">Het Nederlandse licht is vaak zachter dan in de tropen, maar de basis blijft: ND-filter om op 1/50 s te blijven, witbalans handmatig vast en scherpte op −1. Het gouden uur en de mist net na zonsopkomst geven hier de mooiste beelden.</p>
      <div class="hr-cta">
        <a class="hr-btn" href="/gereedschap/">ND-calculator &amp; Pro-cheatsheet →</a>
        <a class="hr-btn hr-btn--ghost" href="/heerde/veldkaart/">🗺️ Print-veldkaart (A4)</a>
        <a class="hr-btn hr-btn--ghost" href="/gouden-uur/">Plan het gouden uur</a>
      </div>
    </div></section>

    <!-- SOURCES -->
    <section class="hr-sec hr-close"><div class="hr-wrap">
      <span class="hr-kick">lichtbreking</span>
      <h2 class="hr-h2">Vlieg veilig. Film cinematisch.</h2>
      <p class="hr-disc">Met zorg samengesteld op basis van openbare bronnen (juni 2026). Natura 2000-grenzen en regels kunnen wijzigen — bevestig altijd de actuele situatie en de exacte gebiedsgrenzen vóór je vliegt.</p>
      <p class="hr-src">Bronnen: Rijksoverheid (drone-regels) · BIJ12 / provinciale beheerplannen Natura 2000 · officiële drone-no-fly-kaart.</p>
    </div></section>

  </main>
  <Footer />
</Base>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style is:global>
  .hr-page{ --night:#08080A; --bone:#F4F1EA; --mist:#AEB0B6; --gold:#E7C98F;
    --green:#46C95F; --orange:#FF9A2E; --red:#FF6B5E; --sky:#7FB2FF;
    --spectrum:linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB);
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
    background:var(--night); color:var(--bone); line-height:1.55; overflow-x:hidden; }
  .hr-page :is(h1,h2,h3){ font-family:var(--lb-font-display,inherit); }
  .hr-wrap{ max-width:1080px; margin:0 auto; padding:0 18px; }
  .hr-kick{ font-family:var(--mono); letter-spacing:.22em; text-transform:uppercase; font-size:12px; color:var(--gold); }
  .hr-h2{ font-size:clamp(26px,4.4vw,42px); font-weight:800; text-transform:uppercase; letter-spacing:-.01em; margin:8px 0 6px; line-height:1; color:var(--bone); }
  .hr-lead{ color:var(--mist); font-size:14.5px; margin:0 0 22px; max-width:62ch; }
  .hr-sec{ position:relative; padding:46px 0; }

  .hr-cover{ position:relative; height:100vh; min-height:560px; overflow:hidden; }
  .hr-bg{ position:absolute; inset:-4%; background:url('https://images.unsplash.com/photo-1704217392934-0fd66d250056?w=1900&q=78&auto=format&fit=crop') center/cover; animation:hr-ken 24s ease-in-out infinite alternate; }
  @keyframes hr-ken{0%{transform:scale(1.03)}100%{transform:scale(1.16) translate(-2%,-2%)}}
  .hr-scrim{ position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.5),rgba(0,0,0,.08) 30%,rgba(6,12,16,.95)); }
  .hr-cover-in{ position:relative; z-index:2; height:100%; display:flex; flex-direction:column; justify-content:flex-end; padding:0 clamp(20px,6vw,70px) clamp(40px,6vw,76px); }
  .hr-cover-in .hr-kick{ opacity:0; animation:hr-rise .9s .2s forwards; color:#ffe6b8; text-shadow:0 1px 10px rgba(0,0,0,.75),0 1px 2px rgba(0,0,0,.6); }
  .hr-h1{ font-size:clamp(48px,12vw,150px); line-height:.9; font-weight:800; text-transform:uppercase; letter-spacing:-.02em; margin:8px 0 4px; text-shadow:0 6px 50px rgba(0,0,0,.45); color:#fff; }
  .hr-h1 span{ display:block; opacity:0; animation:hr-rise 1s forwards; }
  .hr-h1 span:nth-child(1){ animation-delay:.35s } .hr-h1 span:nth-child(2){ animation-delay:.5s }
  .hr-rule{ height:3px; width:200px; border-radius:3px; background:var(--spectrum); transform-origin:left; transform:scaleX(0); animation:hr-grow 1.1s .6s forwards; margin:16px 0; }
  .hr-meta{ display:flex; gap:22px; flex-wrap:wrap; font-family:var(--mono); font-size:12.5px; color:#eaf1f4; opacity:0; animation:hr-rise 1s .85s forwards; text-shadow:0 1px 8px rgba(0,0,0,.7); }
  .hr-meta b{ color:var(--gold); }
  .hr-dronefly{ position:absolute; top:16%; right:11%; z-index:2; color:#fff; animation:hr-float 5s ease-in-out infinite; }
  @keyframes hr-float{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-16px) rotate(3deg)}}
  @keyframes hr-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  @keyframes hr-grow{to{transform:scaleX(1)}}

  .hr-rules{ padding-top:54px; }
  .hr-rgrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .hr-rc{ position:relative; background:rgba(20,22,28,.5); border-radius:14px; padding:16px; text-align:center; box-shadow:inset 0 1px 0 rgba(255,255,255,.12); }
  .hr-rc svg{ color:var(--gold); }
  .hr-rc b{ display:block; margin-top:8px; font-size:15px; }
  .hr-rc span{ font-size:12px; color:var(--mist); }
  .hr-reg{ margin-top:12px; border-radius:14px; padding:13px 16px; background:rgba(255,90,80,.12); border-left:4px solid var(--red); font-size:13.5px; }
  .hr-reg b{ color:#ffd2cd; } .hr-reg a{ color:var(--sky); }

  .hr-legend{ display:flex; gap:15px; font-size:12.5px; color:var(--mist); flex-wrap:wrap; align-items:center; margin:6px 0 14px; }
  .hr-legend i{ width:10px; height:10px; border-radius:50%; display:inline-block; margin-right:5px; vertical-align:middle; }
  .hr-legend i.sq{ border-radius:4px; }
  .hr-legend-hint{ margin-left:auto; color:#7f8085; }
  .hr-filters{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:0 0 14px; }
  .hr-fbtn{ appearance:none; cursor:pointer; font-family:inherit; font-size:12.5px; font-weight:600; color:var(--bone); background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:7px 14px; }
  .hr-fbtn:hover{ background:rgba(255,255,255,.12); }
  .hr-fbtn.on{ color:#06231f; background:var(--gold); border-color:transparent; }
  .hr-search{ flex:1; min-width:160px; font-family:inherit; font-size:13px; color:var(--bone); background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:999px; padding:8px 14px; }
  .hr-search::placeholder{ color:var(--mist); } .hr-search:focus{ outline:none; border-color:var(--gold); }
  .hr-stage{ display:grid; grid-template-columns:1.7fr 1fr; gap:18px; align-items:stretch; }
  .hr-mapbox{ position:relative; }
  #hrMap{ height:560px; border-radius:20px; overflow:hidden; background:#0b1a1f; box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 20px 50px rgba(0,0,0,.4); position:relative; z-index:1; }
  .hr-mapbox::after{ content:""; position:absolute; inset:0; border-radius:20px; padding:1.3px; background:var(--spectrum); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.4; pointer-events:none; z-index:500; }
  .hr-panel{ position:relative; border-radius:18px; overflow:hidden; min-height:400px; background:#0e1116; box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 16px 44px rgba(0,0,0,.34); display:flex; flex-direction:column; }
  .hr-ph{ position:relative; flex:1; background-size:cover; background-position:center; }
  .hr-ph::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent 38%,rgba(8,8,10,.86)); }
  .hr-ph.empty{ background:linear-gradient(135deg,#2a2f1c,#3a2e10); display:grid; place-items:center; }
  .hr-ph.empty span{ position:relative; z-index:2; color:var(--mist); font-size:13px; text-align:center; padding:0 22px; }
  .hr-pbody{ position:relative; z-index:2; padding:14px 16px 16px; margin-top:-86px; }
  .hr-badge{ display:inline-block; font-family:var(--mono); font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; padding:3px 9px; border-radius:20px; margin-bottom:7px; }
  .hr-badge.fly{ color:#bfeccf; background:rgba(70,201,95,.22) } .hr-badge.care{ color:#ffd9a8; background:rgba(255,154,46,.22) } .hr-badge.no{ color:#ffc7c1; background:rgba(255,90,80,.24) } .hr-badge.pocket{ color:#dcc0ff; background:rgba(155,77,219,.26) }
  .hr-pbody h3{ margin:0 0 4px; font-size:19px; color:var(--bone); }
  .hr-pbody p{ margin:0; color:#d7d6dc; font-size:13.5px; }
  .hr-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .hr-chip{ font-size:11.5px; color:#dfe2e6; background:rgba(255,255,255,.08); border-radius:8px; padding:4px 8px; line-height:1.3; }
  .hr-chip b{ color:var(--gold); font-weight:600; margin-right:2px; }
  .hr-mapnote{ color:var(--mist); font-size:12px; margin-top:10px; }
  .hr-page .leaflet-container{ background:#0b1a1f; font-family:inherit; }
  .hr-page .leaflet-tooltip{ background:#14171c; color:#fff; border:none; box-shadow:0 4px 14px rgba(0,0,0,.4); }
  .hr-page .leaflet-tooltip-top:before{ border-top-color:#14171c; }

  .hr-steps{ list-style:none; margin:18px 0 0; padding:0; display:grid; gap:12px; max-width:760px; }
  .hr-steps li{ display:flex; gap:14px; align-items:flex-start; background:rgba(20,22,28,.5); border-radius:14px; padding:15px 16px; box-shadow:inset 0 1px 0 rgba(255,255,255,.1); }
  .hr-stepn{ flex:0 0 auto; width:28px; height:28px; border-radius:50%; display:grid; place-items:center; font-family:var(--mono); font-weight:700; font-size:13px; color:#06231f; background:var(--gold); }
  .hr-steps b{ display:block; font-size:15px; margin-bottom:2px; }
  .hr-steps p{ margin:0; color:var(--mist); font-size:13px; }
  .hr-fineprint{ color:var(--mist); font-size:12px; margin-top:14px; opacity:.85; }

  .hr-cta{ display:flex; gap:12px; flex-wrap:wrap; }
  .hr-btn{ display:inline-block; padding:.8rem 1.3rem; border-radius:999px; font-weight:600; font-size:.95rem; text-decoration:none; color:#06231f; background:var(--gold); transition:transform .25s ease; }
  .hr-btn--ghost{ color:var(--bone); background:rgba(255,255,255,.08); box-shadow:inset 0 0 0 1px rgba(255,255,255,.18); }
  .hr-btn:hover{ transform:translateY(-2px); }
  .hr-close{ text-align:center; padding-bottom:64px; }
  .hr-disc{ font-size:12px; color:var(--mist); max-width:70ch; margin:14px auto 0; opacity:.85; }
  .hr-src{ font-size:11.5px; color:var(--mist); margin-top:8px; }

  @media(max-width:820px){
    .hr-rgrid{ grid-template-columns:1fr 1fr; }
    .hr-stage{ grid-template-columns:1fr; } #hrMap{ height:440px; }
  }
  @media(prefers-reduced-motion:reduce){
    .hr-bg,.hr-dronefly{ animation:none; }
    .hr-h1 span,.hr-cover-in .hr-kick,.hr-meta,.hr-rule{ animation:none; opacity:1; transform:none; }
  }
</style>

<script define:vars={{ HRSPOTS: heerdeSpots }}>window.HRSPOTS = HRSPOTS;</script>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
(function(){
  function init(){
    if(!window.L){ return setTimeout(init,120); }
    var U=function(id){ return 'https://images.unsplash.com/photo-'+id+'?w=900&q=72&auto=format&fit=crop'; };
    var COL={fly:'#46C95F',care:'#FF9A2E',no:'#FF6B5E'};
    var spots = window.HRSPOTS || [];

    var map=L.map('hrMap',{zoomControl:true,scrollWheelZoom:false,attributionControl:true}).setView([52.41,6.04],12);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{maxZoom:19,attribution:'© OpenStreetMap, © CARTO'}).addTo(map);

    var ph=document.getElementById('hrPh'), pbody=document.getElementById('hrPbody'), chips=document.getElementById('hrChips');
    function chip(label,val){ return '<span class="hr-chip"><b>'+label+'</b> '+val+'</span>'; }
    function render(s){
      pbody.style.display='block';
      document.getElementById('hrPname').textContent=s.n;
      document.getElementById('hrPtip').textContent=s.tip;
      var b=document.getElementById('hrBadge'); b.className='hr-badge '+s.t;
      b.textContent = s.t==='fly'?'Mag · met de regels':(s.t==='care'?'Met beleid':(s.t==='pocket'?'Pocket 4 · grond':'Niet · Natura 2000'));
      var c='';
      if(s.light && s.light!=='—') c+=chip('☀︎',s.light);
      if(s.wind && s.wind!=='—') c+=chip('💨',s.wind);
      if(s.move && s.move!=='Niet vliegen') c+=chip('🎬',s.move);
      chips.innerHTML=c;
      ph.classList.remove('empty');
      if(s.img){ ph.style.background="url('"+U(s.img)+"') center/cover"; ph.innerHTML=''; }
      else { ph.style.background='linear-gradient(135deg,#3a1416,#5a1d1d)'; ph.innerHTML='<div style="position:absolute;inset:0;display:grid;place-items:center;color:#ffb4ad;font-size:34px;z-index:2">⛔</div>'; }
    }
    var pIcon=L.divIcon({className:'',iconSize:[18,18],iconAnchor:[9,9],html:'<div style="width:16px;height:16px;border-radius:5px;background:#9B4DDB;border:2px solid #2a0f3d;box-shadow:0 0 0 1px rgba(255,255,255,.25);display:grid;place-items:center"><span style="width:5px;height:5px;border-radius:50%;background:#fff;display:block"></span></div>'});
    var entries=[];
    spots.forEach(function(s){
      var m;
      if(s.t==='pocket'){ m=L.marker(s.ll,{icon:pIcon}); }
      else { m=L.circleMarker(s.ll,{radius:8,weight:2,color:'#06231f',fillColor:COL[s.t],fillOpacity:.95}); }
      m.bindTooltip(s.n,{direction:'top',offset:[0,-6]});
      m.on('mouseover',function(){render(s);}); m.on('click',function(){render(s);});
      m.addTo(map);
      entries.push({s:s,m:m,on:true});
    });

    var curCat='all', curQ='';
    function applyFilter(){
      var vis=[];
      entries.forEach(function(e){
        var ok=(curCat==='all'||e.s.t===curCat) && (!curQ || e.s.n.toLowerCase().indexOf(curQ)>=0);
        if(ok && !e.on){ e.m.addTo(map); e.on=true; }
        else if(!ok && e.on){ map.removeLayer(e.m); e.on=false; }
        if(ok) vis.push(e.s.ll);
      });
      if(vis.length){ map.fitBounds(L.latLngBounds(vis),{padding:[34,34],maxZoom:13}); }
    }
    var fbtns=document.querySelectorAll('.hr-fbtn');
    fbtns.forEach(function(btn){ btn.addEventListener('click',function(){
      fbtns.forEach(function(b){ b.classList.remove('on'); }); btn.classList.add('on');
      curCat=btn.getAttribute('data-f'); applyFilter();
    }); });
    var search=document.getElementById('hrSearch');
    if(search){ search.addEventListener('input',function(){ curQ=search.value.trim().toLowerCase(); applyFilter(); }); }

    function fitAll(){ map.fitBounds(L.latLngBounds(spots.map(function(s){return s.ll;})),{padding:[34,34]}); }
    fitAll();
    map.on('resize',function(){ if(curCat==='all'&&!curQ) fitAll(); });
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',init); } else { init(); }
})();
</script>
