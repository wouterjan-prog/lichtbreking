---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { src, srcset } from '../../data/work.js';

const courses = [
  { href: '/cursus/vluchtfilmer/', badge: 'Gratis', kicker: 'Drone · DJI Mini 5 Pro', title: 'De Vluchtfilmer', meta: '15 modules · ~6 uur', desc: 'Leer je drone filmen, niet alleen vliegen. Van eerste opstart tot afgemonteerde cinematische film — met shot-recepten, beslisbomen en een veldgids.', photo: '1507525428034-b723cf961d3e', soon: false },
  { href: '/cursus/grondfilmer/', badge: 'Gratis', kicker: 'Camera · DJI Osmo Pocket 4', title: 'De Grondfilmer', meta: '12 modules · veldgids', desc: 'De beelden op ooghoogte die je drone compleet maken. Cinematische gimbal-techniek en hoe je lucht en grond samensmelt tot één film.', photo: '1753588296403-be438eb432e5', soon: false },
  { href: '#', badge: 'Binnenkort', kicker: 'Post · kleur', title: 'Kleur & grade', meta: 'In ontwikkeling', desc: 'Twee camera’s, één look. D-Log matchen, LUTs en een cinematische grade in Final Cut en DaVinci Resolve.', photo: '1762740522491-2a4f7c754816', soon: true },
];

const jsonld = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Cursussen — Lichtbreking',
  itemListElement: courses.filter(c => !c.soon).map((c, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: { '@type': 'Course', name: c.title, description: c.desc, inLanguage: 'nl-NL', url: 'https://www.lichtbreking.nl' + c.href, provider: { '@type': 'Person', name: 'Lichtbreking', url: 'https://www.lichtbreking.nl/' }, isAccessibleForFree: true },
  })),
};
---
<Base title="Cursussen" description="Gratis cinematische cursussen: De Vluchtfilmer (drone) en De Grondfilmer (camera). Leer filmen vanuit de lucht én op de grond." path="/cursussen/" jsonld={jsonld}>
  <GlassNav active="cursussen" />
  <main class="lb-container page">
    <header class="page-head lb-reveal">
      <span class="lb-label">Leren</span>
      <h1 class="lb-display-l">Cursussen</h1>
      <p class="lb-lead">Gratis, cinematisch en praktisch. Kies je toestel — of volg ze allebei en leer hoe drone en camera samen één film vormen.</p>
    </header>

    <div class="courses">
      {courses.map((c) => (
        <a href={c.href} class:list={["course lb-reveal", { soon: c.soon }]} aria-disabled={c.soon ? 'true' : undefined}>
          <div class="course__img lb-media">
            <img src={src(c.photo, 1024)} srcset={srcset(c.photo)} sizes="(max-width:860px) 100vw, 33vw" alt={c.title} loading="lazy" width="1200" height="800" />
            <span class:list={["course__badge", { soon: c.soon }]}>{c.badge}</span>
          </div>
          <div class="course__body">
            <span class="lb-label lb-label--sky">{c.kicker}</span>
            <h2 class="course__title">{c.title}</h2>
            <span class="lb-label">{c.meta}</span>
            <p class="course__desc">{c.desc}</p>
            <span class="course__cta">{c.soon ? 'Binnenkort' : 'Open de cursus →'}</span>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-top: 130px; padding-bottom: 96px; }
  .page-head { margin-bottom: 44px; }
  .page-head h1 { margin: 10px 0 18px; }
  .courses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .course { display: flex; flex-direction: column; background: var(--lb-surface); border: 1px solid var(--lb-line); border-radius: var(--lb-r-lg); overflow: hidden; transition: transform var(--lb-dur) var(--lb-ease), border-color var(--lb-dur) var(--lb-ease); }
  .course:hover { transform: translateY(-3px); border-color: var(--lb-mist); }
  .course.soon { opacity: .72; pointer-events: none; }
  .course__img { aspect-ratio: 16 / 10; border-radius: 0; }
  .course__img::after { background: linear-gradient(180deg, transparent 55%, rgba(8,8,10,.5)); }
  .course__badge { position: absolute; top: 14px; left: 14px; z-index: 2; font-family: var(--lb-font-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-night); background: var(--lb-bone); padding: 5px 10px; border-radius: 20px; }
  .course__badge.soon { background: rgba(255,255,255,.18); color: #fff; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .course__body { padding: 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .course__title { margin: 4px 0 2px; }
  .course__desc { color: var(--lb-mist); font-size: var(--lb-small); margin: 8px 0 16px; flex: 1; }
  .course__cta { color: var(--lb-bone); font-weight: 500; font-size: var(--lb-small); }
  @media (max-width: 860px) { .courses { grid-template-columns: 1fr; } }
</style>
