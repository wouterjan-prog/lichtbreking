---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { src, srcset } from '../../data/work.js';

const chapters = [
  ['00:00', 'Opening — gouden uur boven zee'],
  ['00:42', 'Kustlijn & ruige rotsen'],
  ['01:28', 'Tropisch — palmen en turquoise'],
  ['02:05', 'Aftiteling'],
];
---
<Base title="Showreel" description="De showreel van Lichtbreking — een jaar cinematische drone- en filmbeelden in beeld." path="/showreel/" type="video.other">
  <GlassNav active="" />
  <main class="reel">
    <div class="lb-container">
      <header class="reel-head lb-reveal">
        <span class="lb-label lb-label--sky">Een jaar in beeld</span>
        <h1 class="lb-display-l">Showreel</h1>
      </header>

      <div class="player lb-reveal" id="player">
        <img class="player__poster" src={src('1507525428034-b723cf961d3e', 2000)} srcset={srcset('1507525428034-b723cf961d3e')} sizes="100vw" alt="Filmische kustlijn vanuit de lucht — still uit de showreel" width="2000" height="1125" />
        <div class="player__scrim" aria-hidden="true"></div>
        <button class="player__play lb-glass" id="reel-play" aria-label="Speel showreel af">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <div class="lower-third">
          <div class="lb-rule--v" aria-hidden="true"></div>
          <div>
            <h2 class="lt__title">Lichtbreking — 2026</h2>
            <span class="lb-label">DRONE · D-LOG M · 24FPS · 2:30</span>
          </div>
        </div>
        <div class="scrubber" aria-hidden="true"><span></span></div>
      </div>

      <div class="chapters lb-reveal">
        <span class="lb-label">Hoofdstukken</span>
        <ul>
          {chapters.map(([t, l]) => (
            <li><span class="ch__t">{t}</span><span class="ch__l">{l}</span></li>
          ))}
        </ul>
      </div>

      <a href="/werk/" class="back lb-label lb-reveal">← Terug naar het werk</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .reel { padding-top: 130px; padding-bottom: 96px; background: #050506; min-height: 100vh; }
  .reel-head { margin-bottom: 28px; }
  .reel-head h1 { margin-top: 10px; }
  .player { position: relative; aspect-ratio: 16 / 9; border-radius: var(--lb-r-lg); overflow: hidden; background: #000; box-shadow: var(--lb-shadow-float); }
  .player__poster { width: 100%; height: 100%; object-fit: cover; }
  .player__scrim { position: absolute; inset: 0; background: radial-gradient(120% 80% at 50% 40%, transparent, rgba(0,0,0,.55)); }
  .player__play { position: absolute; inset: 0; margin: auto; width: 84px; height: 84px; border-radius: 50%; color: #fff; display: grid; place-items: center; cursor: pointer; transition: transform var(--lb-dur) var(--lb-ease); }
  .player__play:hover { transform: scale(1.06); }
  .lower-third { position: absolute; left: clamp(18px,3vw,34px); bottom: clamp(34px,5vw,54px); z-index: 2; display: flex; gap: 14px; align-items: stretch; }
  .lower-third .lb-rule--v { width: 3px; border-radius: 2px; }
  .lt__title { color: #fff; font-size: clamp(20px,2.4vw,30px); }
  .lower-third .lb-label { color: rgba(255,255,255,.82); }
  .scrubber { position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: rgba(255,255,255,.2); }
  .scrubber span { display: block; width: 34%; height: 100%; background: var(--lb-spectrum); }
  .chapters { margin-top: 34px; }
  .chapters ul { margin-top: 14px; display: grid; gap: 2px; }
  .chapters li { display: flex; gap: 18px; padding: 12px 0; border-bottom: 1px solid var(--lb-line); }
  .ch__t { font-family: var(--lb-font-mono); color: var(--lb-sky); font-size: var(--lb-small); min-width: 56px; }
  .ch__l { color: var(--lb-mist); }
  .back { display: inline-block; margin-top: 30px; color: var(--lb-mist); }
  .back:hover { color: var(--lb-bone); }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('reel-play');
    if (btn) btn.addEventListener('click', function () {
      alert('Showreel-video volgt — zet je eigen bestand op /public/video/showreel.mp4 of koppel een YouTube/Vimeo-embed.');
    });
  })();
</script>
