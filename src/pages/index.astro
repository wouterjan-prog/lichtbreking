---
import Base from '../layouts/Base.astro';
import GlassNav from '../components/GlassNav.astro';
import Footer from '../components/Footer.astro';
import SpectrumRule from '../components/SpectrumRule.astro';
import MediaCard from '../components/MediaCard.astro';
import { work, src, srcset } from '../data/work.js';

const heroId = '1576682953661-a056a5073019'; // gouden uur boven zee
const teaser = work.slice(0, 3);

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://www.lichtbreking.nl/#website', url: 'https://www.lichtbreking.nl/', name: 'Lichtbreking', description: 'Cinematische drone-, foto- en videobeelden, plus de cursus De Vluchtfilmer.', inLanguage: 'nl-NL' },
    { '@type': 'Person', '@id': 'https://www.lichtbreking.nl/#person', name: 'Lichtbreking', url: 'https://www.lichtbreking.nl/', jobTitle: 'Drone- en videomaker', knowsAbout: ['Dronefotografie','Videografie','Luchtfotografie','Reisfotografie'], areaServed: 'Nederland' },
  ],
};
---
<Base title="Lichtbreking — cinematische drone, foto & film" description="Cinematische drone-, foto- en videobeelden, plus de gratis cursus De Vluchtfilmer. Waar licht breekt." path="/" jsonld={jsonld}>
  <GlassNav active="" />

  <main>
    <!-- HERO -->
    <section class="hero">
      <img class="hero__bg" src={src(heroId, 2000)} srcset={srcset(heroId)} sizes="100vw" alt="Luchtfoto van de oceaan tijdens het gouden uur" fetchpriority="high" width="2000" height="1125" />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__inner lb-container">
        <span class="lb-label lb-label--sky lb-reveal">Drone · foto · film</span>
        <h1 class="lb-display-xl hero__title lb-reveal">Waar licht<br>breekt</h1>
        <p class="hero__lead lb-reveal">Cinematische beelden uit de lucht en op ooghoogte — en de gratis cursus om het zelf te leren.</p>
        <div class="hero__cta lb-reveal">
          <a href="/werk/" class="lb-btn">Bekijk het werk</a>
          <a href="/showreel/" class="lb-btn lb-btn--glass">▶ Showreel</a>
        </div>
        <div class="hero__rule lb-reveal"><SpectrumRule width="180px" thickness={3} /></div>
      </div>
      <a href="#werk" class="hero__scroll lb-label" aria-label="Scroll naar het werk">Scroll ↓</a>
    </section>

    <!-- WERK-TEASER -->
    <section id="werk" class="lb-section">
      <div class="lb-container">
        <header class="sec-head lb-reveal">
          <div>
            <span class="lb-label">Selectie</span>
            <h2 class="lb-display-m">Het werk</h2>
          </div>
          <a href="/werk/" class="sec-head__link">Alles bekijken →</a>
        </header>
        <div class="work-grid lb-reveal">
          {teaser.map((item, i) => (
            <MediaCard item={item} counter={`0${i + 1} / 0${work.length}`} big={i === 0} />
          ))}
        </div>
      </div>
    </section>

    <!-- CURSUS-TEASER -->
    <section class="lb-section course-teaser">
      <div class="lb-container">
        <a href="/cursussen/" class="lb-media ct lb-reveal" aria-label="De Vluchtfilmer — cursus">
          <img src={src('1473968512647-3e447244af8f', 2000)} srcset={srcset('1473968512647-3e447244af8f')} sizes="100vw" alt="Filmische kustlijn vanuit de lucht" loading="lazy" width="2000" height="1125" />
          <div class="ct__inner">
            <span class="lb-label lb-label--sky">Gratis cursus</span>
            <h2 class="lb-display-m">Leer je drone filmen,<br>niet alleen vliegen.</h2>
            <p class="ct__sub">Vijftien modules van eerste opstart tot afgemonteerde film — shot-recepten, beslisbomen en een veldgids.</p>
            <span class="lb-btn ct__btn">Naar de cursussen →</span>
          </div>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__scrim { position: absolute; inset: 0; background:
      linear-gradient(180deg, rgba(8,8,10,.55) 0%, rgba(8,8,10,.05) 22%, rgba(8,8,10,.15) 55%, rgba(8,8,10,.92) 100%); }
  .hero__inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(64px, 10vh, 130px); padding-top: 140px; }
  .hero__title { color: #fff; margin: 14px 0 0; }
  .hero__lead { color: rgba(255,255,255,.9); font-size: clamp(17px, 2vw, 21px); max-width: 46ch; margin: 22px 0 0; }
  .hero__cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
  .hero__rule { margin-top: 34px; }
  .hero__scroll { position: absolute; bottom: 26px; right: var(--lb-gutter); z-index: 2; color: rgba(255,255,255,.8); }

  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 32px; }
  .sec-head h2 { margin-top: 8px; }
  .sec-head__link { color: var(--lb-mist); font-size: var(--lb-small); white-space: nowrap; }
  .sec-head__link:hover { color: var(--lb-bone); }

  .work-grid { display: grid; grid-template-columns: 2fr 1fr; grid-auto-rows: 1fr; gap: 16px; }
  .work-grid > :global(.big) { grid-row: span 2; }
  @media (max-width: 720px) { .work-grid { grid-template-columns: 1fr; } .work-grid > :global(.big) { grid-row: auto; } }

  .ct { display: block; aspect-ratio: 21 / 9; }
  .ct__inner { position: absolute; z-index: 2; left: clamp(24px,4vw,56px); right: clamp(24px,4vw,56px); bottom: clamp(24px,4vw,48px); max-width: 60ch; }
  .ct__inner h2 { color: #fff; margin: 10px 0 0; }
  .ct__sub { color: rgba(255,255,255,.85); margin: 14px 0 20px; max-width: 52ch; }
  .ct__btn { pointer-events: none; }
  @media (max-width: 720px) { .ct { aspect-ratio: 4 / 5; } }
</style>
