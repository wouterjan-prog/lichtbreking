---
import Base from '../../layouts/Base.astro';
import Tegel from '../../components/Tegel.astro';
import Lightbox from '../../components/Lightbox.astro';
import { rasterShots, aantalBeelden, heeftBeeldmateriaal } from '../../data/shots.js';

/* Het volledige archief in één raster. De vorm wisselt af: breed, staand en
   een band over de volle breedte, in een patroon dat altijd sluit. */
const vormen = ['lb-tegel--breed', 'lb-tegel--vk', 'lb-tegel--staand', 'lb-tegel--staand', 'lb-tegel--staand', 'lb-tegel--band'];
const shots = rasterShots.map((shot, i) => ({ shot, vorm: vormen[i % vormen.length] }));
---
<Base
  titel="Beeld"
  beschrijving="Het volledige beeldarchief van Lichtbreking, opgenomen boven, op en onder de waterlijn."
>
  <div class="lb-paginakop lb-marge">
    <h1>Beeld</h1>
    <div class="lb-rule lb-rule--kort"></div>
    <p>{aantalBeelden} {aantalBeelden === 1 ? 'beeld' : 'beelden'}. Klik voor de plek.</p>
  </div>

  {!heeftBeeldmateriaal && (
    <p class="lb-inaanbouw lb-marge">Het archief wordt gevuld. De beelden verschijnen hier binnenkort.</p>
  )}

  <div class="lb-mozaiek lb-marge">
    {shots.map(({ shot, vorm }, i) => <Tegel shot={shot} vorm={vorm} caption={true} lazy={i > 1} />)}
  </div>

  <Lightbox />
</Base>
