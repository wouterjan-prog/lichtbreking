---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { work, src, srcset } from '../../data/work.js';

const filters = [
  { id: 'alles', label: 'Alles' },
  { id: 'drone', label: 'Drone' },
  { id: 'video', label: 'Film' },
  { id: 'photo', label: 'Foto' },
];
---
<Base title="Werk" description="Een selectie cinematische drone-, foto- en filmbeelden van Lichtbreking." path="/werk/">
  <GlassNav active="werk" />
  <main class="lb-container page">
    <header class="page-head lb-reveal">
      <span class="lb-label">Selectie</span>
      <h1 class="lb-display-l">Het werk</h1>
      <div class="filters" role="tablist" aria-label="Filter werk">
        {filters.map((f, i) => (
          <button class:list={["filter", { on: i === 0 }]} data-filter={f.id}>{f.label}</button>
        ))}
      </div>
    </header>

    <div class="grid" id="work-grid">
      {work.map((item, i) => (
        <a href={`/werk/${item.id}/`} class="lb-media tile lb-reveal" data-cat={item.cat} data-type={item.type} aria-label={item.title}>
          <img src={src(item.photo, 1024)} srcset={srcset(item.photo)} sizes="(max-width:720px) 100vw, 33vw" alt={item.alt} loading="lazy" decoding="async" width="1600" height="1066" />
          {item.type === 'video' && <span class="tile__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>}
          <div class="tile__meta">
            <span class="lb-label lb-label--sky">{`0${i + 1}`} · {item.cat.toUpperCase()}</span>
            <h3 class="tile__title">{item.title}</h3>
            <span class="lb-label">{item.place} · {item.year}</span>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-top: 130px; padding-bottom: 96px; }
  .page-head { margin-bottom: 36px; }
  .page-head h1 { margin: 10px 0 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .filter {
    font-family: var(--lb-font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--lb-mist); background: var(--lb-ink); border: 1px solid var(--lb-line);
    padding: 9px 16px; border-radius: var(--lb-r-pill); cursor: pointer; transition: .3s var(--lb-ease);
  }
  .filter:hover { color: var(--lb-bone); }
  .filter.on { color: var(--lb-night); background: var(--lb-bone); border-color: var(--lb-bone); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .tile { aspect-ratio: 4 / 3; display: block; }
  .tile.hide { display: none; }
  .tile:hover img { transform: scale(1.03); }
  .tile__meta { position: absolute; left: 18px; right: 18px; bottom: 16px; z-index: 2; display: flex; flex-direction: column; gap: 5px; }
  .tile__title { color: #fff; font-size: clamp(18px, 2vw, 24px); }
  .tile__meta .lb-label { color: rgba(255,255,255,.82); }
  .tile__play { position: absolute; inset: 0; margin: auto; z-index: 2; width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.4); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } .tile { aspect-ratio: 3 / 2; } }
</style>

<script is:inline>
  (function () {
    var btns = document.querySelectorAll('.filter');
    var tiles = document.querySelectorAll('#work-grid .tile');
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        btns.forEach(function (x) { x.classList.remove('on'); });
        b.classList.add('on');
        var f = b.getAttribute('data-filter');
        tiles.forEach(function (t) {
          var show = f === 'alles' || t.getAttribute('data-cat') === f || t.getAttribute('data-type') === f;
          t.classList.toggle('hide', !show);
        });
      });
    });
  })();
</script>
