---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kaartjes from '../../components/Kaartjes.astro';
import { shots } from '../../data/shots.js';
import { toestelNaam, elementen, elementKleur } from '../../data/site.js';

const originelen = import.meta.glob(
  '../../beelden/werk/*.{jpg,jpeg,png,webp,avif,tif,tiff,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

/* Alleen beelden die er echt zijn krijgen een eigen pagina. */
export function getStaticPaths() {
  const metBeeld = shots.filter((s) => Boolean(s.bestand));
  return metBeeld.map((shot, i) => ({
    params: { slug: shot.slug },
    props: {
      shot,
      vorige: metBeeld[(i - 1 + metBeeld.length) % metBeeld.length],
      volgende: metBeeld[(i + 1) % metBeeld.length],
    },
  }));
}

const { shot, vorige, volgende } = Astro.props;
const o = shot.opname ?? null;

const uitPublic = shot.bestand.startsWith('/');
const origineel = uitPublic ? null : originelen[`../../beelden/werk/${shot.bestand}`]?.default ?? null;
const alt = shot.alt || `${shot.titel}, ${toestelNaam(shot.toestel)}`;
const posterPad = origineel
  ? (await getImage({ src: origineel, format: 'webp', width: 1920 })).src
  : (uitPublic ? shot.bestand : undefined);

const elementNaam = elementen.find((e) => e.id === shot.element)?.naam ?? shot.element;

const maanden = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli',
                 'augustus', 'september', 'oktober', 'november', 'december'];
const datumTekst = (() => {
  if (!o?.datum) return null;
  const [j, m, d] = o.datum.split('-').map(Number);
  return `${d} ${maanden[m - 1]} ${j}`;
})();

/* Eén rustige regel met wat de camera meeschreef. Geen tabel. */
const regel = [
  datumTekst,
  o?.hoogte ? `${o.hoogte} m` : null,
  [o?.diafragma, o?.sluiter, o?.iso ? `ISO ${o.iso}` : null].filter(Boolean).join(' · ') || null,
].filter(Boolean).join(' · ');

const alleen = vorige?.slug === shot.slug;
const zelfdeBuur = !alleen && vorige?.slug === volgende?.slug;
---
<Base
  titel={shot.titel}
  beschrijving={`${shot.titel}${o?.plek ? `, ${o.plek}` : ''}. Vastgelegd met ${toestelNaam(shot.toestel)}.`}
>
  <div class="lb-paginakop lb-marge">
    <p class="lb-label">
      <span class="lb-toestel__dot" style={`background:${elementKleur(shot.element)};display:inline-block;margin-right:8px`}></span>
      {o?.plek ?? elementNaam}
    </p>
    <h1>{shot.titel}</h1>
  </div>

  <div class="lb-detail lb-marge">
    {shot.video ? (
      <video class="lb-detail__video" controls loop playsinline preload="none" poster={posterPad}>
        {shot.video.hevc && <source src={shot.video.hevc} type='video/mp4; codecs="hvc1"' />}
        {shot.video.h264 && <source src={shot.video.h264} type="video/mp4" />}
      </video>
    ) : origineel ? (
      <Picture
        src={origineel}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000, 2400]}
        sizes="(min-width: 1240px) 1184px, 100vw"
        alt={alt}
        loading="eager"
        decoding="async"
      />
    ) : (
      <img src={shot.bestand} alt={alt} loading="eager" decoding="async" />
    )}
    {regel && <p class="lb-label lb-detail__regel">{regel}</p>}
  </div>

  <div class="lb-plek lb-marge">
    <div>
      {shot.verhaal && <p class="lb-groot">{shot.verhaal}</p>}
      {shot.weetje && (
        <div class="lb-weetje">
          <p class="lb-label">Weetje</p>
          <p>{shot.weetje}</p>
        </div>
      )}
    </div>
    <Kaartjes lat={o?.lat} lon={o?.lon} element={shot.element} titel={shot.titel} />
  </div>

  <nav class="lb-verder lb-marge" aria-label="Naar een ander beeld">
    {!alleen && !zelfdeBuur && (
      <a class="lb-knop lb-knop--rand" href={`/werk/${vorige.slug}/`}>&#8592; {vorige.titel}</a>
    )}
    <a class="lb-knop lb-knop--rand" href="/werk/">Alle beelden</a>
    {!alleen && (
      <a class="lb-knop lb-knop--rand" href={`/werk/${volgende.slug}/`}>{volgende.titel} &#8594;</a>
    )}
  </nav>
</Base>

{shot.video?.h264 && (
  <script is:inline define:vars={{ terugval: shot.video.h264 }}>
    (() => {
      const video = document.querySelector('.lb-detail__video');
      if (!video) return;
      let geprobeerd = false;
      video.addEventListener('error', () => {
        if (geprobeerd) return;
        geprobeerd = true;
        video.src = terugval;
        video.load();
      }, true);
    })();
  </script>
)}
