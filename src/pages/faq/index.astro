---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';

// q = vraag · a = antwoord (platte tekst, ook voor schema) · link = [label, href] (optioneel)
const faqs = [
  { q: 'Heb ik een vliegbewijs nodig voor mijn drone?',
    a: 'Voor een drone van 250 gram of zwaarder heb je het EU-dronebewijs A1/A3 nodig en moet je je als exploitant registreren bij de RDW. Een drone onder de 250 gram zonder camera hoef je niet te registreren; mét camera registreer je je wél, maar je hebt dan geen vliegbewijs nodig.',
    link: ['Lees de volledige drone-regels', '/artikelen/drone-regels-nederland-eu/'] },
  { q: 'Welk ND-filter heb ik wanneer nodig?',
    a: 'Een ND-filter houdt het licht tegen zodat je op een sluitertijd van 1/50 s kunt blijven. Vuistregel: ND8 bij bewolkt, ND16 bij zon, ND32 bij felle middagzon en ND64 boven wit zand of spiegelend water.',
    link: ['Naar de ND-calculator', '/gereedschap/'] },
  { q: 'Welke instellingen geven een cinematische look?',
    a: '4K, 24 of 25 fps, sluitertijd 1/50 s (de 180°-regel), ISO 100, witbalans handmatig vast op ongeveer 5500 K, kleurprofiel Normal en scherpte −1. Witbalans op auto laten is de grootste valkuil.',
    link: ['Alle Pro-instellingen uitgelegd', '/artikelen/pro-instellingen-uitgelegd/'] },
  { q: 'Mag ik op de Veluwe vliegen?',
    a: 'Nee, grote delen van de Veluwe (bos en heide) en van de IJssel-uiterwaarden zijn Natura 2000-gebied, waar dronevliegen verboden is. Vlieg op open boerenland buiten die beschermde gebieden, met de gewone EU-regels, en check vooraf de exacte grenzen.',
    link: ['Bekijk de Heerde- & Veluwe-gids', '/heerde/'] },
  { q: 'Kan ik met mijn drone naar Curaçao?',
    a: 'Ja, maar registratie is daar verplicht: meld je drone vooraf aan bij de RAC en check de regels van de CCAA. Zonder bewijs van registratie kan je drone bij de douane worden ingenomen.',
    link: ['Lees de Curaçao-gids', '/curacao/'] },
  { q: 'Hoe film ik onder water bij het snorkelen of duiken?',
    a: 'Zet je witbalans handmatig vast (ongeveer 5500 K ondiep, hoger op diepte), gebruik een waterdichte behuizing en laat het ND-filter thuis — onder water is dat niet nodig. Kom dichtbij je onderwerp en houd de zon in je rug.',
    link: ['Onderwater-instellingen (GoPro & Osmo 360)', '/artikelen/onderwater-action-instellingen/'] },
  { q: 'Hoe lang kan ik vliegen op één accu?',
    a: 'Reken in de praktijk op ongeveer 30 minuten per accu. De DJI Mini 5 Pro is rond de 36 minuten op papier, maar wind en actief filmen halen dat omlaag naar zo\'n 25 à 30 minuten. Keer altijd terug bij je reserve-grens (bijvoorbeeld 30%), niet bij 0%, en houd bij tegenwind extra marge aan voor de terugvlucht.',
    link: ['Bereken je veilige vliegtijd', '/gereedschap/'] },
  { q: 'Welke drone kan ik het beste kopen als beginner?',
    a: 'Voor de meeste mensen is een lichte drone onder de 250 gram (de Mini-klasse) de slimste start: hij past in een jaszak, valt onder de soepelste regels en levert toch prima beeld. Belangrijkste accessoire is een ND-filterset.',
    link: ['Welke drone & accessoires?', '/artikelen/welke-drone-en-accessoires/'] },
  { q: 'Wat is het gouden uur en waarom is het zo mooi?',
    a: 'Het gouden uur is het eerste uur na zonsopkomst en het laatste uur voor zonsondergang. Het licht is dan warm, zacht en laag, met lange schaduwen — ideaal voor filmische beelden.',
    link: ['Open de gouden-uur-planner', '/gouden-uur/'] },
  { q: 'Zijn de cursussen echt gratis?',
    a: 'Ja. De Vluchtfilmer (DJI Mini 5 Pro) en De Grondfilmer (Osmo Pocket 4) zijn allebei volledig gratis — van eerste opstart tot een afgemonteerde cinematische film.',
    link: ['Naar de cursussen', '/cursussen/'] },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Veelgestelde vragen over dronevliegen en filmen"
  description="Antwoorden op veelgestelde vragen over dronevliegen: het vliegbewijs en de regels, ND-filters en instellingen, vliegen op de Veluwe en op Curaçao, onder water filmen, en de gratis cursussen."
  path="/faq/"
  jsonld={jsonld}>
  <GlassNav active="" switchHref="/en/cursussen/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container faq-page">
    <header class="faq-head lb-reveal">
      <span class="lb-label lb-label--sky">Veelgestelde vragen</span>
      <h1 class="lb-display-l">Vragen &amp; antwoorden</h1>
      <p class="lb-lead">De dingen die mensen het vaakst vragen over dronevliegen, de regels, de instellingen en de cursussen — kort en duidelijk beantwoord.</p>
    </header>

    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item lb-reveal">
          <summary><span>{f.q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <div class="faq-a">
            <p>{f.a}</p>
            {f.link && <a href={f.link[1]} class="faq-link">{f.link[0]} →</a>}
          </div>
        </details>
      ))}
    </div>

    <div class="faq-cta lb-reveal">
      <span class="lb-label lb-label--sky">Staat je vraag er niet bij?</span>
      <h2 class="lb-display-m">Stel hem gerust</h2>
      <p class="lb-lead">Loop je ergens tegenaan of mis je iets? Laat het weten — ik denk graag mee.</p>
      <a href="/contact/" class="lb-btn">Naar contact →</a>
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  .faq-page { padding-top: 130px; padding-bottom: 96px; }
  .faq-head { max-width: 64ch; margin-bottom: 34px; }
  .faq-head h1 { margin: 10px 0 16px; }
  .faq-list { max-width: 760px; display: flex; flex-direction: column; gap: 12px; }
  .faq-item { background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); border-radius: 14px; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); overflow: hidden; }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; font-size: 1.05rem; font-weight: 500; color: var(--lb-bone); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { position: relative; flex: 0 0 auto; width: 16px; height: 16px; }
  .faq-plus::before, .faq-plus::after { content: ""; position: absolute; background: var(--lb-sky); border-radius: 2px; transition: transform .25s var(--lb-ease); }
  .faq-plus::before { left: 0; right: 0; top: 7px; height: 2px; }
  .faq-plus::after { top: 0; bottom: 0; left: 7px; width: 2px; }
  .faq-item[open] .faq-plus::after { transform: scaleY(0); }
  .faq-a { padding: 0 20px 20px; color: var(--lb-mist); line-height: 1.65; }
  .faq-a p { margin: 0 0 .6rem; font-size: .98rem; }
  .faq-link { color: var(--lb-sky); font-size: .92rem; text-decoration: underline; text-underline-offset: 2px; }
  .faq-cta { margin-top: 52px; padding-top: 34px; border-top: 1px solid var(--lb-line); max-width: 760px; }
  .faq-cta h2 { margin: 8px 0 10px; }
  .faq-cta .lb-btn { margin-top: 8px; }
</style>
