---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import SpectrumRule from '../../components/SpectrumRule.astro';
import { src, srcset } from '../../data/work.js';

const gear = [['Drone','DJI Mini 5 Pro · RC 2'],['Camera','DJI Osmo Pocket 4'],['Montage','Final Cut · DaVinci Resolve'],['Werk','Drone, foto & film']];
---
<Base title="Over" description="Het verhaal achter Lichtbreking: één idee dat lens, drone en glas verbindt — de breking van licht." path="/over/">
  <GlassNav active="over" />
  <main>
    <section class="opener">
      <img class="opener__bg" src={src('1473968512647-3e447244af8f', 2000)} srcset={srcset('1473968512647-3e447244af8f')} sizes="100vw" alt="Filmische kustlijn vanuit de lucht" fetchpriority="high" width="2000" height="1125" />
      <div class="opener__scrim" aria-hidden="true"></div>
      <div class="opener__inner lb-container">
        <span class="lb-label lb-label--sky lb-reveal">Over</span>
        <h1 class="lb-display-l lb-reveal">Scherp zien,<br>mooi vastleggen.</h1>
      </div>
    </section>

    <section class="lb-section">
      <div class="lb-container body">
        <div class="story lb-reveal">
          <p class="lb-lead">Lichtbreking komt voort uit twee werelden die dichter bij elkaar liggen dan ze lijken: het scherp leren zien, en het mooi vastleggen. Beide draaien om hetzelfde — het sturen van licht.</p>
          <p class="lb-muted">Een lens buigt licht zodat het samenkomt in een scherp beeld. Een drone vangt datzelfde licht, honderd meter hoger. En glas — het materiaal van deze site — breekt licht in al zijn kleuren. Dat is geen toeval, dat is de rode draad. Vandaar de naam.</p>
          <p class="lb-muted">Wat je hier vindt is het werk dat daaruit ontstaat: cinematische beelden uit de lucht en op ooghoogte. De portfolio groeit met elke reis; de gratis cursussen delen alles wat nodig is om zelf cinematisch te leren vliegen en filmen.</p>
          <SpectrumRule width="120px" />
        </div>
        <aside class="gear lb-reveal">
          <span class="lb-label">Gereedschap</span>
          <ul>{gear.map(([k,v]) => <li><span class="lb-label">{k}</span><span class="gear__v">{v}</span></li>)}</ul>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .opener { position: relative; min-height: 70svh; display: flex; align-items: flex-end; overflow: hidden; }
  .opener__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .opener__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,8,10,.5) 0%, transparent 35%, rgba(8,8,10,.92) 100%); }
  .opener__inner { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(40px,6vw,80px); }
  .opener__inner h1 { color: #fff; margin-top: 12px; }
  .body { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(28px,5vw,64px); align-items: start; }
  .story p { margin-bottom: 18px; }
  .gear { background: var(--lb-surface); border: 1px solid var(--lb-line); border-radius: var(--lb-r-lg); padding: 26px; }
  .gear ul { margin-top: 16px; display: flex; flex-direction: column; gap: 16px; }
  .gear li { display: flex; flex-direction: column; gap: 4px; }
  .gear__v { color: var(--lb-bone); }
  @media (max-width: 760px) { .body { grid-template-columns: 1fr; } }
</style>
