---
import Base from '../../layouts/Base.astro';
import Overband from '../../components/Overband.astro';
import { elementen } from '../../data/site.js';
import { shots } from '../../data/shots.js';

const perElement = elementen.map((el) => ({
  ...el,
  aantal: shots.filter((s) => s.element === el.id).length,
}));
---
<Base
  titel="Over"
  beschrijving="Waar Lichtbreking over gaat, en met welke toestellen het beeld gemaakt wordt."
>
  <div class="lb-paginakop lb-marge">
    <h1>Over</h1>
    <div class="lb-rule lb-rule--kort"></div>
    <p>Een archief van licht, verdeeld over vier elementen en vier lenzen.</p>
  </div>

  <div class="lb-proza lb-marge">
    <div>
      <h2>Wat dit is</h2>
      <p>
        Lichtbreking is de naam voor het beeld dat ik maak boven, op en onder de grond. Geen
        vlogs en geen praatvideo's, maar rustige beelden van een plek zoals die op dat moment
        is. Soms is dat een kustlijn van bovenaf, soms een halve meter onder water.
      </p>
      <p>
        Het werk is verdeeld in vier elementen: lucht, land, water en nacht. Die verdeling
        bepaalt ook de kleuren op deze site. Elk element heeft zijn eigen licht, en dat licht
        vraagt telkens om een andere aanpak.
      </p>
      <h2>Hoe het gemaakt wordt</h2>
      <p>
        Vier toestellen, elk met een duidelijke rol. Ze zijn niet uitwisselbaar: wat de drone
        ziet krijgt een camera in de hand nooit, en andersom. Beelden worden zoveel mogelijk
        in de camera goed gezet, zodat de nabewerking licht kan blijven.
      </p>
      <p>
        Wat hier staat is een selectie. Niet alles wat gefilmd wordt haalt het archief, en dat
        is precies de bedoeling.
      </p>
    </div>

    <div class="lb-kaart">
      <h2>Vier elementen</h2>
      <ul class="lb-lijst">
        {perElement.map((el) => (
          <li>
            <span class="lb-toestel__dot" style={`background:${el.kleur}`}></span>
            <b>{el.naam}</b>
            <span>{el.aantal} {el.aantal === 1 ? 'beeld' : 'beelden'}</span>
          </li>
        ))}
      </ul>
      <p style="margin-top:22px">
        Filteren op element kan op de <a href="/werk/">werkpagina</a>. Vragen over een beeld of
        over een opname? <a href="/contact/">Stuur gerust een bericht</a>.
      </p>
    </div>
  </div>

  <Overband />
</Base>
