---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
import { src, srcset } from '../../data/work.js';

const devices = [
  {
    tag: 'Drone · uit de lucht',
    name: 'DJI Mini 5 Pro',
    blurb: 'Je vliegt en filmt vanuit de lucht. Begin hier voor je instellingen, je eerste vlucht en cinematische bewegingen.',
    cls: 'mini',
    photo: '1753618282728-f05ecfc5c9d6',
    links: [
      ['Cursus: De Vluchtfilmer', '/cursus/vluchtfilmer/'],
      ['De instellingen die ik vastzet', '/artikelen/dji-mini-5-pro-instellingen/'],
      ['De 7 cinematische dronebewegingen', '/artikelen/mini-5-pro-cinematische-bewegingen/'],
      ['Vloeiender & veiliger vliegen', '/artikelen/cinematische-besturing-veiligheid-mini-5-pro/'],
    ],
  },
  {
    tag: 'Handheld · op ooghoogte',
    name: 'DJI Osmo Pocket 4',
    blurb: 'Je filmt op de grond met de gimbalcamera. Begin hier voor je instellingen, gimbalmodi en vloeiende loop-technieken.',
    cls: 'pocket',
    photo: '1762740522491-2a4f7c754816',
    links: [
      ['Cursus: De Grondfilmer', '/cursus/grondfilmer/'],
      ['De instellingen die ik vastzet', '/artikelen/osmo-pocket-4-instellingen/'],
      ['Gimbalbewegingen & -modi', '/artikelen/pocket-4-gimbalbewegingen/'],
      ['Onder water filmen', '/artikelen/onderwater-action-instellingen/'],
    ],
  },
];

const steps = [
  ['Ken je toestel', 'Leer waar de knoppen zitten en wat de modi doen — vóór je je eerste opname maakt.'],
  ['Zet je instellingen vast', 'Pro-modus, 4K, 25 fps, sluiter 1/50 s, ISO 100, witbalans handmatig ~5500 K. Niets op auto.'],
  ['Begrijp de 180°-regel', 'Je sluitertijd ≈ 2× je framerate. Dat geeft natuurlijke, filmische beweging — en bepaalt je ND-filter.'],
  ['Componeer bewust', 'Regel van derden, leidende lijnen, een rechte horizon en diepte in de voorgrond.'],
  ['Beweeg met bedoeling', 'Eén trage, vloeiende beweging per shot. Langzamer oogt bijna altijd duurder.'],
  ['Monteer tot een verhaal', 'Wissel wijde, medium en detailshots af, knip op de muziek, en bouw een begin-midden-eind.'],
];

const jsonld = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: 'Start hier — Lichtbreking', inLanguage: 'nl-NL',
  url: 'https://www.lichtbreking.nl/start/',
};
---
<Base
  title="Start hier — kies je toestel en begin met cinematisch filmen"
  description="Nieuw bij Lichtbreking? Kies je toestel — DJI Mini 5 Pro of Osmo Pocket 4 — en volg het pad naar cinematische beelden: instellingen, techniek, beweging en montage."
  path="/start/" image="/img/og-start.png"
  jsonld={jsonld}>
  <GlassNav active="" switchHref="/en/cursussen/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container start-page">
    <header class="start-head lb-reveal">
      <span class="lb-label lb-label--sky">Start hier</span>
      <h1 class="lb-display-l">Welk toestel heb je?</h1>
      <p class="lb-lead">Kies je camera en je krijgt meteen het juiste pad: de instellingen, de techniek en de bewegingen die voor jóuw toestel werken. Heb je beide? Des te beter — samen maken lucht en grond één film.</p>
    </header>

    <div class="dev-grid">
      {devices.map((d) => (
        <div class={`dev-card lb-reveal ${d.cls}`}>
          <img class="dev-photo" src={src(d.photo, 900)} srcset={srcset(d.photo)} sizes="(max-width: 760px) 100vw, 360px" alt={d.name} width="900" height="320" loading="lazy" decoding="async" />
          <span class="dev-tag lb-label">{d.tag}</span>
          <h2 class="dev-name">{d.name}</h2>
          <p class="dev-blurb">{d.blurb}</p>
          <ul class="dev-links">
            {d.links.map(([label, href]) => (
              <li><a href={href}>{label} <span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <section class="start-path lb-reveal">
      <span class="lb-label lb-label--sky">Nieuw met cinematisch filmen?</span>
      <h2 class="lb-display-m">Het pad in 6 stappen</h2>
      <p class="lb-lead">Of je nu een drone of een gimbal hebt — dit is de volgorde van plat filmpje naar filmisch beeld.</p>
      <ol class="path-list">
        {steps.map(([t, b], i) => (
          <li class="path-step">
            <span class="path-num">{String(i + 1).padStart(2, '0')}</span>
            <div><strong>{t}</strong><p>{b}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="start-more lb-reveal">
      <div class="more-card">
        <h3>Kleur je beelden</h3>
        <p>Film je in D-Log M of D-Log? Leer ze graden tot een cinematische look.</p>
        <a href="/cursus/kleurfilmer/" class="more-link">De Kleurfilmer →</a>
      </div>
      <div class="more-card">
        <h3>Snap je de termen niet?</h3>
        <p>ISO, sluitertijd, witbalans, LUT — alle filmtaal in één zin uitgelegd.</p>
        <a href="/begrippen/" class="more-link">Naar de begrippenlijst →</a>
      </div>
      <div class="more-card">
        <h3>Alle artikelen</h3>
        <p>Verdiepende gidsen over techniek, licht, montage, regels en bestemmingen.</p>
        <a href="/artikelen/" class="more-link">Naar de artikelen →</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  .start-page { padding-top: 130px; padding-bottom: 96px; }
  .start-head { max-width: 64ch; margin-bottom: 38px; }
  .start-head h1 { margin: 10px 0 16px; }

  .dev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 60px; }
  @media (max-width: 760px) { .dev-grid { grid-template-columns: 1fr; } }
  .dev-card { position: relative; border-radius: 18px; padding: 26px 26px 24px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); overflow: hidden; }
  .dev-photo { display: block; width: calc(100% + 52px); height: 158px; object-fit: cover; margin: -26px -26px 18px; }
  .dev-card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; z-index: 2; }
  .dev-card.mini::before { background: linear-gradient(90deg,#7c2d12,#ea580c 60%,#fb923c); }
  .dev-card.pocket::before { background: linear-gradient(90deg,#9d174d,#db2777 60%,#f9a8d4); }
  .dev-tag { display: block; margin-bottom: 8px; }
  .dev-name { font-size: 1.55rem; font-weight: 600; color: var(--lb-bone); margin: 0 0 10px; }
  .dev-blurb { color: var(--lb-mist); line-height: 1.6; margin: 0 0 18px; font-size: .98rem; }
  .dev-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .dev-links li { border-top: 1px solid var(--lb-line); }
  .dev-links a { display: flex; justify-content: space-between; gap: 12px; padding: 12px 2px; color: var(--lb-bone); font-weight: 500; font-size: .98rem; transition: color var(--lb-dur) var(--lb-ease); }
  .dev-links a:hover { color: var(--lb-sky); }
  .dev-links a span { color: var(--lb-sky); }

  .start-path { max-width: 820px; margin-bottom: 56px; }
  .start-path h2 { margin: 8px 0 10px; }
  .path-list { list-style: none; counter-reset: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 680px) { .path-list { grid-template-columns: 1fr; } }
  .path-step { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: 14px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); }
  .path-num { font-family: var(--lb-font-mono); font-size: .9rem; font-weight: 700; color: var(--lb-sky); flex: 0 0 auto; }
  .path-step strong { color: var(--lb-bone); display: block; margin-bottom: 4px; }
  .path-step p { color: var(--lb-mist); margin: 0; font-size: .92rem; line-height: 1.55; }

  .start-more { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 760px) { .start-more { grid-template-columns: 1fr; } }
  .more-card { padding: 22px; border-radius: 14px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); }
  .more-card h3 { color: var(--lb-bone); margin: 0 0 8px; font-size: 1.1rem; }
  .more-card p { color: var(--lb-mist); margin: 0 0 14px; font-size: .92rem; line-height: 1.55; }
  .more-link { color: var(--lb-sky); font-weight: 600; font-size: .92rem; }
</style>
