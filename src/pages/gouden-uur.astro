---
import Base from '../layouts/Base.astro';
import GlassNav from '../components/GlassNav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Gouden-uur-planner" description="Bereken het gouden uur, blauwe uur en zonsop-/ondergang voor jouw locatie en datum. Plan je cinematische drone- en filmshoot op het mooiste licht." path="/gouden-uur/">
  <GlassNav active="gereedschap" switchHref="/en/cursussen/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main class="lb-container gh-page">
    <header class="gh-head lb-reveal">
      <span class="lb-label lb-label--sky">Gratis tool</span>
      <h1 class="lb-display-l">Gouden-uur-planner</h1>
      <p class="lb-lead">Het mooiste licht duurt kort. Kies je locatie en datum, en zie precies wanneer het gouden uur, blauwe uur en zonsop-/ondergang vallen — plus de voorspelde wind op die momenten, zodat je weet of je kunt vliegen.</p>
    </header>

    <div class="gh-controls lb-reveal">
      <button class="lb-btn lb-btn--glass" id="ghGeo">📍 Gebruik mijn locatie</button>
      <div class="gh-search">
        <input type="text" id="ghSearch" placeholder="Zoek een plaats wereldwijd…" autocomplete="off" aria-label="Zoek een plaats">
        <div class="gh-results" id="ghResults" hidden></div>
      </div>
      <input type="date" id="ghDate" aria-label="Datum">
    </div>
    <p class="gh-loc lb-muted lb-reveal" id="ghLoc">Stel hierboven je locatie in om de tijden te zien.</p>

    <div class="gh-next lb-reveal" id="ghNext" hidden></div>

    <div class="gh-wind lb-reveal" id="ghWind" hidden></div>

    <div class="gh-grid lb-reveal" id="ghGrid" hidden></div>

    <p class="gh-fine lb-muted lb-reveal">Tijden in jouw apparaat-tijdzone. De zontijden worden volledig op je toestel berekend. Voor het zoeken van plaatsen en de windvoorspelling gebruik ik de gratis Open-Meteo-dienst.</p>
  </main>
  <Footer />
</Base>

<style is:global>
  .gh-page { padding-top: 130px; padding-bottom: 96px; }
  .gh-head { max-width: 64ch; margin-bottom: 32px; }
  .gh-head h1 { margin: 10px 0 16px; }
  .gh-controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .gh-controls input[type=date] { background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border: 1px solid var(--lb-glass-border); color: var(--lb-bone); border-radius: 12px; padding: .75rem .8rem; font-size: .95rem; font-family: var(--lb-font-text); }
  .gh-search { position: relative; flex: 1; min-width: 220px; }
  .gh-search input { width: 100%; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border: 1px solid var(--lb-glass-border); color: var(--lb-bone); border-radius: 12px; padding: .75rem .9rem; font-size: .95rem; font-family: var(--lb-font-text); }
  .gh-results { position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 5; background: var(--lb-glass-solid); -webkit-backdrop-filter: blur(20px) saturate(160%); backdrop-filter: blur(20px) saturate(160%); border: 1px solid var(--lb-glass-solid-border); border-radius: 12px; overflow: hidden; box-shadow: var(--lb-shadow-float); }
  .gh-results button { display: block; width: 100%; text-align: left; background: none; border: 0; color: var(--lb-bone); padding: .6rem .9rem; cursor: pointer; font-size: .92rem; }
  .gh-results button:hover { background: rgba(127,127,140,.18); }
  .gh-results .sub { color: var(--lb-mist); font-size: .82rem; }
  .gh-loc { margin: 14px 0 0; font-size: var(--lb-small); }
  .gh-next { position: relative; margin-top: 26px; padding: 1.1rem 1.3rem; border-radius: 16px; border-left: 3px solid var(--lb-orange); background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(20px) saturate(180%); backdrop-filter: blur(20px) saturate(180%); box-shadow: inset 0 1px 0 var(--lb-glass-hi); }
  .gh-next__lbl { font-family: var(--lb-font-mono); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-orange-ink); display: block; margin-bottom: 4px; }
  .gh-next__txt { font-size: 1.05rem; color: var(--lb-bone); }
  .gh-next__txt b { color: var(--lb-orange-ink); }
  .gh-wind { position: relative; margin-top: 16px; padding: 1.1rem 1.3rem; border-radius: 16px; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 14px 40px rgba(0,0,0,.22); }
  .gh-wind::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.2px; background: linear-gradient(135deg,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .42; pointer-events: none; }
  .gh-wind__lbl { font-family: var(--lb-font-mono); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-sky); display: block; margin-bottom: 10px; }
  .gh-wind__row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; padding: 9px 0; border-top: 1px solid var(--lb-line); }
  .gh-wind__row:first-of-type { border-top: 0; }
  .gh-wind__when { color: var(--lb-bone); font-size: .92rem; min-width: 200px; flex: 1; }
  .gh-wind__data { color: var(--lb-mist); font-size: .88rem; font-variant-numeric: tabular-nums; }
  .gh-pill { font-family: var(--lb-font-mono); font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; white-space: nowrap; }
  .gh-pill.go { color: var(--lb-green-ink); background: rgba(70,201,95,.14); }
  .gh-pill.care { color: var(--lb-orange-ink); background: rgba(255,154,46,.14); }
  .gh-pill.no { color: #FF6B5E; background: rgba(255,80,71,.14); }
  :root[data-theme="light"] .gh-pill.no { color: #C42B21; background: rgba(196,43,33,.10); }
  @media (prefers-color-scheme: light) { :root:not([data-theme]) .gh-pill.no { color: #C42B21; background: rgba(196,43,33,.10); } }
  .gh-wind__load { color: var(--lb-mist); font-size: .9rem; }
  .gh-wind__fine { color: var(--lb-mist); font-size: .78rem; margin: 10px 0 0; opacity: .9; }
  .gh-grid { margin-top: 22px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .gh-card { position: relative; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); border-radius: 16px; padding: 1.2rem 1.3rem; box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 14px 40px rgba(0,0,0,.26); }
  .gh-card::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.2px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .42; pointer-events: none; }
  .gh-card__ph { font-family: var(--lb-font-mono); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; color: var(--lb-sky); }
  .gh-card__time { font-size: 1.5rem; color: var(--lb-bone); margin: 8px 0 2px; font-variant-numeric: tabular-nums; }
  .gh-card__sub { font-size: .85rem; color: var(--lb-mist); }
  .gh-card.warm { border-color: rgba(255,154,46,.4); }
  .gh-card.warm .gh-card__ph { color: var(--lb-orange-ink); }
  .gh-fine { margin-top: 22px; font-size: .8rem; opacity: .85; }
  @media (max-width: 560px) { .gh-controls { flex-direction: column; align-items: stretch; } }
</style>

<script is:inline>
  (function () {
    var rad = Math.PI / 180, dayMs = 864e5, J1970 = 2440588, J2000 = 2451545, e = rad * 23.4397;
    function toJulian(d) { return d.valueOf() / dayMs - 0.5 + J1970; }
    function fromJulian(j) { return new Date((j + 0.5 - J1970) * dayMs); }
    function toDays(d) { return toJulian(d) - J2000; }
    function decl(l, b) { return Math.asin(Math.sin(b) * Math.cos(e) + Math.cos(b) * Math.sin(e) * Math.sin(l)); }
    function sma(d) { return rad * (357.5291 + 0.98560028 * d); }
    function eclLon(M) { var C = rad * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M)); return M + C + rad * 102.9372 + Math.PI; }
    var J0 = 0.0009;
    function julianCycle(d, lw) { return Math.round(d - J0 - lw / (2 * Math.PI)); }
    function approxTransit(Ht, lw, n) { return J0 + (Ht + lw) / (2 * Math.PI) + n; }
    function solarTransitJ(ds, M, L) { return J2000 + ds + 0.0053 * Math.sin(M) - 0.0069 * Math.sin(2 * L); }
    function hourAngle(h, phi, d) { return Math.acos((Math.sin(h) - Math.sin(phi) * Math.sin(d)) / (Math.cos(phi) * Math.cos(d))); }
    function getTimes(date, lat, lng) {
      var lw = rad * -lng, phi = rad * lat, d = toDays(date), n = julianCycle(d, lw),
        ds = approxTransit(0, lw, n), M = sma(ds), L = eclLon(M), dec = decl(L, 0), Jnoon = solarTransitJ(ds, M, L);
      function ang(h) {
        var w = hourAngle(h * rad, phi, dec), a = approxTransit(w, lw, n), Jset = solarTransitJ(a, M, L), Jrise = Jnoon - (Jset - Jnoon);
        return { rise: fromJulian(Jrise), set: fromJulian(Jset) };
      }
      var s = ang(-0.833), g = ang(6), c = ang(-6);
      return { dawn: c.rise, sunrise: s.rise, goldEnd: g.rise, noon: fromJulian(Jnoon), goldStart: g.set, sunset: s.set, dusk: c.set };
    }
    var dateEl = document.getElementById('ghDate');
    var today = new Date(); dateEl.value = today.toISOString().slice(0, 10);
    var cur = null; // {lat,lng,name,tz}
    function fmt(d) { if (!d || isNaN(d.getTime())) return '—'; var o = { hour: '2-digit', minute: '2-digit' }; if (cur && cur.tz) o.timeZone = cur.tz; return d.toLocaleTimeString('nl-NL', o); }
    function dur(a, b) { if (!a || !b || isNaN(a) || isNaN(b)) return ''; var m = Math.round((b - a) / 60000); return m > 0 ? '· ' + m + ' min' : ''; }
    // — Windvoorspelling (Open-Meteo) op de gouden-uren —
    function tzHourKey(date, tz) {
      var o = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false };
      if (tz) o.timeZone = tz;
      var p = {}; new Intl.DateTimeFormat('en-CA', o).formatToParts(date).forEach(function (x) { p[x.type] = x.value; });
      var hh = p.hour === '24' ? '00' : p.hour;
      return p.year + '-' + p.month + '-' + p.day + 'T' + hh;
    }
    function windVerdict(g) {
      if (g < 20) return { label: 'Go', cls: 'go' };
      if (g < 30) return { label: 'Voorzichtig', cls: 'care' };
      if (g < 40) return { label: 'Alleen ervaren', cls: 'no' };
      return { label: 'No-go', cls: 'no' };
    }
    var windReq = 0;
    function fetchWind(t) {
      var ghW = document.getElementById('ghWind');
      if (!cur) { ghW.hidden = true; return; }
      var ds = dateEl.value, myReq = ++windReq;
      ghW.hidden = false;
      ghW.innerHTML = '<span class="gh-wind__lbl">Wind op de gouden uren</span><span class="gh-wind__load">Windvoorspelling laden…</span>';
      var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + cur.lat + '&longitude=' + cur.lng + '&hourly=wind_speed_10m,wind_gusts_10m&wind_speed_unit=kmh&timezone=auto&start_date=' + ds + '&end_date=' + ds;
      fetch(url).then(function (r) { return r.json(); }).then(function (j) {
        if (myReq !== windReq) return;
        if (!j.hourly || !j.hourly.time) { ghW.innerHTML = '<span class="gh-wind__lbl">Wind op de gouden uren</span><span class="gh-wind__load">Geen windvoorspelling voor deze datum — die reikt ongeveer 16 dagen vooruit.</span>'; return; }
        var rows = [{ n: 'Ochtend · gouden uur', when: t.sunrise }, { n: 'Avond · gouden uur', when: t.sunset }];
        var html = '<span class="gh-wind__lbl">Wind op de gouden uren</span>', any = false;
        rows.forEach(function (row) {
          if (!row.when || isNaN(row.when)) return;
          var key = tzHourKey(row.when, cur.tz);
          var idx = j.hourly.time.findIndex(function (s) { return s.slice(0, 13) === key; });
          if (idx < 0) return;
          any = true;
          var ws = Math.round(j.hourly.wind_speed_10m[idx]), wg = Math.round(j.hourly.wind_gusts_10m[idx]), v = windVerdict(wg);
          html += '<div class="gh-wind__row"><span class="gh-wind__when">' + row.n + ' · ' + fmt(row.when) + '</span><span class="gh-wind__data">' + ws + ' km/h · stoten ' + wg + '</span><span class="gh-pill ' + v.cls + '">' + v.label + '</span></div>';
        });
        html += any
          ? '<p class="gh-wind__fine">Oordeel op basis van windstoten, afgestemd op de DJI Mini 5 Pro (windbestendigheid ± niveau 5). Een voorspelling — check vlak voor vertrek opnieuw, en houd altijd zicht (VLOS).</p>'
          : '<span class="gh-wind__load">Geen uurdata gevonden voor deze tijden.</span>';
        ghW.innerHTML = html;
      }).catch(function () { if (myReq === windReq) ghW.innerHTML = '<span class="gh-wind__lbl">Wind op de gouden uren</span><span class="gh-wind__load">Windvoorspelling kon niet laden.</span>'; });
    }
    function render() {
      if (!cur) return;
      var d = new Date(dateEl.value + 'T12:00:00Z');
      var t = getTimes(d, cur.lat, cur.lng);
      var lbl = new Date(dateEl.value + 'T00:00:00');
      document.getElementById('ghLoc').textContent = cur.name + '  ·  ' + lbl.toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long' });
      var phases = [
        { ph: 'Blauwe uur · ochtend', a: t.dawn, b: t.sunrise, sub: 'Koel, sfeervol — water & steden', warm: false },
        { ph: 'Zonsopkomst', a: t.sunrise, b: null, sub: 'De zon komt op', warm: true },
        { ph: 'Gouden uur · ochtend', a: t.sunrise, b: t.goldEnd, sub: 'Warm, zacht, het beste licht', warm: true },
        { ph: 'Gouden uur · avond', a: t.goldStart, b: t.sunset, sub: 'Warm, zacht, het beste licht', warm: true },
        { ph: 'Zonsondergang', a: t.sunset, b: null, sub: 'De zon gaat onder', warm: true },
        { ph: 'Blauwe uur · avond', a: t.sunset, b: t.dusk, sub: 'Koel, sfeervol — stadslichten', warm: false }
      ];
      var grid = document.getElementById('ghGrid'); grid.innerHTML = '';
      phases.forEach(function (p) {
        var time = p.b ? (fmt(p.a) + ' – ' + fmt(p.b)) : fmt(p.a);
        var el = document.createElement('div'); el.className = 'gh-card lb-reveal in' + (p.warm ? ' warm' : '');
        el.innerHTML = '<span class="gh-card__ph">' + p.ph + '</span><div class="gh-card__time">' + time + '</div><span class="gh-card__sub">' + p.sub + ' ' + (p.b ? dur(p.a, p.b) : '') + '</span>';
        grid.appendChild(el);
      });
      grid.hidden = false;
      fetchWind(t);
      // eerstvolgende venster
      var now = new Date();
      var windows = [
        { n: 'het ochtend-blauwe uur', a: t.dawn, b: t.sunrise },
        { n: 'het ochtend-gouden uur', a: t.sunrise, b: t.goldEnd },
        { n: 'het avond-gouden uur', a: t.goldStart, b: t.sunset },
        { n: 'het avond-blauwe uur', a: t.sunset, b: t.dusk }
      ];
      var nx = document.getElementById('ghNext');
      var todayStr = new Intl.DateTimeFormat('en-CA', cur.tz ? { timeZone: cur.tz } : {}).format(new Date());
      var sameDay = dateEl.value === todayStr;
      if (sameDay) {
        var active = windows.find(function (w) { return now >= w.a && now <= w.b; });
        var up = windows.find(function (w) { return w.a > now; });
        if (active) { nx.innerHTML = '<span class="gh-next__lbl">Nu</span><span class="gh-next__txt">Je zit middenin <b>' + active.n + '</b> — nog ' + Math.round((active.b - now) / 60000) + ' min. Vliegen maar.</span>'; nx.hidden = false; }
        else if (up) { var mins = Math.round((up.a - now) / 60000); var h = Math.floor(mins / 60), m = mins % 60; nx.innerHTML = '<span class="gh-next__lbl">Straks</span><span class="gh-next__txt"><b>' + up.n.charAt(0).toUpperCase() + up.n.slice(1) + '</b> begint om ' + fmt(up.a) + ' — over ' + (h ? h + ' u ' : '') + m + ' min.</span>'; nx.hidden = false; }
        else { nx.hidden = true; }
      } else { nx.hidden = true; }
    }
    function setLoc(lat, lng, name, tz) { cur = { lat: lat, lng: lng, name: name, tz: tz || null }; render(); }
    dateEl.addEventListener('change', render);
    var sEl = document.getElementById('ghSearch'), rEl = document.getElementById('ghResults'), tmr;
    sEl.addEventListener('input', function () {
      var q = sEl.value.trim(); clearTimeout(tmr);
      if (q.length < 2) { rEl.hidden = true; return; }
      tmr = setTimeout(function () {
        fetch('https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(q) + '&count=6&language=nl')
          .then(function (r) { return r.json(); })
          .then(function (j) {
            rEl.innerHTML = '';
            if (!j.results || !j.results.length) { rEl.hidden = true; return; }
            j.results.forEach(function (res) {
              var b = document.createElement('button'); b.type = 'button';
              var sub = [res.admin1, res.country].filter(Boolean).join(', ');
              b.innerHTML = res.name + ' <span class="sub">' + sub + '</span>';
              b.addEventListener('click', function () { sEl.value = res.name; rEl.hidden = true; setLoc(res.latitude, res.longitude, res.name + (res.country ? ', ' + res.country : ''), res.timezone); });
              rEl.appendChild(b);
            });
            rEl.hidden = false;
          }).catch(function () { rEl.hidden = true; });
      }, 300);
    });
    document.addEventListener('click', function (e) { if (!sEl.parentNode.contains(e.target)) rEl.hidden = true; });
    document.getElementById('ghGeo').addEventListener('click', function () {
      var btn = this; if (!navigator.geolocation) { document.getElementById('ghLoc').textContent = 'Locatie niet beschikbaar — kies een plaats.'; return; }
      btn.textContent = 'Locatie ophalen…';
      navigator.geolocation.getCurrentPosition(
        function (pos) { btn.textContent = 'Gebruik mijn locatie'; setLoc(pos.coords.latitude, pos.coords.longitude, 'Mijn locatie'); },
        function () { btn.textContent = 'Gebruik mijn locatie'; document.getElementById('ghLoc').textContent = 'Geen toestemming voor locatie — kies een plaats hierboven.'; }
      );
    });
  })();
</script>
