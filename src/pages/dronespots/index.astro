---
import Base from '../../layouts/Base.astro';
import GlassNav from '../../components/GlassNav.astro';
import Footer from '../../components/Footer.astro';
const U = (id, w = 1200) => `https://images.unsplash.com/photo-${id}?w=${w}&q=76&auto=format&fit=crop`;
const guides = [
  { href: '/curacao/', img: '1753618282728-f05ecfc5c9d6', region: 'Caribbean · ABC-eiland', title: 'Curaçao',
    desc: '34 spots op een exacte kaart met filters, no-fly-zones, de juiste ND- en Pro-instellingen, de mooiste moves én losse Pocket 4-spots vanaf de grond.',
    stats: ['34 spots', 'exacte kaart', 'deelbare PDF'] },
  { href: '/heerde/', img: '1704217392934-0fd66d250056', region: 'Nederland · Veluwe & IJssel', title: 'Heerde & de Veluwe',
    desc: 'Eerlijk in kaart: waar het wél mag (open boerenland, kanaal) en waar niet (Natura 2000), met de regels en een A4-veldkaart.',
    stats: ['13 plekken', 'Natura 2000', 'A4-veldkaart'] },
];
---
<Base
  title="Dronespots — de mooiste plekken om te vliegen en filmen"
  description="Per bestemming een complete dronegids: een exacte kaart met de mooiste spots, de regels die er gelden, de juiste instellingen en een printbare veldkaart. Curaçao, Heerde en de Veluwe, en meer."
  path="/dronespots/">
  <GlassNav active="spots" switchHref="/en/cursussen/" hero />

  <main id="hoofdinhoud" tabindex="-1" class="ds-page">

    <!-- COVER -->
    <section class="ds-cover">
      <div class="ds-bg"></div><div class="ds-scrim"></div>
      <div class="ds-cover-in">
        <span class="ds-kick">Bestemmingsgidsen · lichtbreking</span>
        <h1 class="ds-h1">Dronespots</h1>
        <div class="ds-rule"></div>
        <p class="ds-lead">De mooiste plekken om te vliegen en te filmen — per bestemming een complete gids met een exacte kaart, de regels die er gelden, de juiste instellingen en een printbare veldkaart.</p>
      </div>
    </section>

    <!-- GIDSEN -->
    <section class="ds-sec"><div class="ds-wrap">
      <span class="ds-kick">Kies een bestemming</span>
      <h2 class="ds-h2">De gidsen</h2>
      <div class="ds-grid">
        {guides.map((g) => (
          <a class="ds-card" href={g.href}>
            <div class="ds-card__img" style={`background-image:url('${U(g.img)}')`}></div>
            <div class="ds-card__body">
              <span class="ds-card__region">{g.region}</span>
              <h3 class="ds-card__title">{g.title}</h3>
              <p class="ds-card__desc">{g.desc}</p>
              <div class="ds-card__stats">{g.stats.map((s) => <span>{s}</span>)}</div>
              <span class="ds-card__cta">Bekijk de gids →</span>
            </div>
          </a>
        ))}
        <a class="ds-card ds-card--soon" href="/contact/">
          <div class="ds-card__body">
            <span class="ds-card__region">Binnenkort meer</span>
            <h3 class="ds-card__title">Jouw bestemming?</h3>
            <p class="ds-card__desc">Er komen meer plekken bij. Heb je een favoriete vlieglocatie waar een gids voor zou moeten komen? Laat het weten.</p>
            <span class="ds-card__cta">Tip een locatie →</span>
          </div>
        </a>
      </div>
    </div></section>

    <!-- WAT KRIJG JE -->
    <section class="ds-sec ds-feat"><div class="ds-wrap">
      <span class="ds-kick">In elke gids</span>
      <h2 class="ds-h2">Alles voor een geslaagde vlucht</h2>
      <div class="ds-feats">
        <div class="ds-feat-c"><b>Exacte kaart</b><span>Echte GPS-markers met filters, en per spot het beste licht, de windluwte en de mooiste move.</span></div>
        <div class="ds-feat-c"><b>De regels</b><span>Wat mag wel en niet — registratie, no-fly-zones en beschermde natuur, eerlijk uitgelegd.</span></div>
        <div class="ds-feat-c"><b>Instellingen</b><span>De juiste ND, witbalans en Pro-instellingen voor dat licht, met links naar de cheatsheet.</span></div>
        <div class="ds-feat-c"><b>Veldkaart</b><span>Een printbare A4 (en bij Curaçao een deelbare Instagram-PDF) om mee te nemen.</span></div>
      </div>
      <div class="ds-cta">
        <a class="ds-btn" href="/gereedschap/">ND-calculator &amp; Pro-cheatsheet →</a>
        <a class="ds-btn ds-btn--ghost" href="/artikelen/drone-regels-nederland-eu/">Drone-regels NL &amp; EU</a>
      </div>
    </div></section>

  </main>
  <Footer />
</Base>

<style is:global>
  .ds-page{ --night:#08080A; --bone:#F4F3EF; --mist:#9A9BA1; --gold:var(--lb-gold); --sky:#7FB4D6;
    --spectrum:var(--lb-spectrum-135);
    --mono:ui-monospace,"SF Mono",Menlo,monospace;
    background:var(--night); color:var(--bone); line-height:1.55; overflow-x:hidden; }
  .ds-page :is(h1,h2,h3){ font-family:var(--lb-font-display,inherit); }
  .ds-wrap{ max-width:1080px; margin:0 auto; padding:0 18px; }
  .ds-kick{ font-family:var(--mono); letter-spacing:.22em; text-transform:uppercase; font-size:12px; color:var(--gold); text-shadow:0 1px 10px rgba(0,0,0,.6); }
  .ds-h2{ font-size:clamp(26px,4.4vw,42px); font-weight:800; text-transform:uppercase; letter-spacing:-.01em; margin:8px 0 26px; line-height:1; color:var(--bone); }
  .ds-sec{ position:relative; padding:54px 0; }

  /* COVER */
  .ds-cover{ position:relative; height:72vh; min-height:460px; overflow:hidden; display:flex; }
  .ds-bg{ position:absolute; inset:-4%; background:url('https://images.unsplash.com/photo-1753618282728-f05ecfc5c9d6?w=1900&q=78&auto=format&fit=crop') center/cover; animation:ds-ken 24s ease-in-out infinite alternate; }
  @keyframes ds-ken{0%{transform:scale(1.03)}100%{transform:scale(1.14) translate(-2%,-2%)}}
  .ds-scrim{ position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.45),rgba(0,0,0,.1) 32%,rgba(6,11,15,.94)); }
  .ds-cover-in{ position:relative; z-index:2; max-width:1080px; width:100%; margin:0 auto; align-self:flex-end; padding:0 18px clamp(34px,5vw,60px); }
  .ds-h1{ font-size:clamp(46px,11vw,128px); line-height:.9; font-weight:800; text-transform:uppercase; letter-spacing:-.02em; margin:8px 0 4px; color:#fff; text-shadow:0 6px 50px rgba(0,0,0,.5); }
  .ds-rule{ height:3px; width:200px; border-radius:3px; background:var(--spectrum); margin:16px 0; }
  .ds-lead{ color:#eaf1f4; font-size:15.5px; max-width:60ch; margin:0; text-shadow:0 1px 10px rgba(0,0,0,.6); }

  /* GIDS-KAARTEN */
  .ds-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }
  .ds-card{ position:relative; display:flex; flex-direction:column; border-radius:20px; overflow:hidden; background:rgba(20,22,28,.55); box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 16px 40px rgba(0,0,0,.34); text-decoration:none; color:var(--bone); transition:transform .3s ease; }
  .ds-card::after{ content:""; position:absolute; inset:0; border-radius:inherit; padding:1.3px; background:var(--spectrum); -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; opacity:.32; pointer-events:none; }
  .ds-card:hover{ transform:translateY(-4px); }
  .ds-card__img{ height:200px; background-size:cover; background-position:center; transition:transform .6s cubic-bezier(.2,.7,.2,1); }
  .ds-card:hover .ds-card__img{ transform:scale(1.06); }
  .ds-card__body{ padding:20px; display:flex; flex-direction:column; flex:1; }
  .ds-card__region{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--sky); }
  .ds-card__title{ font-size:26px; font-weight:800; text-transform:uppercase; margin:6px 0 8px; color:var(--bone); }
  .ds-card__desc{ color:var(--mist); font-size:13.5px; margin:0 0 14px; }
  .ds-card__stats{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .ds-card__stats span{ font-family:var(--mono); font-size:11px; color:#dfe2e6; background:rgba(255,255,255,.08); border-radius:8px; padding:4px 9px; }
  .ds-card__cta{ margin-top:auto; font-weight:600; font-size:.95rem; color:var(--gold); }
  .ds-card--soon{ grid-column:1 / -1; }
  .ds-card--soon .ds-card__body{ padding:24px; }
  .ds-card--soon .ds-card__cta{ color:var(--sky); }

  /* FEATURES */
  .ds-feat{ border-top:1px solid rgba(255,255,255,.08); }
  .ds-feats{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:26px; }
  .ds-feat-c{ background:rgba(20,22,28,.5); border-radius:14px; padding:18px; box-shadow:inset 0 1px 0 rgba(255,255,255,.1); }
  .ds-feat-c b{ display:block; font-size:15px; margin-bottom:6px; }
  .ds-feat-c span{ color:var(--mist); font-size:13px; }
  .ds-cta{ display:flex; gap:12px; flex-wrap:wrap; }
  .ds-btn{ display:inline-block; padding:.8rem 1.3rem; border-radius:999px; font-weight:600; font-size:.95rem; text-decoration:none; color:var(--lb-night); background:var(--gold); transition:transform .25s ease; }
  .ds-btn--ghost{ color:var(--bone); background:rgba(255,255,255,.08); box-shadow:inset 0 0 0 1px rgba(255,255,255,.18); }
  .ds-btn:hover{ transform:translateY(-2px); }

  @media(max-width:760px){
    .ds-grid{ grid-template-columns:1fr; }
    .ds-feats{ grid-template-columns:1fr 1fr; }
  }
  @media(prefers-reduced-motion:reduce){ .ds-bg{ animation:none; } }
</style>
