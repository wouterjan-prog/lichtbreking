---
import Base from '../layouts/Base.astro';
import GlassNav from '../components/GlassNav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Gereedschap" description="Gratis drone-tools: ND-filter-calculator, wind go/no-go-checker en een pre-flight checklist. Snel, praktisch, voor onderweg." path="/gereedschap/">
  <GlassNav active="gereedschap" switchHref="/en/cursussen/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main class="lb-container gw-page">
    <header class="gw-head lb-reveal">
      <span class="lb-label lb-label--sky">Gratis tools</span>
      <h1 class="lb-display-l">Gereedschap</h1>
      <p class="lb-lead">Snelle hulpmiddelen voor in het veld: bereken je ND-filter, check of het veilig vliegen is, en loop je pre-flight af. Werkt op je telefoon, niets in te loggen.</p>
    </header>

    <a href="/gouden-uur/" class="gw-link lb-reveal">
      <div>
        <span class="lb-label lb-label--sky">Ook handig</span>
        <strong>Gouden-uur-planner</strong>
        <span class="gw-link__sub">Zie precies wanneer het gouden &amp; blauwe uur vallen op jouw locatie.</span>
      </div>
      <span class="gw-link__arrow">→</span>
    </a>

    <div class="gw-grid">
      <!-- ND-calculator -->
      <section class="gw-card lb-reveal">
        <span class="gw-cap">ND-filter-calculator</span>
        <div class="gw-row">
          <label>Framerate</label>
          <select id="ndFps">
            <option value="24">24 fps</option>
            <option value="25" selected>25 fps</option>
            <option value="30">30 fps</option>
            <option value="50">50 fps</option>
            <option value="60">60 fps</option>
          </select>
        </div>
        <div class="gw-row">
          <label>Sluiterhoek</label>
          <select id="ndAngle">
            <option value="180" selected>180° (cinematisch)</option>
            <option value="90">90° (scherper)</option>
            <option value="360">360° (vloeiend)</option>
          </select>
        </div>
        <div class="gw-row">
          <label>Licht</label>
          <select id="ndLight">
            <option value="8">Bewolkt</option>
            <option value="16" selected>Zonnig</option>
            <option value="32">Felle middagzon</option>
            <option value="64">Water &amp; sneeuw</option>
          </select>
        </div>
        <div class="gw-out" id="ndOut"></div>
        <p class="gw-note">Sluitertijd volgt uit je framerate en sluiterhoek (180° = 2× je framerate). Het ND-filter houdt het licht tegen zodat je die trage sluiter haalt — zonder overbelichting.</p>
      </section>

      <!-- Wind go/no-go -->
      <section class="gw-card lb-reveal">
        <span class="gw-cap">Wind — go / no-go</span>
        <div class="gw-prev" id="windBar"><div class="gw-prev__fill" id="windFill"></div></div>
        <div class="gw-row">
          <label>Wind</label>
          <input type="range" id="windKmh" min="0" max="55" step="1" value="12">
          <span class="gw-val" id="windVal"></span>
        </div>
        <div class="gw-verdictwrap"><span class="gw-verdict" id="windVerdict"></span></div>
        <p class="gw-note" id="windNote"></p>
        <p class="gw-fine">Richtlijn voor de DJI Mini 5 Pro (windbestendigheid ± niveau 5). Houd altijd zicht (VLOS) en check no-fly-zones.</p>
      </section>

      <!-- Pre-flight checklist -->
      <section class="gw-card gw-card--wide lb-reveal">
        <div class="gw-listhead">
          <span class="gw-cap" style="margin:0">Pre-flight checklist</span>
          <span class="gw-count" id="pfCount">0 / 8</span>
        </div>
        <div class="gw-todo" id="pfList"></div>
        <button class="sl-clear gw-reset" id="pfReset">Reset</button>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  .gw-page { padding-top: 130px; padding-bottom: 96px; }
  .gw-head { max-width: 64ch; margin-bottom: 40px; }
  .gw-head h1 { margin: 10px 0 16px; }
  .gw-link { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0 0 24px; padding: 16px 20px; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(20px) saturate(180%); backdrop-filter: blur(20px) saturate(180%); border-radius: 16px; box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 12px 36px rgba(0,0,0,.24); transition: transform var(--lb-dur) var(--lb-ease); }
  .gw-link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.3px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .5; pointer-events: none; }
  .gw-link:hover { transform: translateY(-2px); }
  .gw-link strong { display: block; color: var(--lb-bone); margin: 4px 0 2px; }
  .gw-link__sub { color: var(--lb-mist); font-size: var(--lb-small); }
  .gw-link__arrow { color: var(--lb-sky); font-size: 1.2rem; }
  .gw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: start; }
  .gw-card { position: relative; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(22px) saturate(180%); backdrop-filter: blur(22px) saturate(180%); border-radius: 18px; padding: 1.5rem 1.6rem; box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 16px 44px rgba(0,0,0,.28); }
  .gw-card::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.3px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .42; pointer-events: none; }
  .gw-card > * { position: relative; z-index: 1; }
  .gw-card--wide { grid-column: 1 / -1; }
  .gw-cap { display: block; font-family: var(--lb-font-mono); font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-sky); margin-bottom: 1.1rem; }
  .gw-row { display: flex; align-items: center; gap: 12px; margin: .6rem 0; }
  .gw-row label { font-family: var(--lb-font-mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: var(--lb-mist); width: 86px; }
  .gw-row select, .gw-row input[type=range] { flex: 1; }
  .gw-row select { background: var(--lb-surface); border: 1px solid var(--lb-line); color: var(--lb-bone); border-radius: 10px; padding: .6rem .7rem; font-size: .95rem; font-family: var(--lb-font-text); }
  .gw-row input[type=range] { accent-color: var(--lb-sky); }
  .gw-val { font-family: var(--lb-font-mono); font-size: .85rem; color: var(--lb-bone); width: 78px; text-align: right; }
  .gw-out { margin-top: 1rem; padding: 1rem 1.1rem; border-radius: 12px; border-left: 3px solid var(--lb-orange); background: rgba(255,154,46,.07); font-size: 1rem; color: var(--lb-bone); line-height: 1.6; }
  .gw-out b { color: var(--lb-orange-ink); }
  .gw-note { font-size: .85rem; color: var(--lb-mist); margin: 1rem 0 0; }
  .gw-fine { font-size: .78rem; color: var(--lb-mist); margin: .7rem 0 0; opacity: .8; }
  .gw-prev { height: 10px; border-radius: 6px; background: linear-gradient(90deg,#46C95F 0%,#46C95F 33%,#FF9A2E 33%,#FF9A2E 60%,#e0584d 60%,#e0584d 100%); position: relative; margin-bottom: 1.1rem; }
  .gw-prev__fill { position: absolute; top: -4px; width: 3px; height: 18px; border-radius: 2px; background: var(--lb-bone); transition: left .12s linear; }
  .gw-verdictwrap { margin-top: 1rem; }
  .gw-verdict { display: inline-block; font-family: var(--lb-font-mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; padding: 6px 14px; border-radius: 999px; }
  .gw-verdict.go { background: rgba(70,201,95,.16); color: var(--lb-green-ink); }
  .gw-verdict.care { background: rgba(255,154,46,.18); color: var(--lb-orange-ink); }
  .gw-verdict.no { background: rgba(224,88,77,.18); color: #e0584d; }
  .gw-listhead { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
  .gw-count { font-family: var(--lb-font-mono); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--lb-mist); }
  .gw-todo { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .gw-item { display: flex; gap: .7rem; align-items: center; background: var(--lb-surface); border: 1px solid rgba(127,127,140,.14); border-radius: 10px; padding: .65rem .85rem; cursor: pointer; font-size: .95rem; color: var(--lb-bone); }
  .gw-item input { width: 18px; height: 18px; accent-color: var(--lb-green-ink); flex: 0 0 auto; cursor: pointer; }
  .gw-item.done { opacity: .55; }
  .gw-item.done span { text-decoration: line-through; }
  .gw-reset { margin-top: 1rem; background: none; border: 0; color: var(--lb-mist); font-family: var(--lb-font-mono); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .gw-reset:hover { color: var(--lb-orange); }
  @media (max-width: 760px) { .gw-grid { grid-template-columns: 1fr; } .gw-todo { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var ndCond = { '8': 'bewolkt licht', '16': 'zonnig', '32': 'felle middagzon', '64': 'water of sneeuw' };
    var ndStops = { '8': 3, '16': 4, '32': 5, '64': 6 };
    function nd() {
      var fps = +document.getElementById('ndFps').value;
      var angle = +document.getElementById('ndAngle').value;
      var denom = Math.round(fps * 360 / angle);
      var L = document.getElementById('ndLight').value;
      document.getElementById('ndOut').innerHTML =
        '<b>' + fps + ' fps</b> bij <b>' + angle + '°</b> → richt op sluiter <b>1/' + denom + '</b>.<br>Licht <b>' + ndCond[L] + '</b> → gebruik <b>ND' + L + '</b> (−' + ndStops[L] + ' stops).';
    }
    document.getElementById('ndFps').addEventListener('change', nd);
    document.getElementById('ndAngle').addEventListener('change', nd);
    document.getElementById('ndLight').addEventListener('change', nd);
    nd();

    var bft = [['0','windstil'],['1','flauw'],['2','zwak'],['3','matig'],['4','matig'],['5','vrij krachtig'],['6','krachtig']];
    function beaufort(k) { if (k < 1) return bft[0]; if (k < 6) return bft[1]; if (k < 12) return bft[2]; if (k < 20) return bft[3]; if (k < 29) return bft[4]; if (k < 39) return bft[5]; return bft[6]; }
    function wind() {
      var k = +document.getElementById('windKmh').value;
      var b = beaufort(k);
      document.getElementById('windVal').textContent = k + ' km/h';
      document.getElementById('windFill').style.left = (k / 55 * 100) + '%';
      var v = document.getElementById('windVerdict'), n = document.getElementById('windNote');
      if (k < 19) { v.textContent = 'Go'; v.className = 'gw-verdict go'; n.textContent = 'Prima om te vliegen — rustige, stabiele beelden. Beaufort ' + b[0] + ' (' + b[1] + ').'; }
      else if (k < 28) { v.textContent = 'Voorzichtig'; v.className = 'gw-verdict care'; n.textContent = 'Kan, maar vlieg lager, neus tegen de wind en reken op kortere vluchttijd. Beaufort ' + b[0] + ' (' + b[1] + ').'; }
      else if (k < 38) { v.textContent = 'Alleen ervaren'; v.className = 'gw-verdict no'; n.textContent = 'Tegen de windlimiet van de Mini 5 Pro. Risico op drift en signaalverlies — alleen als je weet wat je doet. Beaufort ' + b[0] + ' (' + b[1] + ').'; }
      else { v.textContent = 'No-go'; v.className = 'gw-verdict no'; n.textContent = 'Boven de windbestendigheid. Niet vliegen — wacht op rustiger weer. Beaufort ' + b[0] + ' (' + b[1] + ').'; }
    }
    document.getElementById('windKmh').addEventListener('input', wind);
    wind();

    var PF = ['Accu’s vol & in de drone', 'Props/armen uitgeklapt, lens schoon', 'Wacht op GPS-fix', 'No-fly-zones gecheckt', 'Wind gecheckt (zie boven)', 'RTH-hoogte > hoogste object', 'SD-kaart heeft ruimte', 'Zicht op de drone (VLOS)'];
    var KEY = 'lb-preflight';
    var list = document.getElementById('pfList'), cnt = document.getElementById('pfCount');
    function load() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
    function save(a) { try { localStorage.setItem(KEY, JSON.stringify(a)); } catch (e) {} }
    var done = load();
    function render() {
      list.innerHTML = ''; var c = 0;
      PF.forEach(function (t, i) {
        var on = done.indexOf(i) !== -1; if (on) c++;
        var lab = document.createElement('label'); lab.className = 'gw-item' + (on ? ' done' : '');
        var cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = on;
        cb.addEventListener('change', function () { var idx = done.indexOf(i); if (cb.checked && idx === -1) done.push(i); else if (!cb.checked && idx !== -1) done.splice(idx, 1); save(done); render(); });
        var sp = document.createElement('span'); sp.textContent = t;
        lab.appendChild(cb); lab.appendChild(sp); list.appendChild(lab);
      });
      cnt.textContent = c + ' / ' + PF.length;
    }
    document.getElementById('pfReset').addEventListener('click', function () { done = []; save(done); render(); });
    render();
  })();
</script>
