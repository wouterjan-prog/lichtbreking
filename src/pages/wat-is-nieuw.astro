---
import Base from '../layouts/Base.astro';
import GlassNav from '../components/GlassNav.astro';
import Footer from '../components/Footer.astro';

/* Categorieën: new (oranje) · imp (groen, verbeterd) · tool (blauw) */
const TAGS = { new: 'Nieuw', imp: 'Verbeterd', tool: 'Tool' };

const entries = [
  { month: 'Juni 2026', date: '28 juni', tag: 'new', title: 'Aruba-gids + drone-regels & gear-artikelen',
    body: 'Een nieuwe Aruba-gids met exacte kaart, filters en print-veldkaart, plus twee nieuwe rekenhulpen (vliegtijd/accu en hoogte→beeld) en drie artikelen: alle Pro-instellingen, drone-regels NL/EU, en welke drone & accessoires je nodig hebt.',
    link: ['Bekijk de Aruba-gids →', '/aruba/'] },
  { month: 'Juni 2026', date: '28 juni', tag: 'new', title: 'Curaçao-gids met exacte kaart',
    body: 'Een complete gids voor dronevliegen en filmen op Curaçao: 30+ spots op een echte kaart met GPS-markers en filters, no-fly-zones, de juiste ND- en Pro-instellingen, de beste moves én losse Pocket 4-spots om vanaf de grond te filmen.',
    link: ['Bekijk de gids →', '/curacao/'] },
  { month: 'Juni 2026', date: '27 juni', tag: 'tool', title: 'Weer in de gouden-uur-planner',
    body: 'Per lichtvenster zie je nu de voorspelde wind, windstoten, windrichting, bewolking, regenkans en temperatuur — met een go/no-go-oordeel voor de DJI Mini 5 Pro, recht in elke venster-kaart.',
    link: ['Open de planner →', '/gouden-uur/'] },
  { month: 'Juni 2026', date: '26 juni', tag: 'tool', title: 'Gouden-uur-planner — wereldwijd',
    body: 'Zoek elke plaats ter wereld en zie zonsop-/ondergang, gouden en blauwe uur in de juiste tijdzone. Plan je shoot op het mooiste licht, waar je ook bent.',
    link: ['Open de planner →', '/gouden-uur/'] },
  { month: 'Juni 2026', date: '25 juni', tag: 'new', title: 'Gereedschap-pagina',
    body: 'Een ND-filter-calculator (sluiterhoek 180°/90°/360°), een wind go/no-go-checker en een pre-flight checklist die je vinkjes onthoudt — snel en praktisch voor onderweg.',
    link: ['Bekijk het gereedschap →', '/gereedschap/'] },
  { month: 'Juni 2026', date: '24 juni', tag: 'imp', title: 'Nieuwe ‘liquid glass’-vormgeving',
    body: 'De hele site kreeg een frosted-glass look met spectrum-randen en een zachte gloed — én een snellere weergave. Lichte en donkere modus zijn overal op leesbaarheid gecontroleerd.',
    link: null },
  { month: 'Juni 2026', date: '22 juni', tag: 'new', title: 'Gratis veldkaarten (PDF)',
    body: 'Download de veldkaarten van beide cursussen als handige A4-PDF om mee te nemen of te printen — instellingen, shot-recepten en checklists in je zak.',
    link: ['Naar de cursussen →', '/cursussen/'] },
  { month: 'Eerder', date: 'Mei 2026', tag: 'imp', title: 'Interactieve lessen & kennischecks',
    body: 'Per module een ‘In het kort’, een ‘Doe dit nu’-actiekaart, een belichtings-simulator, drone-hotspots en een kennischeck met voortgang en diploma.',
    link: null },
  { month: 'Eerder', date: 'Mei 2026', tag: 'new', title: 'Twee gratis cursussen',
    body: 'De Vluchtfilmer (DJI Mini 5 Pro) en De Grondfilmer (Osmo Pocket 4) — van eerste opstart tot afgemonteerde cinematische film.',
    link: ['Naar de cursussen →', '/cursussen/'] },
];

// groepeer op maand, volgorde behouden
const months = [];
for (const e of entries) {
  let g = months.find((m) => m.h === e.month);
  if (!g) { g = { h: e.month, items: [] }; months.push(g); }
  g.items.push(e);
}
---
<Base title="Wat is nieuw" description="Het logboek van lichtbreking.nl — nieuwe lessen, gratis gereedschap en verbeteringen. Deze site groeit in het openbaar." path="/wat-is-nieuw/">
  <GlassNav active="nieuw" switchHref="/en/cursussen/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container wn-page">
    <header class="wn-head lb-reveal">
      <span class="lb-label lb-label--sky">Logboek</span>
      <h1 class="lb-display-l">Wat is nieuw</h1>
      <p class="lb-lead">Deze site groeit in het openbaar. Hier zie je wat er recent is bijgekomen of verbeterd — van nieuwe lessen tot gratis gereedschap.</p>
      <p class="wn-sub lb-muted">Volg mee op <a href="https://www.instagram.com/lichtbreking/" target="_blank" rel="noopener">Instagram&nbsp;@lichtbreking</a> voor updates tussendoor.</p>
    </header>

    {months.map((m) => (
      <section class="wn-month-block">
        <h2 class="wn-month">{m.h}</h2>
        <div class="wn-feed">
          {m.items.map((e) => (
            <article class:list={["wn-entry lb-reveal", e.tag]}>
              <div class="wn-card">
                <div class="wn-meta">
                  <span class="wn-date">{e.date}</span>
                  <span class:list={["wn-tag", e.tag]}>{TAGS[e.tag]}</span>
                </div>
                <h3 class="wn-title">{e.title}</h3>
                <p class="wn-body">{e.body}</p>
                {e.link && <a class="wn-go" href={e.link[1]}>{e.link[0]}</a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="wn-fine lb-muted lb-reveal">Mis je iets of heb je een wens? <a href="/contact/">Laat het weten</a> — ik bouw deze site stap voor stap verder uit.</p>
  </main>
  <Footer />
</Base>

<style>
  .wn-page { padding-top: 130px; padding-bottom: 96px; max-width: 820px; }
  .wn-head { margin-bottom: 40px; }
  .wn-head h1 { margin: 10px 0 16px; }
  .wn-sub { margin: 14px 0 0; font-size: var(--lb-small); }
  .wn-sub a { color: var(--lb-sky); }
  .wn-month { font-family: var(--lb-font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--lb-mist); margin: 0 0 16px; opacity: .8; }
  .wn-month-block + .wn-month-block .wn-month { margin-top: 36px; }

  .wn-feed { position: relative; margin-left: 7px; padding-left: 34px; }
  .wn-feed::before { content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: linear-gradient(180deg,#FF9A2E,#46C95F,#2F7CF0,#9B4DDB); opacity: .5; }
  .wn-entry { position: relative; margin-bottom: 16px; }
  .wn-entry::before { content: ""; position: absolute; left: -34px; top: 22px; width: 12px; height: 12px; border-radius: 50%; background: var(--lb-night); border: 2px solid var(--lb-orange-ink); box-shadow: 0 0 0 4px var(--lb-night); }
  .wn-entry.imp::before { border-color: var(--lb-green-ink); }
  .wn-entry.tool::before { border-color: var(--lb-sky); }

  .wn-card { position: relative; background: var(--lb-glass-card-bg); -webkit-backdrop-filter: blur(16px) saturate(170%); backdrop-filter: blur(16px) saturate(170%); border-radius: 16px; padding: 18px 20px; box-shadow: inset 0 1px 0 var(--lb-glass-hi), 0 14px 40px rgba(0,0,0,.24); }
  .wn-card::after { content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 1.2px; background: linear-gradient(135deg,#FF5147,#FF9A2E,#FFD23E,#46C95F,#2FB8C4,#2F7CF0,#9B4DDB); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; opacity: .34; pointer-events: none; }
  .wn-card > * { position: relative; z-index: 1; }
  .wn-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .wn-date { font-family: var(--lb-font-mono); font-size: .72rem; letter-spacing: .04em; color: var(--lb-mist); }
  .wn-tag { font-family: var(--lb-font-mono); font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; padding: 3px 9px; border-radius: 20px; }
  .wn-tag.new { color: var(--lb-orange-ink); background: rgba(255,154,46,.14); }
  .wn-tag.imp { color: var(--lb-green-ink); background: rgba(70,201,95,.14); }
  .wn-tag.tool { color: var(--lb-sky); background: rgba(47,124,240,.16); }
  .wn-title { font-size: 1.15rem; margin: 2px 0 6px; }
  .wn-body { color: var(--lb-mist); font-size: var(--lb-small); margin: 0; }
  .wn-go { display: inline-block; margin-top: 10px; color: var(--lb-sky); font-size: var(--lb-small); transition: opacity .2s var(--lb-ease); }
  .wn-go:hover { opacity: .8; }
  .wn-fine { margin-top: 36px; font-size: var(--lb-small); }
  .wn-fine a { color: var(--lb-sky); }
  @media (max-width: 560px) { .wn-feed { padding-left: 26px; } .wn-entry::before { left: -26px; } }
</style>
