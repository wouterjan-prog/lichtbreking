---
import Base from '../../../layouts/Base.astro';
import GlassNav from '../../../components/GlassNav.astro';
import Footer from '../../../components/Footer.astro';
import { src, srcset } from '../../../data/work.js';

const devices = [
  {
    tag: 'Drone · from the air',
    name: 'DJI Mini 5 Pro',
    blurb: 'You fly and film from the air. Start here for your settings, your first flight and cinematic movements.',
    cls: 'mini',
    photo: '1640958903837-ce7bc6060501',
    links: [
      ['Course: The Flight Filmer', '/en/cursus/vluchtfilmer/'],
      ['The settings I lock in', '/en/artikelen/dji-mini-5-pro-instellingen/'],
      ['The 7 cinematic drone movements', '/en/artikelen/mini-5-pro-cinematische-bewegingen/'],
      ['Smoother & safer flying', '/en/artikelen/cinematische-besturing-veiligheid-mini-5-pro/'],
    ],
  },
  {
    tag: 'Handheld · at eye level',
    name: 'DJI Osmo Pocket 4',
    blurb: 'You film on the ground with the gimbal camera. Start here for your settings, gimbal modes and smooth walking techniques.',
    cls: 'pocket',
    photo: '1762740522491-2a4f7c754816',
    links: [
      ['Course: The Ground Filmer', '/en/cursus/grondfilmer/'],
      ['The settings I lock in', '/en/artikelen/osmo-pocket-4-instellingen/'],
      ['Gimbal movements & modes', '/en/artikelen/pocket-4-gimbalbewegingen/'],
      ['Pocket 4 guide: all settings', '/en/gids/pocket-4/'],
    ],
  },
  {
    tag: 'Action & underwater',
    name: 'DJI Osmo Action 6',
    blurb: 'You film action and underwater. Start here for your settings, the variable aperture and filterless underwater with Dive mode.',
    cls: 'action',
    photo: '1753618282728-f05ecfc5c9d6',
    links: [
      ['Course: The Action Filmer', '/en/cursus/actiefilmer/'],
      ['Action 6 guide: all settings', '/en/gids/action-6/'],
      ['Filming underwater (filterless)', '/en/artikelen/onderwater-action-instellingen/'],
    ],
  },
];

const steps = [
  ['Know your device', 'Learn where the buttons are and what the modes do — before you shoot your first take.'],
  ['Lock in your settings', 'Pro mode, 4K, 25 fps, shutter 1/50 s, ISO 100, white balance manual ~5500 K. Nothing on auto.'],
  ['Understand the 180° rule', 'Your shutter speed ≈ 2× your frame rate. That gives natural, filmic movement — and determines your ND filter.'],
  ['Compose deliberately', 'Rule of thirds, leading lines, a level horizon and depth in the foreground.'],
  ['Move with intent', 'One slow, smooth movement per shot. Slower nearly always looks more expensive.'],
  ['Edit into a story', 'Alternate wide, medium and detail shots, cut to the music, and build a beginning-middle-end.'],
];

const jsonld = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: 'Start here — Lichtbreking', inLanguage: 'en-GB',
  url: 'https://www.lichtbreking.nl/en/start/',
};
---
<Base
  lang="en" hasEn={true}
  title="Start here — choose your device and begin filming cinematically"
  description="New to Lichtbreking? Choose your device — DJI Mini 5 Pro, Osmo Pocket 4 or Osmo Action 6 — and follow the path to cinematic footage: settings, technique, movement and editing."
  path="/start/" image="/img/og-start.png"
  jsonld={jsonld}>
  <GlassNav active="" lang="en" hasEn={true} switchHref="/start/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container start-page">
    <header class="start-head lb-reveal">
      <span class="lb-label lb-label--sky">Start here</span>
      <h1 class="lb-display-l">Which device do you have?</h1>
      <p class="lb-lead">Choose your camera and you'll get the right path straight away: the settings, the technique and the movements that work for your device. Got both? All the better — together, air and ground make one film.</p>
    </header>

    <div class="dev-grid">
      {devices.map((d) => (
        <div id={d.cls} class={`dev-card lb-reveal ${d.cls}`}>
          <img class="dev-photo" src={src(d.photo, 900)} srcset={srcset(d.photo)} sizes="(max-width: 760px) 100vw, 360px" alt={d.name} width="900" height="320" loading="lazy" decoding="async" />
          <span class="dev-tag lb-label">{d.tag}</span>
          <h2 class="dev-name">{d.name}</h2>
          <p class="dev-blurb">{d.blurb}</p>
          <ul class="dev-links">
            {d.links.map(([label, href]) => (
              <li><a href={href}>{label} <span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <section class="start-path lb-reveal">
      <span class="lb-label lb-label--sky">New to cinematic filming?</span>
      <h2 class="lb-display-m">The path in 6 steps</h2>
      <p class="lb-lead">Whether you have a drone or a gimbal — this is the order from flat clip to filmic footage.</p>
      <ol class="path-list">
        {steps.map(([t, b], i) => (
          <li class="path-step">
            <span class="path-num">{String(i + 1).padStart(2, '0')}</span>
            <div><strong>{t}</strong><p>{b}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="start-more lb-reveal">
      <div class="more-card">
        <h3>Colour your footage</h3>
        <p>Filming in D-Log M or D-Log? Learn to grade it into a cinematic look.</p>
        <a href="/en/cursus/kleurfilmer/" class="more-link">The Colour Filmer →</a>
      </div>
      <div class="more-card">
        <h3>Don't get the terms?</h3>
        <p>ISO, shutter speed, white balance, LUT — all the film jargon explained in one sentence.</p>
        <a href="/en/begrippen/" class="more-link">To the glossary →</a>
      </div>
      <div class="more-card">
        <h3>All articles</h3>
        <p>In-depth guides on technique, light, editing, rules and destinations.</p>
        <a href="/en/artikelen/" class="more-link">To the articles →</a>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Base>

<style is:global>
  .start-page { padding-top: 130px; padding-bottom: 96px; }
  .start-head { max-width: 64ch; margin-bottom: 38px; }
  .start-head h1 { margin: 10px 0 16px; }

  .dev-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 60px; }
  @media (max-width: 760px) { .dev-grid { grid-template-columns: 1fr; } }
  .dev-card { position: relative; scroll-margin-top: 92px; border-radius: 18px; padding: 26px 26px 24px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); overflow: hidden; }
  .dev-photo { display: block; width: calc(100% + 52px); height: 158px; object-fit: cover; margin: -26px -26px 18px; }
  .dev-card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; z-index: 2; }
  .dev-card.mini::before { background: linear-gradient(90deg,#7c2d12,#ea580c 60%,#fb923c); }
  .dev-card.pocket::before { background: linear-gradient(90deg,#9d174d,#db2777 60%,#f9a8d4); }
  .dev-tag { display: block; margin-bottom: 8px; }
  .dev-name { font-size: 1.55rem; font-weight: 600; color: var(--lb-bone); margin: 0 0 10px; }
  .dev-blurb { color: var(--lb-mist); line-height: 1.6; margin: 0 0 18px; font-size: .98rem; }
  .dev-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .dev-links li { border-top: 1px solid var(--lb-line); }
  .dev-links a { display: flex; justify-content: space-between; gap: 12px; padding: 12px 2px; color: var(--lb-bone); font-weight: 500; font-size: .98rem; transition: color var(--lb-dur) var(--lb-ease); }
  .dev-links a:hover { color: var(--lb-sky); }
  .dev-links a span { color: var(--lb-sky); }

  .start-path { max-width: 820px; margin-bottom: 56px; }
  .start-path h2 { margin: 8px 0 10px; }
  .path-list { list-style: none; counter-reset: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 680px) { .path-list { grid-template-columns: 1fr; } }
  .path-step { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: 14px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); }
  .path-num { font-family: var(--lb-font-mono); font-size: .9rem; font-weight: 700; color: var(--lb-sky); flex: 0 0 auto; }
  .path-step strong { color: var(--lb-bone); display: block; margin-bottom: 4px; }
  .path-step p { color: var(--lb-mist); margin: 0; font-size: .92rem; line-height: 1.55; }

  .start-more { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 760px) { .start-more { grid-template-columns: 1fr; } }
  .more-card { padding: 22px; border-radius: 14px; background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); }
  .more-card h3 { color: var(--lb-bone); margin: 0 0 8px; font-size: 1.1rem; }
  .more-card p { color: var(--lb-mist); margin: 0 0 14px; font-size: .92rem; line-height: 1.55; }
  .more-link { color: var(--lb-sky); font-weight: 600; font-size: .92rem; }
</style>
