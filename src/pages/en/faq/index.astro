---
import Base from '../../../layouts/Base.astro';
import GlassNav from '../../../components/GlassNav.astro';
import Footer from '../../../components/Footer.astro';

// q = vraag · a = antwoord (platte tekst, ook voor schema) · link = [label, href] (optioneel)
const faqs = [
  { q: 'Do I need a drone licence for my drone?',
    a: 'For a drone of 250 grams or heavier you need the EU drone licence A1/A3 and you must register as an operator with the RDW. A drone under 250 grams without a camera does not have to be registered; with a camera you do need to register, but you do not need a drone licence in that case.',
    link: ['Read the full drone rules', '/en/artikelen/drone-regels-nederland-eu/'] },
  { q: 'Which ND filter do I need and when?',
    a: 'An ND filter blocks light so that you can stay at a shutter speed of 1/50 s. Rule of thumb: ND8 when overcast, ND16 in sunshine, ND32 in bright midday sun and ND64 over white sand or reflective water.',
    link: ['To the ND calculator', '/en/gereedschap/'] },
  { q: 'Which settings give a cinematic look?',
    a: '4K, 24 or 25 fps, shutter speed 1/50 s (the 180° rule), ISO 100, white balance set manually to about 5500 K, colour profile Normal and sharpness −1. Leaving white balance on auto is the biggest pitfall.',
    link: ['All Pro settings explained', '/en/artikelen/pro-instellingen-uitgelegd/'] },
  { q: 'Am I allowed to fly on the Veluwe?',
    a: 'No, large parts of the Veluwe (forest and heath) and of the IJssel floodplains are Natura 2000 areas, where flying a drone is prohibited. Fly over open farmland outside those protected areas, under the ordinary EU rules, and check the exact boundaries beforehand.',
    link: ['View the Heerde & Veluwe guide', '/en/heerde/'] },
  { q: 'Can I take my drone to Curaçao?',
    a: 'Yes, but registration is compulsory there: register your drone in advance with the RAC and check the rules of the CCAA. Without proof of registration your drone may be confiscated at customs.',
    link: ['Read the Curaçao guide', '/en/curacao/'] },
  { q: 'How do I film underwater while snorkelling or diving?',
    a: 'Set your white balance to the underwater mode (or manually to ~5500 K just below the surface). The DJI Osmo Action 6 is waterproof to 20 metres without a housing; deeper than that you use the Dive Case. This camera films filterless, so you do not use colour filters underwater — you correct the colour in the settings and afterwards. Get close and keep the sun behind you.',
    link: ['Underwater settings (DJI Osmo Action 6)', '/en/artikelen/onderwater-action-instellingen/'] },
  { q: 'How long can I fly on a single battery?',
    a: 'In practice, reckon on about 30 minutes per battery. The DJI Mini 5 Pro is around 36 minutes on paper, but wind and active filming bring that down to some 25 to 30 minutes. Always return at your reserve limit (for example 30%), not at 0%, and keep extra margin in hand for the return flight when flying into a headwind.',
    link: ['Work out your safe flight time', '/en/gereedschap/'] },
  { q: 'Which drone is best to buy as a beginner?',
    a: 'For most people a light drone under 250 grams (the Mini class) is the smartest start: it fits in a coat pocket, falls under the most lenient rules and still delivers excellent footage. The most important accessory is an ND filter set.',
    link: ['Which drone & accessories?', '/en/artikelen/welke-drone-en-accessoires/'] },
  { q: 'What is the golden hour and why is it so beautiful?',
    a: 'The golden hour is the first hour after sunrise and the last hour before sunset. The light is warm, soft and low, with long shadows — ideal for cinematic footage.',
    link: ['Open the golden hour planner', '/en/gouden-uur/'] },
  { q: 'Are the courses really free?',
    a: 'Yes. The Flight Filmer (DJI Mini 5 Pro) and The Ground Filmer (Osmo Pocket 4) are both completely free — from first start-up to a fully edited cinematic film.',
    link: ['To the courses', '/en/cursussen/'] },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Frequently asked questions about drone flying and filming"
  description="Answers to frequently asked questions about drone flying: the drone licence and the rules, ND filters and settings, flying on the Veluwe and on Curaçao, filming underwater, and the free courses."
  path="/faq/" image="/img/og-faq.png"
  lang="en" hasEn={true}
  jsonld={jsonld}>
  <GlassNav active="" lang="en" hasEn={true} switchHref="/faq/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container faq-page">
    <header class="faq-head lb-reveal">
      <span class="lb-label lb-label--sky">Frequently asked questions</span>
      <h1 class="lb-display-l">Questions &amp; answers</h1>
      <p class="lb-lead">The things people ask most often about drone flying, the rules, the settings and the courses — answered briefly and clearly.</p>
    </header>

    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item lb-reveal">
          <summary><span>{f.q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <div class="faq-a">
            <p>{f.a}</p>
            {f.link && <a href={f.link[1]} class="faq-link">{f.link[0]} →</a>}
          </div>
        </details>
      ))}
    </div>

    <div class="faq-cta lb-reveal">
      <span class="lb-label lb-label--sky">Is your question not listed?</span>
      <h2 class="lb-display-m">Feel free to ask it</h2>
      <p class="lb-lead">Run into something or missing anything? Let me know — I am happy to help.</p>
      <a href="/en/contact/" class="lb-btn">To contact →</a>
    </div>
  </main>
  <Footer lang="en" />
</Base>

<style is:global>
  .faq-page { padding-top: 130px; padding-bottom: 96px; }
  .faq-head { max-width: 64ch; margin-bottom: 34px; }
  .faq-head h1 { margin: 10px 0 16px; }
  .faq-list { max-width: 760px; display: flex; flex-direction: column; gap: 12px; }
  .faq-item { background: var(--lb-glass-card-bg); border: 1px solid var(--lb-glass-border); border-radius: 14px; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); overflow: hidden; }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; font-size: 1.05rem; font-weight: 500; color: var(--lb-bone); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { position: relative; flex: 0 0 auto; width: 16px; height: 16px; }
  .faq-plus::before, .faq-plus::after { content: ""; position: absolute; background: var(--lb-sky); border-radius: 2px; transition: transform .25s var(--lb-ease); }
  .faq-plus::before { left: 0; right: 0; top: 7px; height: 2px; }
  .faq-plus::after { top: 0; bottom: 0; left: 7px; width: 2px; }
  .faq-item[open] .faq-plus::after { transform: scaleY(0); }
  .faq-a { padding: 0 20px 20px; color: var(--lb-mist); line-height: 1.65; }
  .faq-a p { margin: 0 0 .6rem; font-size: .98rem; }
  .faq-link { color: var(--lb-sky); font-size: .92rem; text-decoration: underline; text-underline-offset: 2px; }
  .faq-cta { margin-top: 52px; padding-top: 34px; border-top: 1px solid var(--lb-line); max-width: 760px; }
  .faq-cta h2 { margin: 8px 0 10px; }
  .faq-cta .lb-btn { margin-top: 8px; }
</style>
