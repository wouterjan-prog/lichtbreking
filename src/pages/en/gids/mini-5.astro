---
import Base from '../../../layouts/Base.astro';
import GlassNav from '../../../components/GlassNav.astro';
import Footer from '../../../components/Footer.astro';
import SpectrumRule from '../../../components/SpectrumRule.astro';
import { proSettings } from '../../../data/prosettings.js';

const mini = proSettings.find((s) => s.cam === 'mini');
const tr = (val) => (val && typeof val === 'object' ? val.en : val);

const jsonld = {
  '@context': 'https://schema.org', '@type': 'TechArticle',
  headline: 'DJI Mini 5 Pro — cinematic settings & field card',
  inLanguage: 'en', url: 'https://www.lichtbreking.nl/en/gids/mini-5/',
};
---
<Base
  title="DJI Mini 5 Pro: cinematic settings — the field card"
  description="The field card for the DJI Mini 5 Pro: setup ritual, ND choice and the best settings per scene. Printable PDF included."
  path="/gids/mini-5/" image="/img/og-art-dji-mini-5-pro-instellingen.png"
  lang="en" hasEn={true}
  jsonld={jsonld}>
  <GlassNav active="" lang="en" hasEn={true} switchHref="/gids/mini-5/" />
  <div class="lb-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
  <main id="hoofdinhoud" tabindex="-1" class="lb-container m5-page">
    <header class="m5-head lb-reveal">
      <span class="lb-label lb-label--sky">Guide · DJI Mini 5 Pro</span>
      <h1 class="lb-display-l">Mini 5 Pro: fly slow, lock exposure</h1>
      <p class="lb-lead">The quick reference for cinematic drone footage. DJI Fly has no camera presets, but it remembers your settings; per flight you only touch ND, white balance and ISO. The full field card (with per-scene recipes) currently lives on the Dutch page, printable as PDF.</p>
      <div class="m5-cta">
        <a href="/downloads/veldkaart-mini-5-pro.pdf" class="lb-btn" download>Field card (PDF, print-ready) ↓</a>
        <a href="/gids/mini-5/" class="lb-btn lb-btn--ghost">Full guide (Dutch) →</a>
        <a href="/en/pro-settings/" class="lb-btn lb-btn--ghost">Pro settings overview →</a>
      </div>
      <div class="m5-rule"><SpectrumRule width="160px" thickness={3} /></div>
    </header>

    <section class="m5-block lb-reveal">
      <span class="lb-label lb-label--sky">Core values</span>
      <h2 class="lb-display-m">The settings I lock in</h2>
      <div class="m5-rows">
        {mini.rows.map((r) => (
          <div class="m5-row">
            <span class="m5-k">{tr(r.k)}</span>
            <span class="m5-v">{tr(r.v)}</span>
            <span class="m5-w">{tr(r.why)}</span>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Base>

<style is:global>
  .m5-page { padding-top: 130px; padding-bottom: 96px; }
  .m5-head { max-width: 64ch; margin-bottom: 20px; }
  .m5-head h1 { margin: 10px 0 16px; }
  .m5-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .m5-rule { margin-top: 26px; }
  .m5-block { margin-top: 52px; max-width: 900px; }
  .m5-block h2 { margin: 8px 0 18px; }
  .m5-rows { display: flex; flex-direction: column; }
  .m5-row { display: grid; grid-template-columns: 150px 200px 1fr; gap: 20px; padding: 12px 0; border-top: 1px solid var(--lb-line); align-items: baseline; }
  .m5-k { font-weight: 600; font-size: 15px; }
  .m5-v { font-family: var(--lb-font-mono); font-size: 13px; color: var(--lb-sky); }
  .m5-w { color: var(--lb-mist); font-size: var(--lb-small); line-height: 1.6; }
  @media (max-width: 760px) { .m5-row { grid-template-columns: 1fr; gap: 4px; } }
</style>
